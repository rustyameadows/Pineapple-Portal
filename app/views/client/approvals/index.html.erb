<section class="client-page client-approvals">
  <header class="client-page__header">
    <h1>Approvals</h1>
    <p>Review open approvals and share your response with your planner.</p>
  </header>

  <% if @approvals.any? %>
    <table class="client-table client-approvals__table">
      <thead>
        <tr>
          <th>Approval</th>
          <th>Status</th>
          <th>Updated</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @approvals.each do |approval| %>
          <tr>
            <td>
              <%= link_to approval.title,
                          client_event_approval_path(@event.portal_slug.presence || @event.id, approval) %>
            </td>
            <td>
              <span class="client-pill client-pill--<%= approval.status %>"><%= approval.status_label %></span>
            </td>
            <td><%= approval.updated_at.strftime("%b %-d, %Y") %></td>
            <td class="client-table__actions">
              <%= link_to "View",
                          client_event_approval_path(@event.portal_slug.presence || @event.id, approval),
                          class: "client-link" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="client-placeholder">
      <p>No approvals have been published yet.</p>
    </div>
  <% end %>
</section>
