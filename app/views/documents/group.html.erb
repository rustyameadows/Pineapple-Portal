<% provide :page_shell do %>
  <div class="event-layout">
    <%= render "events/sidebar_navigation", event: @event %>

    <div class="event-layout__main">
      <%= render "shared/flash" %>

      <section class="event-section">
        <header class="event-section__header">
          <div>
            <p class="event-section__eyebrow">Documents</p>
            <h1 class="event-section__title"><%= @source_key == "staff_upload" ? "Your Uploads" : @label %></h1>
          </div>
          <div class="event-section__actions">
            <%= link_to "Upload Document", new_event_document_path(@event), class: "event-section__cta" %>
          </div>
        </header>

        <div class="event-section__body">
          <% if @source_key == "packet" %>
            <%= render "documents/generated_panel",
                       event: @event,
                       generated_documents: @generated_documents %>
          <% end %>

          <% if @source_key == "packet_docs" %>
            <%= render "documents/browser",
                      items: @documents,
                      title_for: ->(document) { document.title },
                      href_for: ->(document) { event_document_path(@event, document) },
                      table_columns: [
                        {
                          label: "Latest version updated at",
                          value: ->(document) { document.updated_at&.to_fs(:long) },
                          sort_key: "latest_version_updated",
                          sort_value: ->(document) { document.updated_at&.to_i }
                        },
                        {
                          label: "Included in packets",
                          value: ->(document) { Array(@upload_usage_labels[document.logical_id]).join(", ") },
                          sort_key: "packets",
                          sort_value: ->(document) { Array(@upload_usage_labels[document.logical_id]).join(" ").downcase }
                        },
                        {
                          label: "Size",
                          value: ->(document) { number_to_human_size(document.size_bytes) if document.size_bytes.present? },
                          sort_key: "size",
                          sort_value: ->(document) { document.size_bytes }
                        }
                      ],
                      card_fields: [
                        {
                          label: "Latest version updated at",
                          value: ->(document) { document.updated_at&.to_fs(:long) }
                        },
                        {
                          label: "Included in packets",
                          value: ->(document) { Array(@upload_usage_labels[document.logical_id]).join(", ") }
                        },
                        {
                          label: "Size",
                          value: ->(document) { number_to_human_size(document.size_bytes) if document.size_bytes.present? }
                        }
                      ],
                      empty_message: "No uploaded documents are currently included in packets.",
                      search_placeholder: "Search packet docs",
                      title_heading: "Document",
                      title_sort_key: "title" %>
          <% elsif %w[staff_upload client_upload].include?(@source_key) %>
            <%= render "documents/browser",
                      items: @documents,
                      title_for: ->(document) { document.title },
                      href_for: ->(document) { event_document_path(@event, document) },
                      table_columns: [
                        {
                          label: "Uploaded",
                          value: ->(document) { document.created_at&.to_fs(:short) },
                          sort_key: "uploaded",
                          sort_value: ->(document) { document.created_at&.to_i }
                        },
                        {
                          label: "Size",
                          value: ->(document) { number_to_human_size(document.size_bytes) if document.size_bytes.present? },
                          sort_key: "size",
                          sort_value: ->(document) { document.size_bytes }
                        },
                        {
                          label: "Visibility",
                          value: ->(document) do
                            content_tag(
                              :span,
                              document.client_visible? ? "Client-visible" : "Planner only",
                              class: "documents-browser__pill #{document.client_visible? ? "documents-browser__pill--visible" : "documents-browser__pill--muted"}"
                            )
                          end,
                          sort_key: "visibility",
                          sort_value: ->(document) { document.client_visible? ? 1 : 0 }
                        }
                      ],
                      card_fields: [
                        {
                          label: "Uploaded",
                          value: ->(document) { document.created_at&.to_fs(:short) }
                        },
                        {
                          label: "Size",
                          value: ->(document) { number_to_human_size(document.size_bytes) if document.size_bytes.present? }
                        },
                        {
                          label: "Visibility",
                          value: ->(document) { document.client_visible? ? "Client-visible" : "Planner only" }
                        }
                      ],
                      card_media_url_for: ->(document) do
                        download_event_document_path(@event, document) if document.content_type.to_s.start_with?("image/")
                      end,
                      empty_message: "No documents in this category yet.",
                      search_placeholder: "Search by file name",
                      title_heading: "Title",
                      title_sort_key: "title" %>
          <% else %>
            <%= render "documents/table",
                      documents: @documents,
                      title_link: ->(document) { event_document_path(@event, document) },
                      empty_message: "No documents in this category yet." %>
          <% end %>
        </div>
      </section>
    </div>
  </div>
<% end %>
