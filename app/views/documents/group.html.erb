<% provide :page_shell do %>
  <div class="event-layout">
    <%= render "events/sidebar_navigation", event: @event %>

    <div class="event-layout__main">
      <%= render "shared/flash" %>

      <section class="event-section">
        <header class="event-section__header">
          <div>
            <p class="event-section__eyebrow">Documents</p>
            <h1 class="event-section__title"><%= @label %></h1>
            <p class="event-section__lead">Showing files uploaded as <%= @label.downcase %>. Use the summary to navigate to other categories.</p>
          </div>
          <div class="event-section__actions">
            <%= link_to "Create generated document", new_event_documents_generated_path(@event), class: "button button--ghost" %>
            <%= link_to "Upload Document", new_event_document_path(@event), class: "event-section__cta" %>
          </div>
        </header>

        <div class="event-section__body">
          <% if @source_key == "packet" %>
            <%= render "documents/generated_panel",
                       event: @event,
                       generated_documents: @generated_documents %>
          <% end %>

          <% if %w[staff_upload client_upload].include?(@source_key) %>
            <%= render "documents/browser",
                      items: @documents,
                      title_for: ->(document) { document.title },
                      href_for: ->(document) { event_document_path(@event, document) },
                      table_columns: [
                        {
                          label: "Uploaded",
                          value: ->(document) { document.created_at&.to_fs(:short) }
                        },
                        {
                          label: "Updated",
                          value: ->(document) { document.updated_at&.to_fs(:short) }
                        },
                        {
                          label: "Size",
                          value: ->(document) { number_to_human_size(document.size_bytes) if document.size_bytes.present? }
                        },
                        {
                          label: "Visibility",
                          value: ->(document) do
                            content_tag(
                              :span,
                              document.client_visible? ? "Client-visible" : "Planner only",
                              class: "documents-browser__pill #{document.client_visible? ? "documents-browser__pill--visible" : "documents-browser__pill--muted"}"
                            )
                          end
                        }
                      ],
                      card_fields: [
                        {
                          label: "Uploaded",
                          value: ->(document) { document.created_at&.to_fs(:short) }
                        },
                        {
                          label: "Updated",
                          value: ->(document) { document.updated_at&.to_fs(:short) }
                        },
                        {
                          label: "Size",
                          value: ->(document) { number_to_human_size(document.size_bytes) if document.size_bytes.present? }
                        },
                        {
                          label: "Visibility",
                          value: ->(document) { document.client_visible? ? "Client-visible" : "Planner only" }
                        }
                      ],
                      empty_message: "No documents in this category yet.",
                      search_placeholder: "Search by file name",
                      title_heading: "Title" %>
          <% else %>
            <%= render "documents/table",
                      documents: @documents,
                      title_link: ->(document) { event_document_path(@event, document) },
                      empty_message: "No documents in this category yet." %>
          <% end %>

          <% if @packet_component_document_count.to_i.positive? %>
            <% show_url = url_for(params: request.query_parameters.merge("include_packet_components" => "1")) %>
            <% hide_url = url_for(params: request.query_parameters.except("include_packet_components")) %>
            <p class="event-section__lead">
              <%= pluralize(@packet_component_document_count, "packet source document") %>
              <%= @show_packet_component_documents ? "included." : "hidden from this list." %>
              <%= link_to(@show_packet_component_documents ? "Hide packet source documents" : "Show packet source documents", @show_packet_component_documents ? hide_url : show_url) %>
            </p>
          <% end %>
        </div>
      </section>
    </div>
  </div>
<% end %>
