<% provide :page_shell do %>
  <div class="event-layout">
    <%= render "events/sidebar_navigation", event: @event %>

    <div class="event-layout__main">
      <%= render "shared/flash" %>

      <section class="event-section">
        <header class="event-section__header">
          <div>
            <p class="event-section__eyebrow">Generated packets</p>
            <h1 class="event-section__title">Create a packet</h1>
            <p class="event-section__lead">Set up the packet shell now and then build it with shared canonicals, reusable pages, and uploads.</p>
          </div>
          <%= link_to "Back to generated packets", event_documents_generated_index_path(@event), class: "event-section__cta" %>
        </header>

        <div class="event-section__body generated-doc__create-layout">
          <section class="documents-form__panel">
            <h2 class="documents-form__heading">New packet</h2>
            <p class="generated-doc__help">Define the shell now, then head into the builder for the live working PDF and snapshot flow.</p>
            <%= render "form" %>
          </section>

          <section class="documents-form__panel">
            <div class="generated-doc__panel-header">
              <div>
                <h2 class="documents-form__heading">Templates</h2>
                <p class="generated-doc__help">Preview every branded section before inserting it into a packet.</p>
              </div>
              <%= link_to "Open template gallery",
                          event_documents_templates_path(@event),
                          class: "button button--small" %>
            </div>

            <% if @templates.any? %>
              <ul class="generated-doc__template-list">
                <% @templates.each do |template| %>
                  <li><%= template.title %></li>
                <% end %>
              </ul>
            <% else %>
              <p class="generated-doc__empty">No templates have been defined yet.</p>
            <% end %>
          </section>
        </div>
      </section>
    </div>
  </div>
<% end %>
