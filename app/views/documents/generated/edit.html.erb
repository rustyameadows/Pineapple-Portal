<% provide :page_shell do %>
  <div class="event-layout">
    <%= render "events/sidebar_navigation", event: @event %>

    <div class="event-layout__main">
      <%= render "shared/flash" %>

      <section class="event-section">
        <header class="event-section__header">
          <div>
            <p class="event-section__eyebrow"><%= @document.title %></p>
            <h1 class="event-section__title"><%= @document.group_container? ? "Group Settings" : "Packet Settings" %></h1>
            <% if @document.group_container? %>
              <p class="event-section__lead">Update the shared group details and manage the pages every consuming packet will render.</p>
            <% end %>
          </div>
          <div class="event-section__actions">
            <% if @document.packet_container? %>
              <%= link_to "Back to packet", event_documents_generated_path(@event, @document.logical_id), class: "event-section__cta event-section__cta--secondary" %>
            <% else %>
              <%= link_to "Back to library", library_event_documents_generated_index_path(@event), class: "event-section__cta event-section__cta--secondary" %>
            <% end %>
          </div>
        </header>

        <div class="event-section__body generated-doc__settings-layout">
          <%= render "documents/generated/segment_list",
                     event: @event,
                     document: @document,
                     segments: @segments,
                     available_pdf_documents: @available_pdf_documents,
                     available_page_views: @available_page_views,
                     available_canonical_sources: @available_canonical_sources,
                     available_page_sources: @available_page_sources,
                     available_group_sources: @available_group_sources,
                     source_usage_labels: @source_usage_labels,
                     available_timeline_views: @available_timeline_views,
                     available_wedding_party_timeline_tags: @available_wedding_party_timeline_tags,
                     segment_warnings: @segment_warnings,
                     reorder_url: reorder_event_documents_generated_segments_path(@event, @document.logical_id),
                     csrf_token: form_authenticity_token,
                     return_to: request.fullpath,
                     open_group_source_id: params[:open_group_source_id] %>

          <section class="generated-doc__compact-settings" aria-labelledby="generated-doc-settings-title">
            <h2 class="documents-form__heading" id="generated-doc-settings-title">
              <%= @document.group_container? ? "Group details" : "Packet details" %>
            </h2>

            <div class="generated-doc__compact-settings-row">
              <%= form_with model: @document,
                            url: event_documents_generated_path(@event, @document.logical_id),
                            method: :patch,
                            local: true,
                            class: "generated-doc__compact-form" do |form| %>
                <div class="form-field generated-doc__compact-title">
                  <%= form.label :title, @document.group_container? ? "Group title" : "Packet title" %>
                  <%= form.text_field :title, required: true %>
                </div>
                <%= form.submit "Save", class: "button button--primary" %>
              <% end %>

              <%= button_to (@document.group_container? ? "Delete group" : "Delete packet"),
                            event_documents_generated_path(@event, @document.logical_id),
                            method: :delete,
                            class: "button button--danger generated-doc__compact-delete",
                            form: { data: { turbo_confirm: @document.group_container? ? "Delete this group and remove it from every packet?" : "Delete this packet and all saved snapshots?" } } %>
            </div>
          </section>
        </div>
      </section>
    </div>
  </div>
<% end %>
