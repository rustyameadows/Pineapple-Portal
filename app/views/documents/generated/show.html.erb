<% provide :page_shell do %>
  <div class="event-layout">
    <%= render "events/sidebar_navigation", event: @event %>

    <div class="event-layout__main">
      <%= render "shared/flash",
                 snapshot_build: @active_build,
                 snapshot_status_url: (@active_build.present? ? status_event_documents_generated_build_path(@event, @document.logical_id, @active_build) : nil),
                 snapshot_message: flash[:snapshot_build_message] %>

      <section class="event-section generated-builder">
        <header class="event-section__header generated-builder__header">
          <div>
            <h1 class="event-section__title"><%= @document.title %></h1>
          </div>
          <div class="generated-builder__actions">
            <%= button_to "Duplicate packet",
                          duplicate_event_documents_generated_path(@event, @document.logical_id),
                          method: :post,
                          class: "button button--ghost",
                          form: { class: "generated-builder__inline-form" } %>
            <%= link_to "Packet settings", edit_event_documents_generated_path(@event, @document.logical_id), class: "button button--ghost" %>
          </div>
        </header>

        <div class="generated-builder__body generated-builder__single-column">
          <%
            live_pdf_frame_path =
              if @working_copy&.working_available
                "#{working_pdf_event_documents_generated_path(@event, @document.logical_id, v: @working_copy.viewer_token)}#view=Fit"
              else
                working_pdf_event_documents_generated_path(@event, @document.logical_id)
              end
            live_pdf_open_path = "#{working_pdf_event_documents_generated_path(@event, @document.logical_id)}#view=Fit"
            live_pdf_retrying = @working_copy&.progress_message.to_s.start_with?("Retrying live PDF")

            live_pdf_banner_visible = @working_copy.present? && !@working_copy.empty? && (
              @working_copy.failed? || @working_copy.active? || !@working_copy.working_available
            )

            live_pdf_banner_message =
              if @working_copy&.progress_message.present?
                @working_copy.progress_message
              elsif @working_copy&.failed?
                @working_copy&.working_available ? "Live PDF refresh failed." : "Unable to prepare live PDF."
              elsif @working_copy&.active? && @working_copy&.working_available
                "A newer live PDF is being prepared."
              elsif @working_copy&.rendered_at.present?
                "Refreshing live PDF..."
              else
                "Preparing live PDF..."
              end

            live_pdf_banner_detail =
              if @working_copy&.failed?
                if @working_copy&.working_available
                  @working_copy.refresh_error.presence || "Showing the last live version while we wait for another refresh."
                else
                  @working_copy.refresh_error.presence || "Try again in a moment."
                end
              elsif live_pdf_retrying && @working_copy&.working_available
                "Showing the last live version while we retry the render automatically."
              elsif live_pdf_retrying
                "The last live render stalled, so we started a fresh retry automatically."
              elsif @working_copy&.active? && @working_copy&.working_available
                "Showing the last live version until the refreshed packet is ready."
              elsif @working_copy&.rendered_at.present?
                "We’re rebuilding the working preview with the latest packet content."
              else
                "This packet is building its live preview. It will appear here automatically."
              end

            live_rebuild_available = @working_copy.present? && !@working_copy.empty?
            live_rebuild_return_to = request.fullpath
          %>
          <div class="generated-builder__workspace-card generated-builder__workspace-card--pdf"
               data-controller="generated-pdf-frame generated-segment-dialog"
               data-generated-pdf-frame-status-url-value="<%= working_status_event_documents_generated_path(@event, @document.logical_id) %>"
               data-generated-pdf-frame-initial-status-value="<%= @working_copy&.status || "missing" %>"
               data-generated-pdf-frame-initial-working-available-value="<%= @working_copy&.working_available ? "true" : "false" %>"
               data-generated-pdf-frame-initial-viewer-token-value="<%= @working_copy&.viewer_token %>"
               data-generated-pdf-frame-initial-refresh-error-value="<%= @working_copy&.refresh_error %>"
               data-generated-pdf-frame-initial-progress-message-value="<%= @working_copy&.progress_message %>">
            <div class="generated-builder__workspace-head generated-builder__workspace-head--pdf">
              <h2>Live Working PDF</h2>
              <button type="button"
                      class="generated-builder__live-pill"
                      data-generated-pdf-frame-target="pill"
                      data-action="generated-segment-dialog#open"
                      aria-haspopup="dialog"
                      <%= "hidden" unless @working_copy&.rendered_at.present? %>>
                Updated
                <time data-controller="local-time"
                      data-generated-pdf-frame-target="pillTime"
                      data-local-time-iso-value="<%= @working_copy&.rendered_at&.utc&.iso8601 %>"
                      data-local-time-format-value="short"
                      datetime="<%= @working_copy&.rendered_at&.utc&.iso8601 %>"><%= @working_copy&.rendered_at&.to_fs(:short) %></time>
              </button>
              <div class="generated-builder__workspace-actions generated-builder__workspace-actions--pdf">
                <%= link_to "Open live PDF",
                            live_pdf_open_path,
                            class: "button button--ghost button--small",
                            target: "_blank",
                            rel: "noopener" %>
              </div>
            </div>
            <div class="generated-builder__pdf-status"
                 data-generated-pdf-frame-target="banner"
                 <%= "hidden" unless live_pdf_banner_visible %>>
              <strong data-generated-pdf-frame-target="bannerMessage">
                <%= live_pdf_banner_message %>
              </strong>
              <p data-generated-pdf-frame-target="bannerDetail">
                <%= live_pdf_banner_detail %>
              </p>
            </div>
            <div class="generated-builder__pdf-shell"
                 data-generated-pdf-frame-target="shell">
              <div class="generated-builder__pdf-loading"
                   data-generated-pdf-frame-target="loading"
                   <%= "hidden" if @working_copy&.working_available %>>
                <div class="generated-builder__pdf-loading-card">
                  <div class="generated-builder__pdf-loading-indicator" aria-hidden="true"></div>
                  <div class="generated-builder__pdf-loading-copy">
                    <% if @working_copy&.failed? && !@working_copy&.working_available %>
                      <strong data-generated-pdf-frame-target="message"><%= @working_copy.progress_message.presence || "Unable to prepare live PDF." %></strong>
                      <p data-generated-pdf-frame-target="detail"><%= @working_copy.refresh_error.presence || "Try again in a moment." %></p>
                    <% elsif live_pdf_retrying %>
                      <strong data-generated-pdf-frame-target="message"><%= @working_copy.progress_message.presence || "Retrying live PDF after a stalled render" %></strong>
                      <p data-generated-pdf-frame-target="detail">The last live render stalled, so we started a fresh retry automatically.</p>
                    <% elsif @working_copy&.rendered_at.present? && !@working_copy&.working_available %>
                      <strong data-generated-pdf-frame-target="message"><%= @working_copy.progress_message.presence || "Refreshing live PDF..." %></strong>
                      <p data-generated-pdf-frame-target="detail">We’re rebuilding the working preview with the latest packet content.</p>
                    <% else %>
                      <strong data-generated-pdf-frame-target="message"><%= @working_copy&.progress_message.presence || "Preparing live PDF..." %></strong>
                      <p data-generated-pdf-frame-target="detail">This packet is building its first working preview. It should appear here automatically.</p>
                    <% end %>
                  </div>
                </div>
              </div>

              <iframe src="<%= @working_copy&.working_available ? live_pdf_frame_path : "about:blank" %>"
                      title="Live working packet PDF"
                      class="generated-builder__pdf-frame"
                      data-generated-pdf-frame-target="frame"
                      data-action="load->generated-pdf-frame#frameLoaded"></iframe>
            </div>

            <% if live_rebuild_available %>
              <dialog class="generated-builder__segment-dialog generated-builder__overlay-dialog generated-builder__live-rebuild-dialog"
                      data-generated-segment-dialog-target="dialog"
                      data-action="cancel->generated-segment-dialog#handleCancel click->generated-segment-dialog#handleBackdropClose">
                <div class="generated-builder__overlay-panel generated-builder__segment-dialog-panel">
                  <header class="generated-builder__overlay-header generated-builder__segment-dialog-header">
                    <h3>Rebuild live PDF?</h3>
                  </header>
                  <div class="generated-builder__overlay-body generated-builder__segment-dialog-body">
                    <p class="generated-builder__live-rebuild-copy">
                      We’ll clear the current live build and rerender the packet from source so the working PDF is fully fresh. Saved snapshots stay untouched.
                    </p>
                  </div>
                  <footer class="generated-builder__overlay-actions generated-builder__segment-dialog-actions">
                    <button type="button"
                            class="button button--ghost"
                            data-action="generated-segment-dialog#close">
                      Cancel
                    </button>
                    <%= button_to "Rebuild live PDF",
                                  rebuild_live_event_documents_generated_path(@event, @document.logical_id),
                                  method: :post,
                                  params: { return_to: live_rebuild_return_to },
                                  class: "button button--primary",
                                  form: { class: "generated-builder__inline-form" } %>
                  </footer>
                </div>
              </dialog>
            <% end %>
          </div>

          <div class="generated-builder__workspace-card">
            <div class="generated-builder__workspace-head">
              <div>
                <h2>Snapshots & downloads</h2>
                <% if @active_build.present? %>
                  <p class="generated-builder__hint">
                    Latest snapshot job kicked off
                    <time data-controller="local-time"
                          data-local-time-iso-value="<%= @active_build.created_at.utc.iso8601 %>"
                          data-local-time-format-value="short"
                          datetime="<%= @active_build.created_at.utc.iso8601 %>"><%= @active_build.created_at.to_fs(:short) %></time>
                    · <%= time_ago_in_words(@active_build.created_at) %> ago.
                  </p>
                <% elsif @compiled_versions.any? %>
                  <p class="generated-builder__hint">
                    Last saved snapshot
                    <time data-controller="local-time"
                          data-local-time-iso-value="<%= @compiled_versions.first.updated_at.utc.iso8601 %>"
                          data-local-time-format-value="long"
                          datetime="<%= @compiled_versions.first.updated_at.utc.iso8601 %>"><%= @compiled_versions.first.updated_at.to_fs(:long) %></time>.
                  </p>
                <% else %>
                  <p class="generated-builder__hint">Create a snapshot when you want a saved, shareable PDF version.</p>
                <% end %>
              </div>
              <div class="generated-builder__workspace-actions">
                <% if @latest_version.present? %>
                  <%= link_to "Download latest",
                              download_event_document_path(@event, @latest_version),
                              class: "button button--ghost button--small",
                              target: "_blank",
                              rel: "noopener" %>
                <% end %>
                <%= button_to "Create snapshot",
                              snapshot_event_documents_generated_path(@event, @document.logical_id),
                              method: :post,
                              class: "button button--primary button--small" %>
                <%= button_to "Create snapshot without page numbers",
                              snapshot_event_documents_generated_path(@event, @document.logical_id),
                              method: :post,
                              params: { page_numbers: false },
                              class: "button button--ghost button--small" %>
                <% if @active_build.present? %>
                  <span class="generated-builder__build-progress generated-builder__build-progress--hint">A build is currently running.</span>
                <% end %>
              </div>
            </div>

            <% if @builds.any? %>
              <%= render "documents/generated/builds",
                       builds: @builds,
                       compiled_versions: @compiled_versions,
                       event: @event,
                       document: @document %>
            <% else %>
              <p class="generated-builder__empty">Once you save the first snapshot, we’ll show version details here.</p>
            <% end %>
          </div>
        </div>
      </section>
    </div>
  </div>
<% end %>
