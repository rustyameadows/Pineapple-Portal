<% provide :page_shell do %>
  <div class="event-layout">
    <%= render "events/sidebar_navigation", event: @event %>

    <div class="event-layout__main">
      <%= render "shared/flash" %>

      <section class="event-section generated-builder">
        <header class="event-section__header generated-builder__header">
          <div>
            <p class="event-section__eyebrow">Generated packet</p>
            <h1 class="event-section__title"><%= @document.title %></h1>
            <% if @latest_version.present? && @latest_version.storage_uri.present? %>
              <p class="event-section__meta">Latest snapshot <%= @latest_version.updated_at.to_fs(:long) %> · version <%= @latest_version.version %></p>
            <% else %>
              <p class="event-section__meta">No saved snapshots yet. The working PDF below stays live.</p>
            <% end %>
          </div>
          <div class="generated-builder__actions">
            <%= link_to "Packet settings", edit_event_documents_generated_path(@event, @document.logical_id), class: "button button--ghost" %>
            <%= link_to "Packet library", library_event_documents_generated_index_path(@event), class: "button button--ghost" %>
            <%= link_to "Back to documents", event_documents_path(@event), class: "button button--ghost" %>
            <% if @latest_version.present? %>
              <%= link_to "Download latest",
                          download_event_document_path(@event, @latest_version),
                          class: "button button--ghost button--small",
                          target: "_blank",
                          rel: "noopener" %>
            <% end %>
          </div>
        </header>

        <div class="generated-builder__body generated-builder__single-column">
          <div class="generated-builder__workspace-card">
            <div class="generated-builder__workspace-head">
              <div>
                <h2>Live Working PDF</h2>
                <p class="generated-builder__hint">This view reflects the current packet order and shared-source content without creating a saved version.</p>
              </div>
              <div class="generated-builder__workspace-actions">
                <%= link_to "Open live PDF",
                            working_pdf_event_documents_generated_path(@event, @document.logical_id),
                            class: "button button--ghost button--small",
                            target: "_blank",
                            rel: "noopener" %>
              </div>
            </div>
            <div class="generated-builder__pdf-shell" data-controller="generated-pdf-frame">
              <div class="generated-builder__pdf-loading" data-generated-pdf-frame-target="loading">
                <div class="generated-builder__pdf-loading-card">
                  <div class="generated-builder__pdf-loading-indicator" aria-hidden="true"></div>
                  <div class="generated-builder__pdf-loading-copy">
                    <% if @document.working_rendered_at.present? %>
                      <strong data-generated-pdf-frame-target="message">Refreshing live PDF...</strong>
                      <p data-generated-pdf-frame-target="detail">We’re rebuilding the working preview with the latest packet content.</p>
                    <% else %>
                      <strong data-generated-pdf-frame-target="message">Preparing live PDF...</strong>
                      <p data-generated-pdf-frame-target="detail">This packet is building its first working preview. It should appear here automatically.</p>
                    <% end %>
                  </div>
                </div>
              </div>

              <iframe src="<%= working_pdf_event_documents_generated_path(@event, @document.logical_id) %>"
                      title="Live working packet PDF"
                      class="generated-builder__pdf-frame"
                      data-generated-pdf-frame-target="frame"
                      data-action="load->generated-pdf-frame#frameLoaded"></iframe>
            </div>
          </div>

          <%= render "documents/generated/segment_list",
                     event: @event,
                     document: @document,
                     segments: @segments,
                     available_pdf_documents: @available_pdf_documents,
                     available_page_views: @available_page_views,
                     available_canonical_sources: @available_canonical_sources,
                     available_page_sources: @available_page_sources,
                     source_usage_labels: @source_usage_labels,
                     available_timeline_views: @available_timeline_views,
                     segment_warnings: @segment_warnings,
                     reorder_url: reorder_event_documents_generated_segments_path(@event, @document.logical_id),
                     csrf_token: form_authenticity_token %>

          <div class="generated-builder__workspace-card">
            <div class="generated-builder__workspace-head">
              <div>
                <h2>Snapshots & downloads</h2>
                <% if @active_build.present? %>
                  <p class="generated-builder__hint">Latest snapshot job kicked off <%= time_ago_in_words(@active_build.created_at) %> ago.</p>
                <% elsif @compiled_versions.any? %>
                  <p class="generated-builder__hint">Last saved snapshot <%= @compiled_versions.first.updated_at.to_fs(:long) %>.</p>
                <% else %>
                  <p class="generated-builder__hint">Create a snapshot when you want a saved, shareable PDF version.</p>
                <% end %>
              </div>
              <div class="generated-builder__workspace-actions">
                <% if @latest_version.present? %>
                  <%= link_to "Download latest",
                              download_event_document_path(@event, @latest_version),
                              class: "button button--ghost button--small",
                              target: "_blank",
                              rel: "noopener" %>
                <% end %>
                <%= button_to "Create snapshot",
                              snapshot_event_documents_generated_path(@event, @document.logical_id),
                              method: :post,
                              class: "button button--primary button--small" %>
                <%= button_to "Create snapshot with page numbers",
                              snapshot_event_documents_generated_path(@event, @document.logical_id),
                              method: :post,
                              params: { page_numbers: true },
                              class: "button button--ghost button--small" %>
                <% if @active_build.present? %>
                  <span class="generated-builder__build-progress generated-builder__build-progress--hint">A build is currently running.</span>
                <% end %>
              </div>
            </div>

            <% if @builds.any? %>
              <%= render "documents/generated/builds",
                       builds: @builds,
                       compiled_versions: @compiled_versions,
                       event: @event,
                       document: @document %>
            <% else %>
              <p class="generated-builder__empty">Once you save the first snapshot, we’ll show version details here.</p>
            <% end %>
          </div>
        </div>
      </section>
    </div>
  </div>
<% end %>
