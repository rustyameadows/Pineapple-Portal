<% provide :page_shell do %>
  <div class="event-layout">
    <%= render "events/sidebar_navigation", event: @event %>

    <div class="event-layout__main">
      <%= render "shared/flash" %>

      <section class="event-section">
        <header class="event-section__header">
          <div>
            <h1 class="event-section__title">Packets for <%= @event.name %></h1>
          </div>
          <div class="event-section__actions event-section__actions--row">
            <%= button_to "Add default packets",
                          add_default_packets_event_documents_generated_index_path(@event),
                          method: :post,
                          class: "event-section__cta event-section__cta--secondary" %>
            <%= link_to "Packet library", library_event_documents_generated_index_path(@event), class: "event-section__cta event-section__cta--secondary" %>
            <%= link_to "New generated packet", new_event_documents_generated_path(@event), class: "event-section__cta" %>
          </div>
        </header>

        <div class="event-section__body">
          <%= render "documents/browser",
                    items: @manifest_entries,
                    title_for: ->(entry) { entry[:definition].title },
                    href_for: ->(entry) { event_documents_generated_path(@event, entry[:logical_id]) },
                    table_columns: [
                      {
                        label: "Last snapshot",
                        value: ->(entry) do
                          latest = entry[:latest]
                          latest.present? && latest.storage_uri.present? ? "#{time_ago_in_words(latest.updated_at)} ago" : "No snapshots yet"
                        end,
                        sort_key: "last_compiled",
                        sort_value: ->(entry) do
                          latest = entry[:latest]
                          latest.present? && latest.storage_uri.present? ? latest.updated_at.to_i : nil
                        end
                      },
                      {
                        label: "Visibility",
                        value: ->(entry) do
                          definition = entry[:definition]
                          content_tag(
                            :span,
                            definition.client_visible? ? "Client visible" : "Internal only",
                            class: "documents-browser__pill #{definition.client_visible? ? "documents-browser__pill--visible" : "documents-browser__pill--muted"}"
                          )
                        end,
                        sort_key: "visibility",
                        sort_value: ->(entry) { entry[:definition].client_visible? ? 1 : 0 }
                      }
                    ],
                    table_actions: [
                      {
                        label: "Edit packet",
                        text: "Edit packet",
                        href: ->(entry) { edit_event_documents_generated_path(@event, entry[:logical_id]) }
                      },
                      {
                        label: "View packet",
                        text: "View packet",
                        href: ->(entry) { event_documents_generated_path(@event, entry[:logical_id]) }
                      }
                    ],
                    card_fields: [
                      {
                        label: "Last snapshot",
                        value: ->(entry) do
                          latest = entry[:latest]
                          latest.present? && latest.storage_uri.present? ? "#{time_ago_in_words(latest.updated_at)} ago" : "No snapshots yet"
                        end
                      },
                      {
                        label: "Visibility",
                        value: ->(entry) { entry[:definition].client_visible? ? "Client visible" : "Internal only" }
                      }
                    ],
                    empty_message: "No packets yet.",
                    search_placeholder: "Search by file name",
                    title_heading: "Title",
                    title_sort_key: "title" %>
        </div>
      </section>
    </div>
  </div>
<% end %>
