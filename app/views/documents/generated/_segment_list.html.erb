<% segment_warnings ||= {} %>
<% reorder_url ||= nil %>
<% csrf_token ||= form_authenticity_token %>
<% available_timeline_views ||= [] %>

<div class="generated-builder__segments"
     data-controller="generated-segments"
     data-generated-segments-reorder-url-value="<%= reorder_url %>"
     data-generated-segments-csrf-token-value="<%= csrf_token %>"
     data-generated-segments-view-mode-value="list">
  <div class="generated-builder__sidebar-header">
    <div class="generated-builder__sidebar-header-main">
      <h2>Packet Pages</h2>
      <p class="generated-builder__hint">These pages are ordered for the live working PDF. Canonicals and reused pages stay shared across packets.</p>
    </div>
    <div class="generated-builder__view-toggle" role="group" aria-label="Packet page layout view">
      <button type="button"
              class="generated-builder__view-button generated-builder__view-button--active"
              data-generated-segments-target="viewButton"
              data-view="list"
              aria-pressed="true"
              data-action="generated-segments#changeView">
        List
      </button>
      <button type="button"
              class="generated-builder__view-button"
              data-generated-segments-target="viewButton"
              data-view="grid"
              aria-pressed="false"
              data-action="generated-segments#changeView">
        Grid
      </button>
    </div>
  </div>

  <% if segments.any? %>
    <ul class="generated-builder__list"
        data-generated-segments-target="list">
      <% segments.each do |segment| %>
        <% shared_packets = Array(source_usage_labels[segment.source.id]) %>
        <li class="generated-builder__list-item"
            data-generated-segments-target="item"
            data-segment-id="<%= segment.id %>"
            draggable="true">
          <div class="generated-builder__list-left">
            <div class="generated-builder__list-main">
              <button type="button"
                      class="generated-builder__drag-handle"
                      data-generated-segments-target="handle"
                      aria-label="Drag to reorder packet page">
                <span aria-hidden="true">⋮⋮</span>
              </button>
              <div class="generated-builder__list-content">
                <strong><%= segment.display_title %></strong>
                <div class="generated-builder__list-meta">
                  <span class="generated-builder__status-tag"><%= segment.builder_label %></span>
                  <%= render "documents/generated/render_status",
                             segment: segment,
                             event: event,
                             document: document %>
                  <% if shared_packets.size > 1 %>
                    <span class="generated-builder__status-tag generated-builder__status-tag--warning">
                      Shared in <%= shared_packets.size %> packets
                    </span>
                  <% end %>
                  <% if segment_warnings[segment.id].present? %>
                    <span class="generated-builder__status-tag generated-builder__status-tag--warning">
                      <%= segment_warnings[segment.id].split(":", 2).last&.strip || segment_warnings[segment.id] %>
                    </span>
                  <% end %>
                </div>
                <% if shared_packets.any? %>
                  <p class="generated-builder__hint">Used in: <%= shared_packets.join(", ") %></p>
                <% end %>
              </div>
            </div>
            <div class="generated-builder__list-actions">
              <%= link_to "Preview",
                          preview_event_documents_generated_segment_path(event, document.logical_id, segment),
                          class: "button button--tiny button--ghost",
                          target: "_blank",
                          rel: "noopener" %>
              <%= button_to "Duplicate",
                            duplicate_event_documents_generated_segment_path(event, document.logical_id, segment),
                            method: :post,
                            class: "button button--tiny button--ghost" %>
              <%= button_to "Remove",
                            event_documents_generated_segment_path(event, document.logical_id, segment),
                            method: :delete,
                            class: "button button--tiny button--danger",
                            data: { confirm: "Remove this page from the packet?" } %>
            </div>
          </div>

          <div class="generated-builder__list-right">
            <details>
              <summary>Segment settings</summary>
              <%= form_with model: segment,
                            scope: :segment,
                            url: event_documents_generated_segment_path(event, document.logical_id, segment),
                            method: :patch,
                            local: true,
                            class: "generated-builder__form" do |form| %>
                <div class="generated-builder__form-row">
                  <%= form.label :title, "Page title" %>
                  <%= form.text_field :title, value: segment.display_title %>
                </div>

                <% if segment.pdf_asset? %>
                  <div class="generated-builder__form-row">
                    <%= form.label :pdf_document_id, "Attached PDF" %>
                    <%= form.select :pdf_document_id,
                                    options_from_collection_for_select(available_pdf_documents, :id, :title, segment.pdf_document_id),
                                    include_blank: "Choose a PDF" %>
                  </div>
                <% elsif segment.html_view? %>
                  <% boolean_cast = ActiveModel::Type::Boolean.new %>
                  <% if segment.html_view_key == DocumentSegment::TIMELINE_VIEW_KEY %>
                    <% timeline_options = segment.html_options.stringify_keys %>
                    <% selected_view = timeline_options["view_ref"].presence || available_timeline_views.dig(0, 1) %>
                    <%= form.hidden_field :view_key, value: segment.html_view_key %>
                    <%= form.fields_for :options, timeline_options do |options_fields| %>
                      <div class="generated-builder__form-row">
                        <%= options_fields.label :view_ref, "Timeline view" %>
                        <% if available_timeline_views.any? %>
                          <%= options_fields.select :view_ref,
                                                   options_for_select(available_timeline_views, selected_view) %>
                        <% else %>
                          <p class="generated-builder__empty">No timeline views available yet.</p>
                        <% end %>
                      </div>

                      <fieldset class="generated-builder__form-row generated-builder__form-row--checkbox-group">
                        <legend>Show columns</legend>
                        <label class="generated-builder__checkbox">
                          <%= options_fields.check_box :show_location, { checked: boolean_cast.cast(timeline_options.fetch("show_location", true)) }, "1", "0" %>
                          <span>Location</span>
                        </label>
                        <label class="generated-builder__checkbox">
                          <%= options_fields.check_box :show_vendor, { checked: boolean_cast.cast(timeline_options.fetch("show_vendor", true)) }, "1", "0" %>
                          <span>Vendor</span>
                        </label>
                        <label class="generated-builder__checkbox">
                          <%= options_fields.check_box :show_team_members, { checked: boolean_cast.cast(timeline_options.fetch("show_team_members", true)) }, "1", "0" %>
                          <span>Team members</span>
                        </label>
                      </fieldset>
                    <% end %>
                  <% elsif segment.html_view_key == DocumentSegment::RUN_OF_SHOW_VIEW_KEY %>
                    <% run_options = segment.html_options.stringify_keys %>
                    <%= form.hidden_field :view_key, value: segment.html_view_key %>
                    <%= form.fields_for :options, run_options do |options_fields| %>
                      <fieldset class="generated-builder__form-row generated-builder__form-row--checkbox-group">
                        <legend>Show columns</legend>
                        <label class="generated-builder__checkbox">
                          <%= options_fields.check_box :show_location, { checked: boolean_cast.cast(run_options.fetch("show_location", true)) }, "1", "0" %>
                          <span>Location</span>
                        </label>
                        <label class="generated-builder__checkbox">
                          <%= options_fields.check_box :show_vendor, { checked: boolean_cast.cast(run_options.fetch("show_vendor", true)) }, "1", "0" %>
                          <span>Vendor</span>
                        </label>
                        <label class="generated-builder__checkbox">
                          <%= options_fields.check_box :show_team_members, { checked: boolean_cast.cast(run_options.fetch("show_team_members", true)) }, "1", "0" %>
                          <span>Team members</span>
                        </label>
                      </fieldset>
                    <% end %>
                  <% elsif [DocumentSegment::TEXT_PAGE_VIEW_KEY, DocumentSegment::EVENT_OVERVIEW_VIEW_KEY].include?(segment.html_view_key) %>
                    <% text_options = segment.html_options.stringify_keys %>
                    <% body_markdown = generated_segment_body_markdown(segment) %>
                    <%= form.hidden_field :view_key, value: segment.html_view_key %>
                    <%= form.fields_for :options, text_options do |options_fields| %>
                      <div class="generated-builder__markdown-editor" data-controller="generated-markdown-editor">
                        <div class="generated-builder__form-row">
                          <%= options_fields.label :body_markdown, "Page content" %>
                          <%= options_fields.text_area :body_markdown,
                                                      value: body_markdown,
                                                      rows: 14,
                                                      class: "generated-builder__textarea",
                                                      placeholder: "Write notes, schedules, or instructions with Markdown syntax.",
                                                      data: {
                                                        generated_markdown_editor_target: "source",
                                                        action: "input->generated-markdown-editor#syncFromSource"
                                                      } %>
                        </div>
                        <div class="generated-builder__overlay-trigger-row">
                          <button type="button"
                                  class="button button--tiny button--ghost generated-builder__overlay-trigger"
                                  data-generated-markdown-editor-target="openButton"
                                  data-action="generated-markdown-editor#open"
                                  aria-haspopup="dialog"
                                  hidden>
                            Open large editor
                          </button>
                        </div>
                        <dialog class="generated-builder__overlay-dialog"
                                data-generated-markdown-editor-target="dialog"
                                data-action="cancel->generated-markdown-editor#handleCancel click->generated-markdown-editor#handleBackdropClose">
                          <div class="generated-builder__overlay-panel">
                            <header class="generated-builder__overlay-header">
                              <h3>Large text editor</h3>
                            </header>
                            <div class="generated-builder__overlay-body">
                              <textarea class="generated-builder__overlay-textarea"
                                        aria-label="Large markdown editor"
                                        data-generated-markdown-editor-target="overlay"
                                        data-action="input->generated-markdown-editor#syncFromOverlay"><%= body_markdown %></textarea>
                            </div>
                            <footer class="generated-builder__overlay-actions">
                              <button type="button"
                                      class="button button--small"
                                      data-action="generated-markdown-editor#close">
                                Done
                              </button>
                            </footer>
                          </div>
                        </dialog>
                      </div>
                    <% end %>
                  <% end %>
                <% end %>

                <div class="generated-builder__form-actions">
                  <%= form.submit "Save settings", class: "button button--small" %>
                </div>
              <% end %>
            </details>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="generated-builder__empty">No packet pages yet. Add a canonical, page, or upload to start the live working PDF.</p>
  <% end %>

  <div class="generated-builder__new">
    <div class="generated-builder__panel">
      <h3>Insert Canonical</h3>
      <%= form_with scope: :segment,
                    url: event_documents_generated_segments_path(event, document.logical_id),
                    method: :post,
                    local: true,
                    class: "generated-builder__form" do |form| %>
        <div class="generated-builder__form-row">
          <%= form.label :source_id, "Canonical segment" %>
          <%= form.select :source_id,
                          options_from_collection_for_select(available_canonical_sources, :id, :display_title),
                          include_blank: "Choose a canonical" %>
        </div>
        <div class="generated-builder__form-actions">
          <%= form.submit "Insert canonical", class: "button button--small" %>
        </div>
      <% end %>
    </div>

    <div class="generated-builder__panel">
      <h3>Reuse Page</h3>
      <%= form_with scope: :segment,
                    url: event_documents_generated_segments_path(event, document.logical_id),
                    method: :post,
                    local: true,
                    class: "generated-builder__form" do |form| %>
        <div class="generated-builder__form-row">
          <%= form.label :source_id, "Page from another packet" %>
          <%= form.select :source_id,
                          options_from_collection_for_select(available_page_sources, :id, :display_title),
                          include_blank: "Choose a reusable page" %>
        </div>
        <div class="generated-builder__form-actions">
          <%= form.submit "Reuse page", class: "button button--small" %>
        </div>
      <% end %>
    </div>

    <div class="generated-builder__panel">
      <h3>Create New Page</h3>
      <%= form_with scope: :segment,
                    url: event_documents_generated_segments_path(event, document.logical_id),
                    method: :post,
                    local: true,
                    class: "generated-builder__form" do |form| %>
        <div class="generated-builder__form-row">
          <%= form.label :view_key, "Page type" %>
          <%= form.select :view_key,
                          options_for_select(available_page_views),
                          include_blank: "Choose a page type" %>
        </div>
        <div class="generated-builder__form-row">
          <%= form.label :title, "Page title" %>
          <%= form.text_field :title, placeholder: "Defaults to page type" %>
        </div>
        <div class="generated-builder__form-actions">
          <%= form.submit "Create page", class: "button button--small" %>
        </div>
      <% end %>
    </div>

    <div class="generated-builder__panel">
      <h3>Attach Existing PDF</h3>
      <%= form_with scope: :segment,
                    url: event_documents_generated_segments_path(event, document.logical_id),
                    method: :post,
                    local: true,
                    class: "generated-builder__form" do |form| %>
        <div class="generated-builder__form-row">
          <%= form.label :pdf_document_id, "Uploaded PDF" %>
          <%= form.select :pdf_document_id,
                          options_from_collection_for_select(available_pdf_documents, :id, :title),
                          include_blank: "Choose a PDF" %>
        </div>
        <div class="generated-builder__form-row">
          <%= form.label :title, "Page title" %>
          <%= form.text_field :title, placeholder: "Defaults to document title" %>
        </div>
        <div class="generated-builder__form-actions">
          <%= form.submit "Attach PDF", class: "button button--small" %>
        </div>
      <% end %>
    </div>

    <div class="generated-builder__panel">
      <h3>Upload PDF Into Packet</h3>
      <%= form_with scope: :segment,
                    url: event_documents_generated_segments_path(event, document.logical_id),
                    method: :post,
                    local: true,
                    class: "generated-builder__form",
                    data: {
                      controller: "generated-packet-upload",
                      presign_url: presign_event_documents_path(event)
                    } do |form| %>
        <div class="generated-builder__form-row">
          <label for="segment_file_upload_<%= document.logical_id %>">PDF file</label>
          <input type="file"
                 id="segment_file_upload_<%= document.logical_id %>"
                 accept="application/pdf"
                 data-generated-packet-upload-target="file"
                 data-action="change->generated-packet-upload#upload">
        </div>
        <div class="generated-builder__form-row">
          <%= form.label :title, "Page title" %>
          <%= form.text_field :title, placeholder: "Defaults to file name", data: { generated_packet_upload_target: "title" } %>
        </div>
        <p class="generated-builder__hint" data-generated-packet-upload-target="status">Choose a PDF to upload directly into this packet.</p>
        <%= hidden_field_tag "segment[file_upload][storage_uri]", nil, data: { generated_packet_upload_target: "storageUri" } %>
        <%= hidden_field_tag "segment[file_upload][checksum]", nil, data: { generated_packet_upload_target: "checksum" } %>
        <%= hidden_field_tag "segment[file_upload][size_bytes]", nil, data: { generated_packet_upload_target: "sizeBytes" } %>
        <%= hidden_field_tag "segment[file_upload][content_type]", nil, data: { generated_packet_upload_target: "contentType" } %>
        <%= hidden_field_tag "segment[file_upload][logical_id]", nil, data: { generated_packet_upload_target: "logicalId" } %>
        <div class="generated-builder__form-actions">
          <%= form.submit "Upload and add PDF", class: "button button--small", data: { generated_packet_upload_target: "submit" } %>
        </div>
      <% end %>
    </div>
  </div>
</div>
