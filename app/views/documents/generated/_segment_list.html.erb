<% segment_warnings ||= {} %>
<% reorder_url ||= nil %>
<% csrf_token ||= form_authenticity_token %>
<% available_timeline_views ||= [] %>
<% available_group_sources ||= [] %>
<% return_to ||= nil %>
<% open_group_source_id ||= local_assigns.fetch(:open_group_source_id, params[:open_group_source_id]) %>
<% allow_group_actions = local_assigns.fetch(:allow_group_actions, document.packet_container?) %>
<% nested = local_assigns.fetch(:nested, false) %>
<% show_header = local_assigns.fetch(:show_header, true) %>
<% show_insert_panels = local_assigns.fetch(:show_insert_panels, true) %>
<% parent_packet_document = local_assigns.fetch(:parent_packet_document, nil) %>
<% parent_group_placement = local_assigns.fetch(:parent_group_placement, nil) %>
<% packet_document = parent_packet_document || (document.packet_container? ? document : nil) %>
<% relocate_url = packet_document ? relocate_event_documents_generated_segments_path(event, packet_document.logical_id) : nil %>
<% shared_container_packets = if document.group_container? && parent_group_placement.present?
                                Array(source_usage_labels[parent_group_placement.source.id])
                              else
                                []
                              end %>
<% container_label = document.group_container? ? "Group" : "Packet" %>
<% container_item_label = document.group_container? ? "group page" : "packet page" %>
<% empty_message = if document.group_container?
                     "No group pages yet. Add a canonical, page, or upload to build this shared group."
                   else
                     "No packet pages yet. Add a canonical, page, upload, or group to start the live working PDF."
                   end %>
<% segment_display_title = lambda do |segment|
     case segment.html_view_key
     when "cover_sheet"
       "Cover - #{segment.display_title}"
     when "section_break"
       "Section - #{segment.display_title}"
     else
       segment.display_title
     end
   end %>
<% segment_create_path = if return_to.present?
                           event_documents_generated_segments_path(event, document.logical_id, return_to: return_to)
                         else
                           event_documents_generated_segments_path(event, document.logical_id)
                         end %>
<% segment_list_classes = ["generated-builder__segments"] %>
<% segment_list_classes << "generated-builder__segments--nested" if nested %>
<% packet_group_placements = document.packet_container? ? segments.select { |segment| segment.group? && segment.group_document.present? } : [] %>

<div class="<%= segment_list_classes.join(' ') %>"
     data-controller="generated-segments"
     data-generated-segments-root="true"
     data-generated-segments-reorder-url-value="<%= reorder_url %>"
     data-generated-segments-relocate-url-value="<%= relocate_url %>"
     data-generated-segments-csrf-token-value="<%= csrf_token %>">
  <% if show_header %>
    <div class="generated-builder__sidebar-header">
      <div class="generated-builder__sidebar-header-main">
        <h2><%= "#{container_label} Pages" %></h2>
        <p class="generated-builder__hint">
          <% if document.group_container? %>
            These pages define the shared group. Any packet using this group will render the current contents in this order.
          <% else %>
            These pages are ordered for the live working PDF. Canonicals, reused pages, and groups stay shared across packets.
          <% end %>
        </p>
      </div>
    </div>
  <% end %>

  <% if segments.any? || nested %>
    <div class="generated-builder__toc <%= 'generated-builder__toc--nested' if nested %>">
      <% unless nested %>
        <div class="generated-builder__toc-head" aria-hidden="true">
          <span></span>
          <span>Segment</span>
          <span>Build</span>
          <span>Preview</span>
          <span>Settings</span>
          <span>Remove</span>
        </div>
      <% end %>

      <div class="generated-builder__toc-body"
           data-generated-segments-target="list"
           data-container-logical-id="<%= document.logical_id %>"
           data-container-kind="<%= document.group_container? ? 'group' : 'packet' %>"
           data-container-label="<%= document.title %>"
           data-packet-logical-id="<%= packet_document&.logical_id %>"
           data-group-placement-id="<%= parent_group_placement&.id %>"
           data-shared-packet-count="<%= shared_container_packets.size %>"
           data-reorder-url="<%= reorder_url %>"
           data-relocate-url="<%= relocate_url %>">
        <% segments.each do |segment| %>
          <%= render "documents/generated/segment_row",
                     event: event,
                     document: document,
                     segment: segment,
                     segment_display_title: segment_display_title,
                     container_label: container_label,
                     container_item_label: container_item_label,
                     available_pdf_documents: available_pdf_documents,
                     available_page_views: available_page_views,
                     available_canonical_sources: available_canonical_sources,
                     available_page_sources: available_page_sources,
                     available_group_sources: available_group_sources,
                     source_usage_labels: source_usage_labels,
                     available_timeline_views: available_timeline_views,
                     available_wedding_party_timeline_tags: available_wedding_party_timeline_tags,
                     segment_warnings: segment_warnings,
                     packet_group_placements: packet_group_placements,
                     parent_packet_document: parent_packet_document,
                     parent_group_placement: parent_group_placement,
                     csrf_token: csrf_token,
                     return_to: return_to,
                     open_group_source_id: open_group_source_id,
                     allow_group_actions: allow_group_actions,
                     nested: nested %>
        <% end %>
        <% if segments.empty? %>
          <p class="generated-builder__empty generated-builder__drop-placeholder">Drop a page here or use the group editor to add one.</p>
        <% end %>
      </div>
    </div>
  <% else %>
    <p class="generated-builder__empty"><%= empty_message %></p>
  <% end %>

  <% if show_insert_panels %>
    <div class="generated-builder__new">
      <div class="generated-builder__panel">
        <h3>Insert Canonical</h3>
        <%= form_with scope: :segment,
                      url: segment_create_path,
                      method: :post,
                      local: true,
                      class: "generated-builder__form" do |form| %>
          <div class="generated-builder__form-row">
            <%= form.label :source_id, "Canonical segment" %>
            <%= form.select :source_id,
                            options_from_collection_for_select(available_canonical_sources, :id, :display_title),
                            include_blank: "Choose a canonical" %>
          </div>
          <div class="generated-builder__form-actions">
            <%= form.submit "Insert canonical", class: "button button--small" %>
          </div>
        <% end %>
      </div>

      <div class="generated-builder__panel">
        <h3>Reuse Page</h3>
        <%= form_with scope: :segment,
                      url: segment_create_path,
                      method: :post,
                      local: true,
                      class: "generated-builder__form" do |form| %>
          <div class="generated-builder__form-row">
            <%= form.label :source_id, "Page from another packet" %>
            <%= form.select :source_id,
                            options_from_collection_for_select(available_page_sources, :id, :display_title),
                            include_blank: "Choose a reusable page" %>
          </div>
          <div class="generated-builder__form-actions">
            <%= form.submit "Reuse page", class: "button button--small" %>
          </div>
        <% end %>
      </div>

      <% if allow_group_actions %>
        <div class="generated-builder__panel">
          <h3>Insert Group</h3>
          <%= form_with scope: :segment,
                        url: segment_create_path,
                        method: :post,
                        local: true,
                        class: "generated-builder__form" do |form| %>
            <div class="generated-builder__form-row">
              <%= form.label :source_id, "Shared group" %>
              <%= form.select :source_id,
                              options_from_collection_for_select(available_group_sources, :id, :display_title),
                              include_blank: "Choose a group" %>
            </div>
            <div class="generated-builder__form-actions">
              <%= form.submit "Insert group", class: "button button--small" %>
            </div>
          <% end %>
        </div>

        <div class="generated-builder__panel">
          <h3>Create Group</h3>
          <%= form_with scope: :segment,
                        url: segment_create_path,
                        method: :post,
                        local: true,
                        class: "generated-builder__form" do |form| %>
            <div class="generated-builder__form-row">
              <%= form.label :group_title, "Group title" %>
              <%= form.text_field :group_title, placeholder: "Design & Decor" %>
            </div>
            <p class="generated-builder__hint">Creates a shared group with a section-break placeholder, then inserts it into this packet.</p>
            <div class="generated-builder__form-actions">
              <%= form.submit "Create and insert group", class: "button button--small" %>
            </div>
          <% end %>
        </div>
      <% end %>

      <div class="generated-builder__panel">
        <h3>Create New Page</h3>
        <%= form_with scope: :segment,
                      url: segment_create_path,
                      method: :post,
                      local: true,
                      class: "generated-builder__form" do |form| %>
          <div class="generated-builder__form-row">
            <%= form.label :view_key, "Page type" %>
            <%= form.select :view_key,
                            options_for_select(available_page_views),
                            include_blank: "Choose a page type" %>
          </div>
          <div class="generated-builder__form-row">
            <%= form.label :title, "Page title" %>
            <%= form.text_field :title, placeholder: "Defaults to page type" %>
          </div>
          <div class="generated-builder__form-actions">
            <%= form.submit "Create page", class: "button button--small" %>
          </div>
        <% end %>
      </div>

      <div class="generated-builder__panel">
        <h3>Attach Existing PDF</h3>
        <%= form_with scope: :segment,
                      url: segment_create_path,
                      method: :post,
                      local: true,
                      class: "generated-builder__form" do |form| %>
          <div class="generated-builder__form-row">
            <%= form.label :pdf_document_id, "Uploaded PDF" %>
            <%= form.select :pdf_document_id,
                            options_from_collection_for_select(available_pdf_documents, :id, :title),
                            include_blank: "Choose a PDF" %>
          </div>
          <div class="generated-builder__form-row">
            <%= form.label :title, "Page title" %>
            <%= form.text_field :title, placeholder: "Defaults to document title" %>
          </div>
          <div class="generated-builder__form-actions">
            <%= form.submit "Attach PDF", class: "button button--small" %>
          </div>
        <% end %>
      </div>

      <div class="generated-builder__panel">
        <h3><%= "Upload PDF Into #{container_label}" %></h3>
        <%= form_with scope: :segment,
                      url: segment_create_path,
                      method: :post,
                      local: true,
                      class: "generated-builder__form",
                      data: {
                        controller: "generated-packet-upload",
                        presign_url: presign_event_documents_path(event)
                      } do |form| %>
          <div class="generated-builder__form-row">
            <label for="segment_file_upload_<%= document.logical_id %>">PDF file</label>
            <input type="file"
                   id="segment_file_upload_<%= document.logical_id %>"
                   accept="application/pdf"
                   data-generated-packet-upload-target="file"
                   data-action="change->generated-packet-upload#upload">
          </div>
          <div class="generated-builder__form-row">
            <%= form.label :title, "Page title" %>
            <%= form.text_field :title, placeholder: "Defaults to file name", data: { generated_packet_upload_target: "title" } %>
          </div>
          <p class="generated-builder__hint" data-generated-packet-upload-target="status"><%= "Choose a PDF to upload directly into this #{document.group_container? ? 'group' : 'packet'}." %></p>
          <%= hidden_field_tag "segment[file_upload][storage_uri]", nil, data: { generated_packet_upload_target: "storageUri" } %>
          <%= hidden_field_tag "segment[file_upload][checksum]", nil, data: { generated_packet_upload_target: "checksum" } %>
          <%= hidden_field_tag "segment[file_upload][size_bytes]", nil, data: { generated_packet_upload_target: "sizeBytes" } %>
          <%= hidden_field_tag "segment[file_upload][content_type]", nil, data: { generated_packet_upload_target: "contentType" } %>
          <%= hidden_field_tag "segment[file_upload][logical_id]", nil, data: { generated_packet_upload_target: "logicalId" } %>
          <div class="generated-builder__form-actions">
            <%= form.submit "Upload and add PDF", class: "button button--small", data: { generated_packet_upload_target: "submit" } %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
