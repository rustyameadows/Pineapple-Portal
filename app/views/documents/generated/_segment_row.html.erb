<%
  nested ||= false
  shared_packets = Array(source_usage_labels[segment.source.id])
  shared_packets_tooltip = "Used in: #{shared_packets.join(', ')}" if shared_packets.any?
  segment_warning = segment_warnings[segment.id]
  show_toc_meta = !segment.group? || shared_packets.size > 1 || segment_warning.present?
  packet_group_placements = Array(local_assigns.fetch(:packet_group_placements, []))
  parent_packet_document = local_assigns.fetch(:parent_packet_document, nil)
  parent_group_placement = local_assigns.fetch(:parent_group_placement, nil)
  move_group_placements = !nested && document.packet_container? && !segment.group? ? packet_group_placements : []
  can_move_out_of_group = nested && parent_packet_document.present? && parent_group_placement.present? && !segment.group?
  group_document = segment.group_document if segment.group?
  force_build_available = segment.html_view? && segment.cached? && shared_packets.any?
  force_build_confirmation = if shared_packets.size > 1
                               "Force build this shared page and refresh #{pluralize(shared_packets.size, 'packet')}?"
                             else
                               "Force build this page and refresh its packet?"
                             end
  item_classes = ["generated-builder__toc-item"]
  item_classes << "generated-builder__toc-item--group" if segment.group?
  item_classes << "generated-builder__toc-item--child" if nested
%>

<div class="<%= item_classes.join(' ') %>"
     data-generated-segments-target="item"
     data-segment-id="<%= segment.id %>"
     data-segment-kind="<%= segment.group? ? 'group' : 'page' %>"
     draggable="true">
  <div class="generated-builder__toc-entry"
       data-controller="generated-segment-dialog">
    <div class="generated-builder__toc-row">
      <div class="generated-builder__toc-cell generated-builder__toc-cell--drag">
        <button type="button"
                class="generated-builder__drag-handle"
                data-generated-segments-target="handle"
                aria-label="<%= "Drag to reorder #{container_item_label}" %>">
          <span aria-hidden="true">⋮⋮</span>
        </button>
      </div>

      <div class="generated-builder__toc-cell generated-builder__toc-cell--title">
        <strong class="generated-builder__toc-title"><%= segment_display_title.call(segment) %></strong>
        <% if show_toc_meta %>
          <div class="generated-builder__toc-meta">
            <% unless segment.group? %>
              <%= render "documents/generated/render_status",
                         segment: segment,
                         event: event,
                         document: document,
                         return_to: return_to %>
            <% end %>
            <% if shared_packets.size > 1 %>
              <span class="generated-builder__status-tag generated-builder__status-tag--warning"
                    title="<%= shared_packets_tooltip %>"
                    aria-label="<%= "Shared in #{shared_packets.size} packets. #{shared_packets_tooltip}" %>">
                Shared in <%= shared_packets.size %> packets
              </span>
            <% end %>
            <% if segment_warning.present? %>
              <span class="generated-builder__status-tag generated-builder__status-tag--warning">
                <%= segment_warning.split(":", 2).last&.strip || segment_warning %>
              </span>
            <% end %>
          </div>
        <% end %>
      </div>

      <div class="generated-builder__toc-cell generated-builder__toc-cell--action generated-builder__toc-cell--build">
        <% if force_build_available %>
          <%= button_to "Force build",
                        force_build_event_documents_generated_segment_path(event, document.logical_id, segment, return_to: return_to),
                        method: :post,
                        class: "generated-builder__toc-action generated-builder__toc-action--button",
                        form: {
                          class: "generated-builder__toc-action-form",
                          data: { turbo_confirm: force_build_confirmation }
                        } %>
        <% end %>
      </div>

      <div class="generated-builder__toc-cell generated-builder__toc-cell--action">
        <%= link_to "Preview",
                    preview_event_documents_generated_segment_path(event, document.logical_id, segment),
                    class: "generated-builder__toc-action",
                    target: "_blank",
                    rel: "noopener" %>
      </div>

      <div class="generated-builder__toc-cell generated-builder__toc-cell--action">
        <button type="button"
                class="generated-builder__toc-action generated-builder__toc-action--button"
                data-action="generated-segment-dialog#open"
                aria-haspopup="dialog">
          Settings
        </button>
      </div>

      <div class="generated-builder__toc-cell generated-builder__toc-cell--action">
        <%= button_to "Remove",
                      event_documents_generated_segment_path(event, document.logical_id, segment, return_to: return_to),
                      method: :delete,
                      class: "generated-builder__toc-action generated-builder__toc-action--danger",
                      form: { class: "generated-builder__toc-action-form" },
                      data: { confirm: "Remove this #{segment.group? ? 'group' : 'page'} from the #{document.group_container? ? 'group' : 'packet'}?" } %>
      </div>
    </div>

    <dialog class="generated-builder__segment-dialog generated-builder__overlay-dialog"
            data-generated-segment-dialog-target="dialog"
            data-action="cancel->generated-segment-dialog#handleCancel click->generated-segment-dialog#handleBackdropClose">
      <div class="generated-builder__overlay-panel generated-builder__segment-dialog-panel">
        <header class="generated-builder__overlay-header generated-builder__segment-dialog-header">
          <h3><%= segment.group? ? "Group settings" : "Segment settings" %></h3>
          <p class="generated-builder__hint"><%= segment_display_title.call(segment) %></p>
        </header>

        <% if segment.group? %>
          <%= form_with model: segment,
                        scope: :segment,
                        url: event_documents_generated_segment_path(event, document.logical_id, segment, return_to: return_to),
                        method: :patch,
                        local: true,
                        class: "generated-builder__form generated-builder__segment-dialog-form" do |form| %>
            <div class="generated-builder__overlay-body generated-builder__segment-dialog-body">
              <div class="generated-builder__form-row">
                <%= form.label :title, "Group title" %>
                <%= form.text_field :title, value: segment.display_title %>
              </div>
              <p class="generated-builder__hint">Changes to this group update every packet that reuses it. Group pages are listed below this row.</p>
            </div>

            <footer class="generated-builder__overlay-actions generated-builder__segment-dialog-actions">
              <button type="button"
                      class="button button--small button--ghost"
                      data-action="generated-segment-dialog#close">
                Cancel
              </button>
              <%= form.submit "Save group", class: "button button--small" %>
            </footer>
          <% end %>
        <% else %>
          <%= form_with model: segment,
                        scope: :segment,
                        url: event_documents_generated_segment_path(event, document.logical_id, segment, return_to: return_to),
                        method: :patch,
                        local: true,
                        class: "generated-builder__form generated-builder__segment-dialog-form" do |form| %>
            <div class="generated-builder__overlay-body generated-builder__segment-dialog-body">
              <div class="generated-builder__form-row">
                <%= form.label :title, "Page title" %>
                <%= form.text_field :title, value: segment.display_title %>
              </div>

            <% if segment.pdf_asset? %>
              <div class="generated-builder__form-row">
                <%= form.label :pdf_document_id, "Attached PDF" %>
                <%= form.select :pdf_document_id,
                                options_from_collection_for_select(available_pdf_documents, :id, :title, segment.pdf_document_id),
                                include_blank: "Choose a PDF" %>
              </div>
            <% elsif segment.html_view? %>
              <% boolean_cast = ActiveModel::Type::Boolean.new %>
              <% if segment.html_view_key == DocumentSegment::TIMELINE_VIEW_KEY %>
                <% timeline_options = segment.html_options.stringify_keys %>
                <% selected_view = timeline_options["view_ref"].presence || available_timeline_views.dig(0, 1) %>
                <%= form.hidden_field :view_key, value: segment.html_view_key %>
                <%= form.fields_for :options, timeline_options do |options_fields| %>
                  <div class="generated-builder__form-row">
                    <%= options_fields.label :view_ref, "Timeline view" %>
                    <% if available_timeline_views.any? %>
                      <%= options_fields.select :view_ref,
                                               options_for_select(available_timeline_views, selected_view) %>
                    <% else %>
                      <p class="generated-builder__empty">No timeline views available yet.</p>
                    <% end %>
                  </div>

                  <fieldset class="generated-builder__form-row generated-builder__form-row--checkbox-group">
                    <legend>Show columns</legend>
                    <label class="generated-builder__checkbox">
                      <%= options_fields.check_box :show_location, { checked: boolean_cast.cast(timeline_options.fetch("show_location", true)) }, "1", "0" %>
                      <span>Location</span>
                    </label>
                    <label class="generated-builder__checkbox">
                      <%= options_fields.check_box :show_vendor, { checked: boolean_cast.cast(timeline_options.fetch("show_vendor", true)) }, "1", "0" %>
                      <span>Vendor</span>
                    </label>
                    <label class="generated-builder__checkbox">
                      <%= options_fields.check_box :show_team_members, { checked: boolean_cast.cast(timeline_options.fetch("show_team_members", true)) }, "1", "0" %>
                      <span>Team members</span>
                    </label>
                  </fieldset>
                <% end %>
              <% elsif segment.html_view_key == DocumentSegment::RUN_OF_SHOW_VIEW_KEY %>
                <% run_options = segment.html_options.stringify_keys %>
                <%= form.hidden_field :view_key, value: segment.html_view_key %>
                <%= form.fields_for :options, run_options do |options_fields| %>
                  <fieldset class="generated-builder__form-row generated-builder__form-row--checkbox-group">
                    <legend>Show columns</legend>
                    <label class="generated-builder__checkbox">
                      <%= options_fields.check_box :show_location, { checked: boolean_cast.cast(run_options.fetch("show_location", true)) }, "1", "0" %>
                      <span>Location</span>
                    </label>
                    <label class="generated-builder__checkbox">
                      <%= options_fields.check_box :show_vendor, { checked: boolean_cast.cast(run_options.fetch("show_vendor", true)) }, "1", "0" %>
                      <span>Vendor</span>
                    </label>
                    <label class="generated-builder__checkbox">
                      <%= options_fields.check_box :show_team_members, { checked: boolean_cast.cast(run_options.fetch("show_team_members", true)) }, "1", "0" %>
                      <span>Team members</span>
                    </label>
                  </fieldset>
                <% end %>
              <% elsif segment.html_view_key == DocumentSegment::TEXT_PAGE_VIEW_KEY %>
                <% text_options = segment.html_options.stringify_keys %>
                <% body_markdown = generated_segment_body_markdown(segment) %>
                <%= form.hidden_field :view_key, value: segment.html_view_key %>
                <%= form.fields_for :options, text_options do |options_fields| %>
                  <div class="generated-builder__markdown-editor" data-controller="generated-markdown-editor">
                    <div class="generated-builder__form-row">
                      <%= options_fields.label :body_markdown, "Page content" %>
                      <%= options_fields.text_area :body_markdown,
                                                  value: body_markdown,
                                                  rows: 14,
                                                  class: "generated-builder__textarea",
                                                  placeholder: "Write notes, schedules, or instructions with Markdown syntax.",
                                                  data: {
                                                    generated_markdown_editor_target: "source",
                                                    action: "input->generated-markdown-editor#syncFromSource"
                                                  } %>
                    </div>
                    <div class="generated-builder__overlay-trigger-row">
                      <button type="button"
                              class="button button--tiny button--ghost generated-builder__overlay-trigger"
                              data-generated-markdown-editor-target="openButton"
                              data-action="generated-markdown-editor#open"
                              aria-haspopup="dialog"
                              hidden>
                        Open large editor
                      </button>
                    </div>
                    <dialog class="generated-builder__overlay-dialog"
                            data-generated-markdown-editor-target="dialog"
                            data-action="cancel->generated-markdown-editor#handleCancel click->generated-markdown-editor#handleBackdropClose">
                      <div class="generated-builder__overlay-panel">
                        <header class="generated-builder__overlay-header">
                          <h3>Large text editor</h3>
                        </header>
                        <div class="generated-builder__overlay-body">
                          <textarea class="generated-builder__overlay-textarea"
                                    aria-label="Large markdown editor"
                                    data-generated-markdown-editor-target="overlay"
                                    data-action="input->generated-markdown-editor#syncFromOverlay"><%= body_markdown %></textarea>
                        </div>
                        <footer class="generated-builder__overlay-actions">
                          <button type="button"
                                  class="button button--small"
                                  data-action="generated-markdown-editor#close">
                            Done
                          </button>
                        </footer>
                      </div>
                    </dialog>
                  </div>
                <% end %>
              <% elsif segment.html_view_key == DocumentSegment::EVENT_OVERVIEW_VIEW_KEY %>
                <%= form.hidden_field :view_key, value: segment.html_view_key %>
                <p class="generated-builder__hint">This page is powered by live event, planner, and vendor data. Update those records in the app to change the sheet.</p>
              <% elsif segment.html_view_key == DocumentSegment::VENDOR_CONTACTS_VIEW_KEY %>
                <%= form.hidden_field :view_key, value: segment.html_view_key %>
                <p class="generated-builder__hint">This page is powered by live planner and vendor data. Update those records in the app to change the sheet.</p>
              <% elsif segment.html_view_key == DocumentSegment::WEDDING_PARTY_REFERENCE_VIEW_KEY %>
                <% reference_options = GeneratedPacketSource.default_wedding_party_reference_options.merge(segment.html_options.stringify_keys) %>
                <% timeline_mode = reference_options["timeline_mode"] %>
                <%= form.hidden_field :view_key, value: segment.html_view_key %>
                <%= form.fields_for :options, reference_options do |options_fields| %>
                  <div class="generated-builder__form-row">
                    <%= options_fields.label :timeline_mode, "Wedding party timeline source" %>
                    <%= options_fields.select :timeline_mode,
                                              options_for_select([["Auto (first two sides)", "auto"], ["Manual columns", "manual"]], timeline_mode) %>
                  </div>

                  <fieldset class="generated-builder__form-row generated-builder__form-row--checkbox-group">
                    <legend>Manual timeline columns</legend>
                    <% selected_tag_ids = Array(reference_options["timeline_tag_ids"]).map(&:to_i) %>
                    <% 4.times do |index| %>
                      <div class="generated-builder__form-row">
                        <%= label_tag "segment_options_timeline_tag_ids_#{index}", "Column #{("A".ord + index).chr}" %>
                        <%= select_tag "segment[options][timeline_tag_ids][]",
                                       options_for_select([["Auto / None", ""]] + available_wedding_party_timeline_tags, selected_tag_ids[index]),
                                       id: "segment_options_timeline_tag_ids_#{index}" %>
                      </div>
                    <% end %>
                  </fieldset>
                <% end %>
                <p class="generated-builder__hint">Auto mode uses the first two key-person groups. Manual mode lets the planner pick up to four tag-driven columns.</p>
              <% end %>
            <% end %>
          </div>

          <footer class="generated-builder__overlay-actions generated-builder__segment-dialog-actions">
            <button type="button"
                    class="button button--small button--ghost"
                    data-action="generated-segment-dialog#close">
              Cancel
            </button>
            <%= form.submit "Save settings", class: "button button--small" %>
          </footer>
        <% end %>

          <% if move_group_placements.any? %>
            <div class="generated-builder__segment-dialog-move">
              <%= form_with url: move_to_group_event_documents_generated_segment_path(event, document.logical_id, segment, return_to: return_to),
                            method: :patch,
                            local: true,
                            class: "generated-builder__form generated-builder__move-form" do %>
                <div class="generated-builder__form-row">
                  <%= label_tag "segment_#{segment.id}_target_group_placement_id", "Move to group" %>
                  <%= select_tag :target_group_placement_id,
                                 options_from_collection_for_select(move_group_placements, :id, :display_title),
                                 include_blank: "Choose a group",
                                 id: "segment_#{segment.id}_target_group_placement_id" %>
                </div>
                <div class="generated-builder__form-actions">
                  <%= submit_tag "Move", class: "button button--small button--ghost" %>
                </div>
              <% end %>
            </div>
          <% elsif can_move_out_of_group %>
            <div class="generated-builder__segment-dialog-move">
              <%= button_to "Move out of group",
                            move_out_of_group_event_documents_generated_segment_path(event, document.logical_id, segment, return_to: return_to),
                            method: :patch,
                            params: {
                              packet_logical_id: parent_packet_document.logical_id,
                              group_placement_id: parent_group_placement.id
                            },
                            class: "button button--small button--ghost",
                            form: { class: "generated-builder__move-form" } %>
            </div>
          <% end %>
      <% end %>
    </div>
  </dialog>
  </div>

  <% if segment.group? && group_document.present? %>
    <div class="generated-builder__toc-children">
      <%= render "documents/generated/segment_list",
                 event: event,
                 document: group_document,
                 segments: group_document.packet_placements.includes(:source).ordered.to_a,
                 available_pdf_documents: available_pdf_documents,
                 available_page_views: available_page_views,
                 available_canonical_sources: available_canonical_sources,
                 available_page_sources: available_page_sources,
                 available_group_sources: [],
                 source_usage_labels: source_usage_labels,
                 available_timeline_views: available_timeline_views,
                 available_wedding_party_timeline_tags: available_wedding_party_timeline_tags,
                 segment_warnings: {},
                 reorder_url: reorder_event_documents_generated_segments_path(event, group_document.logical_id),
                 csrf_token: csrf_token,
                 return_to: return_to,
                 allow_group_actions: false,
                 nested: true,
                 show_header: false,
                 show_insert_panels: false,
                 parent_packet_document: document,
                 parent_group_placement: segment %>
    </div>
  <% elsif segment.group? %>
    <div class="generated-builder__toc-children generated-builder__toc-children--empty">
      <p class="generated-builder__empty">This group reference no longer points to a valid group.</p>
    </div>
  <% end %>
</div>
