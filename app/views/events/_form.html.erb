<% submit_label = local_assigns.fetch(:submit_label, @event.persisted? ? "Save Changes" : "Create Event") %>
<% cancel_path = local_assigns.fetch(:cancel_path, @event.persisted? ? event_path(@event) : events_path) %>
<% cancel_label = local_assigns.fetch(:cancel_label, "Cancel") %>

<%= form_with model: @event, class: "event-create-form" do |form| %>
  <% if @event.errors.any? %>
    <div class="event-create-form__errors">
      <h2><%= pluralize(@event.errors.count, "error") %> prevented saving:</h2>
      <ul>
        <% @event.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="event-create-form__panel">
    <div class="event-create-form__grid">
      <div class="event-create-form__group">
        <%= form.label :name, "Event Title" %>
        <%= form.text_field :name, required: true, autofocus: true %>
      </div>

      <div class="event-create-form__group">
        <%= form.label :starts_on, "Start Date" %>
        <%= form.date_field :starts_on %>
      </div>

      <div class="event-create-form__group">
        <%= form.label :ends_on, "End Date" %>
        <%= form.date_field :ends_on %>
      </div>

      <div class="event-create-form__group">
        <%= form.label :location, "Primary Location" %>
        <%= form.text_field :location %>
      </div>

      <div class="event-create-form__group">
        <%= form.label :location_secondary, "Secondary location line" %>
        <%= form.text_field :location_secondary, placeholder: "City, State" %>
      </div>
    </div>

    <div class="event-create-form__actions">
      <%= link_to cancel_label, cancel_path, class: "button button--ghost" %>
      <%= form.submit submit_label, class: "button" %>
    </div>
  </div>
<% end %>
