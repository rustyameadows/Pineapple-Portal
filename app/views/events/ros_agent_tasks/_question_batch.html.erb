<% if question_batch %>
  <% current_event = local_assigns.fetch(:event, @event) %>
  <section class="ros-agent-canvas-panel" id="planning-questions" tabindex="-1">
    <h2>Planning Questions</h2>
    <p><%= question_batch.summary %></p>

    <%= form_with url: answer_questions_event_ros_agent_task_path(current_event, task),
                  method: :post,
                  local: true,
                  id: "ros-agent-question-form",
                  class: "ros-agent-question-form" do %>
      <div class="ros-agent-question-grid">
        <% question_batch.questions_json.each do |question| %>
          <% options = Array(question["options"]) %>
          <% question_key = question["key"].to_s %>
          <% custom_radio_id = "answer_#{question_key.parameterize}_custom" %>

          <article class="ros-agent-question-card">
            <header>
              <h3><%= question["label"] %></h3>
              <p><%= question["question"] %></p>
            </header>

            <div class="ros-agent-question-card__options">
              <% options.each do |option| %>
                <label class="calendar-item-form__pill">
                  <%= radio_button_tag "answers[#{question_key}]",
                                       option["value"],
                                       option["recommended"],
                                       data: { ros_agent_task_target: ("recommendedAnswer" if option["recommended"]) } %>
                  <span><%= option["label"] || option["value"] %></span>
                </label>
              <% end %>

              <% if question["freeform_allowed"] || options.empty? %>
                <label class="calendar-item-form__pill ros-agent-question-card__custom-choice" for="<%= custom_radio_id %>">
                  <%= radio_button_tag "answers[#{question_key}]",
                                       ros_agent_custom_answer_value,
                                       options.empty?,
                                       id: custom_radio_id %>
                  <span>Custom answer</span>
                </label>
                <%= text_field_tag "custom_answers[#{question_key}]",
                                   nil,
                                   class: "event-form__input",
                                   placeholder: "Type a custom answer",
                                   data: {
                                     action: "input->ros-agent-task#selectCustomAnswer",
                                     custom_answer_radio_id: custom_radio_id
                                   } %>
              <% end %>
            </div>
          </article>
        <% end %>
      </div>
    <% end %>
  </section>
<% end %>
