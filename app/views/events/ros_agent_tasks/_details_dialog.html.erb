<% canvas_state ||= "working" %>
<% question_batch ||= nil %>

<dialog class="ros-agent-details-dialog ros-agent-task-details-dialog"
        data-ros-agent-details-target="taskDialog"
        data-action="cancel->ros-agent-details#handleCancel click->ros-agent-details#handleBackdropClose">
  <div class="ros-agent-details-dialog__panel">
    <header class="ros-agent-details-dialog__header">
      <div>
        <p class="ros-agent-canvas__label">Task</p>
        <h2>Task Details</h2>
      </div>
      <button type="button"
              class="button button--ghost button--small"
              data-action="ros-agent-details#close">
        Close
      </button>
    </header>
    <div class="ros-agent-details-dialog__body" data-ros-agent-status-target="metadata">
      <%= render "metadata", task: task, status_snapshot: status_snapshot %>
    </div>
  </div>
</dialog>

<dialog class="ros-agent-details-dialog ros-agent-canvas-details-dialog"
        data-ros-agent-details-target="canvasDialog"
        data-action="cancel->ros-agent-details#handleCancel click->ros-agent-details#handleBackdropClose">
  <div class="ros-agent-details-dialog__panel">
    <header class="ros-agent-details-dialog__header">
      <div>
        <p class="ros-agent-canvas__label">Canvas</p>
        <h2>Canvas Details</h2>
      </div>
      <button type="button"
              class="button button--ghost button--small"
              data-action="ros-agent-details#close">
        Close
      </button>
    </header>
    <div class="ros-agent-details-dialog__body" data-ros-agent-status-target="canvasMetadata">
      <%= render "canvas_metadata",
                 task: task,
                 status_snapshot: status_snapshot,
                 canvas_state: canvas_state,
                 question_batch: question_batch %>
    </div>
  </div>
</dialog>
