<% status_snapshot ||= {} %>
<% status = status_snapshot[:status] || status_snapshot["status"] %>
<% status_label = status_snapshot[:status_label] || status_snapshot["status_label"] || status.to_s.humanize %>
<% active = status_snapshot[:active].nil? ? status.to_s.in?(%w[draft analyzing drafting planning applying]) : status_snapshot[:active] %>
<% source_files = Array(status_snapshot[:source_files] || status_snapshot["source_files"]) %>
<% llm_calls = Array(status_snapshot[:llm_calls] || status_snapshot["llm_calls"]) %>
<% task_events = Array(status_snapshot[:task_events] || status_snapshot["task_events"]) %>
<% last_error = status_snapshot[:last_error] || status_snapshot["last_error"] %>

<div data-controller="ros-agent-status"
     data-ros-agent-status-status-url-value="<%= status_url %>"
     data-ros-agent-status-initial-status-value="<%= status %>">
  <section class="event-section__body">
    <div class="event-section__status">
      <span class="event-approvals__status-pill event-approvals__status-pill--<%= status %>"
            data-ros-agent-status-target="statusLabel"><%= status_label %></span>
      <p class="event-section__lead" data-ros-agent-status-target="statusSummary">
        <%= active ? "Polling every 2 seconds while the task is active." : "Polling has stopped for this task." %>
      </p>
    </div>
  </section>

  <%= render "source_files", source_files: source_files %>
  <%= render "llm_calls", llm_calls: llm_calls %>
  <%= render "latest_error", last_error: last_error %>
  <%= render "task_history", task_events: task_events %>
</div>
