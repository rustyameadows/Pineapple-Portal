<% draft = task.draft_ros_json || {} %>
<% draft_timezone = ros_agent_draft_timezone(task) %>
<% entries_by_day = ros_agent_draft_entries_grouped_by_day(draft, draft_timezone) %>
<% all_draft_entries = entries_by_day.flat_map(&:last).map { |entry| ros_agent_draft_display_entry(entry) } %>
<% preferred_item_keys = %w[title timing duration_minutes notes location vendor_handling staff_handling tags confidence planner_review_needed source_refs] %>
<% hidden_item_keys = %w[details day_label] %>
<% all_item_keys = all_draft_entries.flat_map(&:keys).uniq - hidden_item_keys %>
<% draft_item_keys = preferred_item_keys.select { |key| all_item_keys.include?(key) } + (all_item_keys - preferred_item_keys).sort %>
<% draft_table_colspan = draft_item_keys.size + 1 %>
<% draft_table_min_width = 12 + (draft_item_keys.size * 14) %>

<% if entries_by_day.any? %>
  <section class="ros-agent-draft__surface"
           id="draft-ros"
           tabindex="-1"
           style="--ros-agent-draft-table-width: <%= draft_table_min_width %>rem;">
    <table class="event-table event-calendars__table ros-agent-draft__table">
      <thead>
        <tr>
          <th class="event-calendars__schedule-column ros-agent-draft__schedule-column">Schedule</th>
          <% draft_item_keys.each do |key| %>
            <th><%= key %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% entries_by_day.each do |day, entries| %>
          <tr class="event-calendars__date-row ros-agent-draft__date-row">
            <td colspan="<%= draft_table_colspan %>">
              <span class="event-calendars__date-label"><%= ros_agent_draft_day_label(day, entries, draft_timezone) %></span>
            </td>
          </tr>
          <% entries.each do |entry| %>
            <% display_entry = ros_agent_draft_display_entry(entry) %>
            <tr class="event-calendars__row">
              <td class="event-calendars__schedule-column ros-agent-draft__schedule-column"><%= ros_agent_draft_schedule_label(entry, draft_timezone) %></td>
              <% draft_item_keys.each do |key| %>
                <td><%= ros_agent_draft_item_value(display_entry, key) %></td>
              <% end %>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </section>
<% end %>
