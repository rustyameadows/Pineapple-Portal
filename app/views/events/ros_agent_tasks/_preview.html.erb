<% preview = task.preview_json || {} %>
<% operations = Array(preview["operations"]) %>
<% grouped_preview_rows = preview["grouped_preview_rows"] || {} %>
<% grouped_rows = [
  ["Create", Array(grouped_preview_rows["creates"])],
  ["Update", Array(grouped_preview_rows["updates"])],
  ["Delete", Array(grouped_preview_rows["deletes"])]
].flat_map { |action, rows| rows.map { |row| row.merge("action" => action) } } %>

<% if preview.present? %>
  <section class="event-section__body">
    <h2>Review Plan</h2>

    <% summary_parts = %w[create_count update_count delete_count tag_change_count time_change_count].filter_map { |key| value = preview[key]; "#{key.humanize}: #{value}" if value.present? } %>
    <p><%= summary_parts.any? ? summary_parts.join(", ") : preview["summary"] %></p>

    <% blocking_errors = Array(task.validation_json["blocking_errors"]) %>
    <% warnings = Array(preview["warnings"] || task.validation_json["warnings"]) %>
    <% if blocking_errors.any? %>
      <div class="event-section__empty">
        <% blocking_errors.each do |error| %>
          <p><%= error %></p>
        <% end %>
      </div>
    <% end %>
    <% if warnings.any? %>
      <div class="event-section__note">
        <% warnings.each do |warning| %>
          <p><%= warning %></p>
        <% end %>
      </div>
    <% end %>

    <% if grouped_rows.any? %>
      <table class="event-table event-calendars__table">
        <thead>
          <tr>
            <th>Action</th>
            <th>Summary</th>
            <th>Title</th>
            <th>When</th>
          </tr>
        </thead>
        <tbody>
          <% grouped_rows.each do |row| %>
            <% after = row["after"] || {} %>
            <% before = row["before"] || {} %>
            <tr>
              <td><%= row["action"] %></td>
              <td><%= row["summary"] %></td>
              <td><%= after["title"] || before["title"] || "—" %></td>
              <td><%= after["starts_at"] || before["starts_at"] || "—" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% elsif operations.any? %>
      <table class="event-table event-calendars__table">
        <thead>
          <tr>
            <th>Action</th>
            <th>Title</th>
            <th>When</th>
          </tr>
        </thead>
        <tbody>
          <% operations.each do |operation| %>
            <tr>
              <td><%= operation["action"] || operation["operation_type"] %></td>
              <td><%= operation["title"] || operation.dig("attributes", "title") || operation.dig("item_attributes", "title") || operation["summary"] %></td>
              <td><%= operation["when"] || operation.dig("attributes", "starts_at") || operation.dig("item_attributes", "starts_at") || "—" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>

    <% if task.ready_to_apply? %>
      <%= button_to "Apply Approved Plan", apply_event_ros_agent_task_path(@event, task), method: :post, class: "event-section__cta" %>
    <% elsif task.approvable? %>
      <%= form_with url: approve_event_ros_agent_task_path(@event, task), method: :post, local: true, data: { action: "submit->ros-agent-task#confirmHighRisk" } do %>
        <% if task.high_risk_plan? && !task.high_risk_acknowledged? %>
          <label class="calendar-item-form__pill">
            <%= check_box_tag :high_risk_acknowledgement, "1", false, data: { ros_agent_task_target: "highRiskAcknowledgement" } %>
            <span>Acknowledge high-risk operations</span>
          </label>
        <% end %>
        <%= submit_tag "Approve Plan", class: "event-section__cta" %>
      <% end %>
    <% end %>
  </section>
<% end %>
