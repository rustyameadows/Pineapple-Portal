<% planning_company = @planning_company_global_vendor %>
<% planning_vendor = @planning_company_event_vendor %>
<% planners = Array(@planner_team_members) %>

<% provide :page_shell do %>
  <div class="event-layout event-layout--vendor-settings">
    <%= render "events/sidebar_navigation", event: @event %>

    <div class="event-layout__main">
      <%= render "shared/flash" %>

      <section class="event-section">
        <header class="event-section__header">
          <div>
            <p class="event-section__eyebrow">Event Partners</p>
            <h1 class="event-section__title">Vendors</h1>
          </div>
          <div class="event-section__actions"
               data-controller="event-vendor-dialog"
               data-event-vendor-dialog-vendor-id-value="new"
               data-event-vendor-dialog-auto-open-value="<%= params[:event_vendor_id].to_s == 'new' %>">
            <button type="button"
                    class="event-section__cta"
                    data-event-vendor-dialog-target="trigger"
                    data-action="event-vendor-dialog#open"
                    aria-haspopup="dialog"
                    aria-controls="event-vendor-new-dialog">
              Add Vendor
            </button>
            <%= render "events/settings/add_vendor_dialog", event: @event, event_vendor: @event_vendor %>
          </div>
        </header>

        <div class="event-section__body">
          <div class="event-settings__vendor-roster">
            <div class="event-settings__vendor-roster-shell" role="region" aria-label="Event vendor roster" tabindex="0">
              <table class="event-settings__vendor-roster-table"
                     data-vendor-roster
                     aria-label="Vendors and selected contacts for this event">
                <thead>
                  <tr>
                    <th scope="col">Vendor</th>
                    <th scope="col">Edit</th>
                  </tr>
                </thead>
                <tbody>
                  <% if planning_company && planning_vendor %>
                    <% planning_meals = @event.pineapple_team_meals.to_s.strip.presence %>
                    <tr class="event-settings__vendor-roster-row event-settings__vendor-roster-row--planning"
                        data-vendor-row
                        data-event-vendor-id="<%= planning_vendor.id %>">
                      <th scope="row" class="event-settings__vendor-roster-cell event-settings__vendor-roster-cell--identity">
                        <div class="event-settings__vendor-roster-primary">
                          <strong><%= planning_company.name %></strong>
                          <div class="event-settings__vendor-roster-meta-line">
                            <span class="event-settings__vendor-roster-detail"><%= planning_vendor.vendor_type.presence || planning_company.default_vendor_type.presence || "Planning" %></span>
                            <% if planning_company.default_social_handle.present? %><span class="event-settings__vendor-roster-detail"><%= planning_company.default_social_handle %></span><% end %>
                          </div>
                        </div>
                      </th>
                      <td class="event-settings__vendor-roster-cell event-settings__vendor-roster-cell--actions"
                          data-controller="event-vendor-dialog"
                          data-event-vendor-dialog-vendor-id-value="planning"
                          data-event-vendor-dialog-auto-open-value="<%= @event.errors.any? || params[:event_vendor_id].to_s == 'planning' %>">
                        <button type="button"
                                class="event-settings__vendor-roster-action"
                                data-event-vendor-dialog-target="trigger"
                                data-action="event-vendor-dialog#open"
                                aria-haspopup="dialog"
                                aria-controls="event-vendor-planning-dialog">
                          Edit
                        </button>
                        <%= render "events/settings/planning_company_dialog",
                                   event: @event,
                                   planning_company_global_vendor: planning_company,
                                   planner_team_members: planners %>
                      </td>
                    </tr>

                    <% if planning_meals %>
                      <tr class="event-settings__vendor-roster-row event-settings__vendor-roster-row--child event-settings__vendor-roster-row--meals"
                          data-vendor-meals-row
                          data-parent-event-vendor-id="<%= planning_vendor.id %>">
                        <td colspan="2" class="event-settings__vendor-roster-contact-cell">
                          <div class="event-settings__vendor-roster-contact event-settings__vendor-roster-meals">
                            <span class="event-settings__vendor-roster-meals-label">Meals</span>
                            <span class="event-settings__vendor-roster-meals-copy" title="<%= planning_meals %>"><%= event_vendor_meal_notes_preview(planning_meals) %></span>
                          </div>
                        </td>
                      </tr>
                    <% end %>

                    <% planners.each do |member| %>
                      <% user = member.user %>
                      <% next unless user %>
                      <tr class="event-settings__vendor-roster-row event-settings__vendor-roster-row--child event-settings__vendor-roster-row--contact"
                          data-vendor-contact-row
                          data-parent-event-vendor-id="<%= planning_vendor.id %>">
                        <td colspan="2" class="event-settings__vendor-roster-contact-cell">
                          <div class="event-settings__vendor-roster-contact">
                            <span class="event-settings__vendor-contact-name"><%= user.name %></span>
                            <% if user.title.present? %><span class="event-settings__vendor-contact-meta"><%= user.title %></span><% end %>
                            <% if (email = event_vendor_contact_email(user)) %><span class="event-settings__vendor-contact-meta"><%= email %></span><% end %>
                            <% if user.phone_number.present? %><span class="event-settings__vendor-contact-meta"><%= user.phone_number %></span><% end %>
                          </div>
                        </td>
                      </tr>
                    <% end %>
                  <% end %>

                  <% @event_vendors.each_with_index do |vendor, index| %>
                    <% selections = vendor.event_vendor_contacts.sort_by { |selection| [selection.position, selection.id] } %>
                    <% selected_contacts = selections.map(&:global_vendor_contact).compact %>
                    <% vendor_type = vendor.vendor_type.presence || vendor.global_vendor.default_vendor_type.presence || "—" %>
                    <% team_meals = vendor.team_meals.to_s.strip.presence %>
                    <tr class="event-settings__vendor-roster-row event-settings__vendor-roster-row--vendor"
                        data-vendor-row
                        data-event-vendor-id="<%= vendor.id %>">
                      <th scope="row" class="event-settings__vendor-roster-cell event-settings__vendor-roster-cell--identity">
                        <div class="event-settings__vendor-roster-primary">
                          <strong><%= vendor.global_vendor.name %></strong>
                          <div class="event-settings__vendor-roster-meta-line">
                            <% unless vendor_type == "—" %><span class="event-settings__vendor-roster-detail"><%= vendor_type %></span><% end %>
                            <% if vendor.global_vendor.default_social_handle.present? %><span class="event-settings__vendor-roster-detail"><%= vendor.global_vendor.default_social_handle %></span><% end %>
                            <% unless vendor.client_visible? %><span class="event-settings__badge event-settings__badge--internal">Hidden</span><% end %>
                          </div>
                        </div>
                      </th>
                      <td class="event-settings__vendor-roster-cell event-settings__vendor-roster-cell--actions"
                          data-controller="event-vendor-dialog"
                          data-event-vendor-dialog-vendor-id-value="<%= vendor.id %>"
                          data-event-vendor-dialog-auto-open-value="<%= params[:event_vendor_id].to_s == vendor.id.to_s %>">
                        <button type="button"
                                class="event-settings__vendor-roster-action"
                                data-event-vendor-dialog-target="trigger"
                                data-action="event-vendor-dialog#open"
                                aria-haspopup="dialog"
                                aria-controls="event-vendor-<%= vendor.id %>-dialog">
                          Edit
                        </button>
                        <%= render "events/settings/vendor_edit_dialog",
                                   event: @event,
                                   vendor:,
                                   vendors: @event_vendors,
                                   index: %>
                      </td>
                    </tr>

                    <% if team_meals %>
                      <tr class="event-settings__vendor-roster-row event-settings__vendor-roster-row--child event-settings__vendor-roster-row--meals"
                          data-vendor-meals-row
                          data-parent-event-vendor-id="<%= vendor.id %>">
                        <td colspan="2" class="event-settings__vendor-roster-contact-cell">
                          <div class="event-settings__vendor-roster-contact event-settings__vendor-roster-meals">
                            <span class="event-settings__vendor-roster-meals-label">Meals</span>
                            <span class="event-settings__vendor-roster-meals-copy" title="<%= team_meals %>"><%= event_vendor_meal_notes_preview(team_meals) %></span>
                          </div>
                        </td>
                      </tr>
                    <% end %>

                    <% selected_contacts.each do |contact| %>
                      <tr class="event-settings__vendor-roster-row event-settings__vendor-roster-row--child event-settings__vendor-roster-row--contact"
                          data-vendor-contact-row
                          data-parent-event-vendor-id="<%= vendor.id %>">
                        <td colspan="2" class="event-settings__vendor-roster-contact-cell">
                          <div class="event-settings__vendor-roster-contact">
                            <span class="event-settings__vendor-contact-name"><%= contact.name.presence || contact.title.presence || "Contact" %></span>
                            <% if contact.title.present? && contact.title != contact.name %><span class="event-settings__vendor-contact-meta"><%= contact.title %></span><% end %>
                            <% if contact.email.present? %><span class="event-settings__vendor-contact-meta"><%= contact.email %></span><% end %>
                            <% if contact.phone.present? %><span class="event-settings__vendor-contact-meta"><%= contact.phone %></span><% end %>
                          </div>
                        </td>
                      </tr>
                    <% end %>
                  <% end %>
                </tbody>
              </table>
            </div>

            <% if @event_vendors.empty? %>
              <p class="event-settings__empty">No outside vendors have been added to this event yet.</p>
            <% end %>
          </div>
        </div>
      </section>
    </div>
  </div>
<% end %>
