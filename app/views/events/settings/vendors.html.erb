<% provide :page_shell do %>
  <div class="event-layout">
    <%= render "events/sidebar_navigation", event: @event %>

    <div class="event-layout__main">
      <%= render "shared/flash" %>

      <section class="event-section">
        <header class="event-section__header">
          <div>
            <p class="event-section__eyebrow">Event Partners</p>
            <h1 class="event-section__title">Vendors</h1>
            <p class="event-section__lead">Track vendor details, manage visibility, and keep contact info handy for your team.</p>
          </div>
        </header>

        <div class="event-section__body">
          <div class="event-settings__contacts-section">
            <div class="event-settings__contact-item">
              <%= form_with model: @event, local: true, html: { class: "event-settings__form" } do |form| %>
                <%= hidden_field_tag :return_to, request.fullpath %>
                <% if @event.errors.any? %>
                  <div class="event-settings__form-errors">
                    <h3><%= pluralize(@event.errors.count, "error") %> prevented saving:</h3>
                    <ul>
                      <% @event.errors.full_messages.each do |message| %>
                        <li><%= message %></li>
                      <% end %>
                    </ul>
                  </div>
                <% end %>

                <div class="event-settings__vendor-top-row">
                  <div>
                    <p class="event-section__eyebrow">Planning</p>
                    <h3 class="event-settings__subheading">Pineapple Productions</h3>
                  </div>

                  <div class="event-settings__vendor-actions">
                    <div class="event-settings__controls event-settings__controls--vendor-top">
                      <%= button_tag "Save Pineapple meals", type: "submit", class: "event-settings__control" %>
                    </div>
                  </div>
                </div>

                <%= render "events/settings/markdown_field",
                           form:,
                           field_name: :pineapple_team_meals,
                           label_text: "Pineapple Team Meals",
                           rows: 3,
                           placeholder: "Note Pineapple meal counts, timing, pickup details, or links.",
                           hint_text: "Use this for Pineapple Productions meal notes on this event.",
                           tools: %i[bold italic link],
                           support_text: "Supports Markdown for bold, italic, and links." %>
              <% end %>
            </div>

            <% if @event_vendors.any? %>
              <ul class="event-settings__contact-list">
                <% @event_vendors.each_with_index do |vendor, index| %>
                  <li class="event-settings__contact-item">
                    <%= form_with model: [@event, vendor], local: true, html: { class: "event-settings__form" } do |form| %>
                      <%= hidden_field_tag :return_to, request.fullpath %>
                      <div class="event-settings__vendor-top-row">
                        <div class="event-settings__vendor-core">
                          <div class="event-settings__field">
                            <span class="event-settings__field-label">Vendor</span>
                            <strong><%= vendor.global_vendor.name %></strong>
                          </div>
                          <div class="event-settings__field">
                            <%= form.label :vendor_type, "Vendor type" %>
                            <%= form.text_field :vendor_type, placeholder: "Floral, Lighting, etc." %>
                          </div>
                          <div class="event-settings__field">
                            <span class="event-settings__field-label">Social handle</span>
                            <span><%= vendor.global_vendor.default_social_handle.presence || "—" %></span>
                          </div>
                          <div class="event-settings__field event-settings__field--checkbox">
                            <label class="event-settings__toggle">
                              <%= form.check_box :client_visible %>
                              <span>Visible to clients</span>
                            </label>
                          </div>
                        </div>

                        <div class="event-settings__vendor-actions">
                          <div class="event-settings__controls event-settings__controls--vendor-top">
                            <%= button_tag "Save vendor", type: "submit", class: "event-settings__control" %>
                            <% if index.positive? %>
                              <%= link_to "Move up", move_up_event_event_vendor_path(@event, vendor, return_to: request.fullpath), data: { turbo_method: :patch }, class: "event-settings__control" %>
                            <% end %>
                            <% if index < @event_vendors.length - 1 %>
                              <%= link_to "Move down", move_down_event_event_vendor_path(@event, vendor, return_to: request.fullpath), data: { turbo_method: :patch }, class: "event-settings__control" %>
                            <% end %>
                            <%= link_to "Remove", event_event_vendor_path(@event, vendor, return_to: request.fullpath), data: { turbo_method: :delete, turbo_confirm: "Remove this vendor?" }, class: "event-settings__control event-settings__control--danger" %>
                          </div>
                        </div>
                      </div>

                      <%= render "events/settings/markdown_field",
                                 form:,
                                 field_name: :team_meals,
                                 label_text: "Team Meals",
                                 rows: 3,
                                 placeholder: "Note vendor-provided meals, counts, timing, pickup details, or links.",
                                 hint_text: "Use this for event-specific team meal notes.",
                                 tools: %i[bold italic link],
                                 support_text: "Supports Markdown for bold, italic, and links." %>

                      <div class="event-settings__vendor-contacts">
                        <%= render "events/settings/vendor_contact_details", vendor: %>
                      </div>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            <% else %>
              <p class="event-settings__empty">No vendors yet. Use the form below to add your first partner.</p>
            <% end %>

            <div class="event-settings__new-link">
              <h3>Add Vendor</h3>
              <%= form_with model: [@event, @event_vendor], local: true, html: { class: "event-settings__form" } do |form| %>
                <%= hidden_field_tag :return_to, request.fullpath %>
                <div class="event-settings__field-group">
                  <div class="event-settings__field"
                       data-controller="remote-options"
                       data-remote-options-url-value="<%= event_vendor_options_path(@event) %>">
                    <%= form.hidden_field :global_vendor_id, data: { remote_options_target: "hidden" } %>
                    <%= form.label :name, "Vendor name" %>
                    <%= form.text_field :name,
                                        required: true,
                                        autocomplete: "off",
                                        data: { remote_options_target: "input" } %>
                    <p class="event-settings__hint">Choose a global vendor from the suggestions, or use the explicit create action below.</p>
                  </div>
                  <div class="event-settings__field">
                    <%= form.label :vendor_type, "Vendor type" %>
                    <%= form.text_field :vendor_type, placeholder: "Catering" %>
                  </div>
                  <div class="event-settings__field event-settings__field--checkbox">
                    <label class="event-settings__toggle">
                      <%= form.check_box :client_visible %>
                      <span>Visible to clients</span>
                    </label>
                  </div>
                </div>

                <div class="event-settings__vendor-contacts">
                  <div class="event-settings__contacts">
                    <p class="event-settings__hint">Contacts come from the selected global vendor and can be viewed after the vendor is added.</p>
                  </div>
                </div>

                <%= render "events/settings/markdown_field",
                           form:,
                           field_name: :team_meals,
                           label_text: "Team Meals",
                           rows: 3,
                           placeholder: "Note vendor-provided meals, counts, timing, pickup details, or links.",
                           hint_text: "Use this for event-specific team meal notes.",
                           tools: %i[bold italic link],
                           support_text: "Supports Markdown for bold, italic, and links." %>

                <div class="event-settings__form-actions">
                  <%= form.submit "Add selected vendor" %>
                  <%= button_tag "Create globally and add",
                                 type: "submit",
                                 name: "event_vendor[create_global_vendor]",
                                 value: "1",
                                 data: { turbo_confirm: "Create this vendor in the global library and add it to this event?" } %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
<% end %>
