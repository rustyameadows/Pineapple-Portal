<div class="event-settings__contacts">
  <div class="event-settings__vendor-contact-heading">
    <div>
      <h4 class="event-settings__contact-title">Event contacts</h4>
      <p class="event-settings__hint">Choose the people from this vendor who are contacts for this event.</p>
    </div>
    <% if vendor.global_vendor && admin_user? %>
      <%= link_to "Edit global contacts",
                  edit_settings_global_vendor_path(vendor.global_vendor),
                  class: "event-section__link" %>
    <% end %>
  </div>

  <% if vendor.global_vendor.contacts.any? %>
    <%= hidden_field_tag "event_vendor[global_vendor_contact_ids][]", "" %>
    <% selected_contact_ids = vendor.event_vendor_contacts.map(&:global_vendor_contact_id) %>
    <% vendor.global_vendor.contacts.each do |contact| %>
      <label class="event-settings__contact event-settings__contact--selectable">
        <span class="event-settings__contact-selection">
          <%= check_box_tag "event_vendor[global_vendor_contact_ids][]",
                            contact.id,
                            selected_contact_ids.include?(contact.id),
                            id: "event_vendor_#{vendor.id}_global_vendor_contact_#{contact.id}" %>
          <strong><%= contact.name.presence || contact.title.presence || "Contact" %></strong>
        </span>
        <dl class="event-settings__contact-details">
          <% if contact.title.present? && contact.title != contact.name %>
            <div>
              <dt>Title</dt>
              <dd><%= contact.title %></dd>
            </div>
          <% end %>
          <% if contact.email.present? %>
            <div>
              <dt>Email</dt>
              <dd><%= contact.email %></dd>
            </div>
          <% end %>
          <% if contact.phone.present? %>
            <div>
              <dt>Phone</dt>
              <dd><%= contact.phone %></dd>
            </div>
          <% end %>
          <% if contact.notes.present? %>
            <div class="event-settings__contact-details-notes">
              <dt>Notes</dt>
              <dd><%= contact.notes %></dd>
            </div>
          <% end %>
        </dl>
      </label>
    <% end %>
  <% else %>
    <p class="event-settings__empty">No contacts are recorded on this vendor's global profile. Add contacts globally before selecting them for this event.</p>
  <% end %>
</div>
