<div class="event-settings__contacts">
  <div class="event-settings__vendor-contact-heading">
    <div>
      <h4 class="event-settings__contact-title">Contacts</h4>
      <p class="event-settings__hint">Contacts are inherited from the global vendor and are read-only for this event.</p>
    </div>
    <% if vendor.global_vendor && admin_user? %>
      <%= link_to "Edit global contacts",
                  edit_settings_global_vendor_path(vendor.global_vendor),
                  class: "event-section__link" %>
    <% end %>
  </div>

  <% if vendor.contacts.any? %>
    <% vendor.contacts.each do |contact| %>
      <% contact = contact.to_h.stringify_keys %>
      <div class="event-settings__contact">
        <h5 class="event-settings__contact-title"><%= contact["name"].presence || contact["title"].presence || "Contact" %></h5>
        <dl class="event-settings__contact-details">
          <% if contact["title"].present? && contact["title"] != contact["name"] %>
            <div>
              <dt>Title</dt>
              <dd><%= contact["title"] %></dd>
            </div>
          <% end %>
          <% if contact["email"].present? %>
            <div>
              <dt>Email</dt>
              <dd><%= contact["email"] %></dd>
            </div>
          <% end %>
          <% if contact["phone"].present? %>
            <div>
              <dt>Phone</dt>
              <dd><%= contact["phone"] %></dd>
            </div>
          <% end %>
          <% if contact["notes"].present? %>
            <div class="event-settings__contact-details-notes">
              <dt>Notes</dt>
              <dd><%= contact["notes"] %></dd>
            </div>
          <% end %>
        </dl>
      </div>
    <% end %>
  <% else %>
    <p class="event-settings__empty">No contacts are recorded on this vendor's global profile.</p>
  <% end %>
</div>
