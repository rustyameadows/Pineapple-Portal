<dialog id="event-vendor-<%= vendor.id %>-dialog"
        class="event-settings__vendor-dialog event-settings__vendor-dialog--association event-settings__vendor-dialog--sectioned"
        aria-labelledby="event-vendor-<%= vendor.id %>-dialog-title"
        data-event-vendor-dialog-target="dialog"
        data-action="cancel->event-vendor-dialog#handleCancel click->event-vendor-dialog#handleBackdropClose">
  <div class="event-settings__vendor-dialog-panel">
    <%= form_with model: [event, vendor], local: true, html: { class: "event-settings__form event-settings__vendor-dialog-form" } do |form| %>
      <%= hidden_field_tag :return_to, request.fullpath %>

      <header class="event-settings__vendor-dialog-header">
        <div class="event-settings__vendor-dialog-heading">
          <p class="event-section__eyebrow">Event Vendor</p>
          <h3 id="event-vendor-<%= vendor.id %>-dialog-title"><%= vendor.global_vendor.name %></h3>
          <div class="event-settings__vendor-dialog-header-meta">
            <span>Settings for this event</span>
            <% if vendor.global_vendor.default_social_handle.present? %>
              <span><%= vendor.global_vendor.default_social_handle %></span>
            <% end %>
          </div>
        </div>
        <button type="button"
                class="event-settings__vendor-dialog-close"
                aria-label="Close vendor editor"
                data-action="event-vendor-dialog#close">
          Close
        </button>
      </header>

      <div class="event-settings__vendor-dialog-body">
        <section class="event-settings__vendor-dialog-section" aria-labelledby="event-vendor-<%= vendor.id %>-details-heading">
          <div class="event-settings__vendor-dialog-section-header">
            <div>
              <h4 id="event-vendor-<%= vendor.id %>-details-heading" class="event-settings__vendor-dialog-section-title">Event details</h4>
            </div>
          </div>

          <div class="event-settings__vendor-dialog-grid event-settings__vendor-dialog-grid--details">
            <div class="event-settings__field">
              <%= form.label :vendor_type, "Vendor services" %>
              <%= form.text_field :vendor_type, placeholder: vendor.global_vendor.default_vendor_type.presence || "Floral, Lighting, etc." %>
            </div>
            <div class="event-settings__field event-settings__vendor-dialog-visibility">
              <span class="event-settings__field-label">Client visibility</span>
              <label class="event-settings__vendor-dialog-toggle">
                <%= form.check_box :client_visible %>
                <span>
                  <strong>Visible to clients</strong>
                  <small>Include this vendor in client-facing event details.</small>
                </span>
              </label>
            </div>
          </div>
        </section>

        <section class="event-settings__vendor-dialog-section" aria-labelledby="event-vendor-<%= vendor.id %>-meals-heading">
          <div class="event-settings__vendor-dialog-section-header">
            <div>
              <h4 id="event-vendor-<%= vendor.id %>-meals-heading" class="event-settings__vendor-dialog-section-title">Meal notes</h4>
            </div>
          </div>

          <div class="event-settings__field event-settings__field--notes">
            <%= form.label :team_meals, "Meal notes", class: "visually-hidden" %>
            <%= form.text_area :team_meals,
                               rows: 4,
                               class: "event-settings__textarea event-settings__vendor-dialog-meals",
                               placeholder: "Meal counts, timing, pickup details, or links." %>
          </div>
        </section>

        <%= render "events/settings/vendor_contact_selection", vendor: %>
      </div>

      <footer class="event-settings__vendor-dialog-footer event-settings__vendor-dialog-footer--vendor">
        <div class="event-settings__vendor-dialog-secondary-actions">
          <% if index.positive? || index < vendors.length - 1 %>
            <div class="event-settings__vendor-dialog-order-actions">
              <span class="event-settings__vendor-dialog-footer-label">Order</span>
              <% if index.positive? %>
                <%= link_to "Move up",
                            move_up_event_event_vendor_path(event, vendor, return_to: request.fullpath),
                            data: { turbo_method: :patch },
                            class: "event-settings__control" %>
              <% end %>
              <% if index < vendors.length - 1 %>
                <%= link_to "Move down",
                            move_down_event_event_vendor_path(event, vendor, return_to: request.fullpath),
                            data: { turbo_method: :patch },
                            class: "event-settings__control" %>
              <% end %>
            </div>
          <% end %>
          <%= link_to "Remove vendor",
                      event_event_vendor_path(event, vendor, return_to: request.fullpath),
                      data: { turbo_method: :delete, turbo_confirm: "Remove this vendor?" },
                      class: "event-settings__control event-settings__control--danger event-settings__vendor-dialog-remove" %>
        </div>
        <div class="event-settings__vendor-dialog-primary-actions">
          <button type="button"
                  class="button button--small button--ghost"
                  data-action="event-vendor-dialog#close">
            Cancel
          </button>
          <%= form.submit "Save vendor", class: "button button--small" %>
        </div>
      </footer>
    <% end %>
  </div>
</dialog>
