<% provide :page_shell do %>
  <div class="event-layout">
    <%= render "events/sidebar_navigation", event: @event %>

    <div class="event-layout__main">
      <%= render "shared/flash" %>

      <section class="event-section event-payments event-payments--new">
        <header class="event-section__header">
          <div>
            <p class="event-section__eyebrow">Payments</p>
            <h1 class="event-section__title">New Payment</h1>
            <p class="event-section__subtitle">Create a payment schedule item and configure when and how it appears in the client portal.</p>
          </div>
        </header>

        <%= render "form", payment: @payment %>
      </section>
    </div>
  </div>
<% end %>
