<% items ||= [] %>
<% calendar ||= nil %>
<% group_by_date = !!group_by_date %>
<% segment_granularity = local_assigns[:segment_granularity].presence || EventCalendarView::SEGMENT_GRANULARITIES[:day] %>
<% monthly_segments = segment_granularity.to_s == EventCalendarView::SEGMENT_GRANULARITIES[:month] %>
<% group_label_proc = local_assigns[:group_label_proc] %>
<% schedule_label_proc = local_assigns[:schedule_label_proc] %>
<% show_tags = true if local_assigns[:show_tags].nil? %>
<% show_relative = !!local_assigns[:show_relative] %>
<% show_status_first = !!local_assigns[:show_status_first] %>
<% show_edit_button = !!local_assigns[:show_edit_button] %>
<% bulk_edit = !!local_assigns[:bulk_edit] %>
<% show_timing_actions = !!local_assigns[:show_timing_actions] %>
<% render_actions = local_assigns[:render_actions] %>
<% actions_header = local_assigns[:actions_header] || "" %>
<% item_link_proc = local_assigns[:item_link_proc] || ->(item) { [item.title, edit_event_calendar_item_path(calendar.event, item, return_to: request.fullpath)] } %>
<% bulk_form_id = local_assigns[:bulk_form_id] || "calendar-bulk-edit-form" %>
<% bulk_form_url = local_assigns[:bulk_form_url] || bulk_update_event_calendar_items_path(calendar.event) %>
<% bulk_return_to = local_assigns[:bulk_return_to] || request.fullpath %>
<% filter_source_items = Array(local_assigns[:filter_source_items] || items) %>
<% bulk_team_members = calendar.event.team_members.where.not(role: User::ROLES[:client]).order(:name) %>
<% base_column_count = show_relative ? 3 : 5 %>
<% base_column_count += 1 if show_status_first %>
<% initial_select_all_label = "Select all #{items.count} item#{'s' unless items.count == 1}" %>
<% bulk_action_options = [
     ["Choose action", ""],
     ["Add tags", "add_tags"],
     ["Remove tags", "remove_tags"],
     ["Set vendor", "set_vendor"],
     ["Clear vendor", "clear_vendor"],
     ["Set location", "set_location"],
     ["Clear location", "clear_location"],
     ["Set time label", "set_time_label"],
     ["Clear time label", "clear_time_label"],
     ["Add PP members", "add_team_members"],
     ["Remove PP members", "remove_team_members"],
     ["Set other people", "set_additional_team_members"],
     ["Clear other people", "clear_additional_team_members"],
     ["Delete items", "delete_items"]
   ] %>
<% filter_definitions = {
     vendor: { label: "Vendor", param: "vendors[]", options: calendar_filter_options(filter_source_items, :vendor) },
     location: { label: "Location", param: "locations[]", options: calendar_filter_options(filter_source_items, :location) },
     team: { label: "Team", param: "teams[]", options: calendar_filter_options(filter_source_items, :team) },
     tag: { label: "Tags", param: "tags[]", options: calendar_tag_filter_options(calendar) }
   } %>

<div class="event-calendars__table-shell <%= 'event-calendars__table-shell--bulk' if bulk_edit %>"<%= ' data-calendar-bulk-edit-target="tableShell" id="calendar-bulk-edit-table"'.html_safe if bulk_edit %>>
  <% if bulk_edit %>
    <div class="event-calendars__filter-bar">
      <div class="event-calendars__filter-section event-calendars__filter-section--search">
        <label class="event-calendars__filter-section-label event-calendars__filter-search-label" for="<%= "#{bulk_form_id}-search" %>">Search</label>
        <div class="event-calendars__filter-search">
          <input id="<%= "#{bulk_form_id}-search" %>"
                 type="search"
                 name="q"
                 class="event-calendars__filter-search-input"
                 placeholder="Search title, vendor, location, notes, team"
                 autocomplete="off"
                 aria-label="Search timeline"
                 data-action="input->calendar-bulk-edit#filtersChanged"
                 data-calendar-bulk-edit-target="searchInput">
        </div>
      </div>

      <div class="event-calendars__filter-section event-calendars__filter-section--filters">
        <p class="event-calendars__filter-section-label">Filters</p>
        <div class="event-calendars__filter-groups">
          <% filter_definitions.each do |facet_name, facet| %>
            <details class="event-calendars__filter-dropdown"
                     data-calendar-bulk-edit-target="filterDropdown"
                     data-action="toggle->calendar-bulk-edit#dropdownToggled">
              <summary class="event-calendars__filter-summary">
                <span class="event-calendars__filter-summary-label"><%= facet[:label] %></span>
                <span class="event-calendars__filter-summary-values"
                      data-calendar-bulk-edit-target="facetSummary"
                      data-facet-summary="<%= facet_name %>">
                  <span class="event-calendars__filter-pill event-calendars__filter-pill--muted">All</span>
                </span>
              </summary>

              <div class="event-calendars__filter-menu">
                <% facet[:options].each do |option| %>
                  <% field_token = option[:value] == calendar_filter_none_value ? "none" : option[:value].parameterize %>
                  <% field_id = "#{bulk_form_id}-#{facet_name}-#{field_token}" %>
                  <label class="event-calendars__filter-option" for="<%= field_id %>">
                    <%= check_box_tag facet[:param],
                                      option[:value],
                                      false,
                                      id: field_id,
                                      data: {
                                        action: "change->calendar-bulk-edit#filtersChanged",
                                        calendar_bulk_edit_target: "filterCheckbox",
                                        filter_facet: facet_name,
                                        filter_label: option[:label],
                                        filter_param: facet[:param]
                                      } %>
                    <span><%= option[:label] %></span>
                  </label>
                <% end %>
              </div>
            </details>
          <% end %>
        </div>
      </div>

      <div class="event-calendars__filter-section event-calendars__filter-section--controls">
        <p class="event-calendars__filter-section-label">Controls</p>
        <div class="event-calendars__filter-actions">
          <button type="button"
                  class="event-calendars__bulk-button event-calendars__bulk-button--secondary"
                  data-action="calendar-bulk-edit#clearFilters"
                  data-calendar-bulk-edit-target="clearFiltersButton">
            Clear search/filters
          </button>
          <button type="button"
                  class="event-calendars__bulk-button event-calendars__bulk-button--secondary"
                  data-action="calendar-bulk-edit#toggleVisibleSelection"
                  data-calendar-bulk-edit-target="visibleSelectionButton">
            <%= initial_select_all_label %>
          </button>
        </div>
      </div>
    </div>

    <div class="event-calendars__bulk-toolbar" data-calendar-bulk-edit-target="panel" hidden>
      <%= form_with url: bulk_form_url,
                    method: :patch,
                    scope: :bulk,
                    local: true,
                    html: {
                      id: bulk_form_id,
                      class: "event-calendars__bulk-form",
                      data: {
                        action: "submit->calendar-bulk-edit#prepareSubmit",
                        calendar_bulk_edit_target: "form"
                      }
                    } do |form| %>
        <%= hidden_field_tag :return_to,
                             bulk_return_to,
                             data: { calendar_bulk_edit_target: "returnToInput" } %>

        <div class="event-calendars__bulk-count">
          <strong><span data-calendar-bulk-edit-target="selectionCount">0</span></strong>
          <span>selected</span>
        </div>

        <div class="event-calendars__bulk-shortcuts" aria-label="Bulk selection shortcuts">
          <button type="button"
                  class="event-calendars__bulk-button event-calendars__bulk-button--secondary"
                  data-action="calendar-bulk-edit#toggleVisibleSelection"
                  data-calendar-bulk-edit-target="visibleSelectionButton">
            <%= initial_select_all_label %>
          </button>
          <button type="button"
                  class="event-calendars__bulk-button event-calendars__bulk-button--secondary"
                  data-action="calendar-bulk-edit#clearSelection">
            Deselect all
          </button>
          <% if show_timing_actions %>
            <button type="button"
                    class="event-calendars__bulk-button event-calendars__bulk-button--secondary"
                    data-action="calendar-bulk-edit#openRelativeTimingDialog"
                    data-calendar-bulk-edit-target="relativeTimingButton"
                    hidden>
              Change relative timing
            </button>
            <button type="button"
                    class="event-calendars__bulk-button event-calendars__bulk-button--secondary"
                    data-action="calendar-bulk-edit#openAbsoluteTimingDialog"
                    data-calendar-bulk-edit-target="absoluteTimingButton"
                    hidden>
              Make absolute
            </button>
          <% end %>
        </div>

        <div class="event-calendars__bulk-control">
          <%= form.select :bulk_action,
                          options_for_select(bulk_action_options),
                          {},
                          class: "event-form__select event-calendars__bulk-select",
                          aria: { label: "Bulk action" },
                          data: {
                            action: "change->calendar-bulk-edit#actionChanged",
                            calendar_bulk_edit_target: "actionSelect"
                          } %>
        </div>

        <div class="event-calendars__bulk-field event-calendars__bulk-field--tags"
             data-calendar-bulk-edit-target="tagsRow"
             hidden>
          <%= hidden_field_tag "bulk[tag_ids][]", "", id: nil %>
          <div class="event-calendars__bulk-tag-list" role="group" aria-label="Tags">
            <% calendar.event_calendar_tags.order(:position, :name).each do |tag| %>
              <% field_id = "bulk_tag_#{tag.id}" %>
              <label class="calendar-item-form__pill calendar-item-form__pill--tag" style="<%= calendar_tag_style(tag) %>">
                <%= check_box_tag "bulk[tag_ids][]", tag.id, false, id: field_id %>
                <span><%= tag.name %></span>
              </label>
            <% end %>
          </div>
        </div>

        <div class="calendar-item-form__autocomplete event-calendars__bulk-field event-calendars__bulk-field--input"
             data-calendar-bulk-edit-target="vendorRow"
             data-controller="custom-select"
             data-custom-select-url-value="<%= event_vendor_options_path(calendar.event) %>"
             data-custom-select-link-url-value="<%= ensure_event_vendor_links_path(calendar.event) %>"
             data-custom-select-link-kind-value="vendor"
             hidden>
          <%= form.text_field :vendor_name,
                              placeholder: "Vendor",
                              autocomplete: "off",
                              aria: { label: "Vendor" },
                              class: "event-calendars__bulk-input",
                              data: {
                                custom_select_target: "input",
                                action: "input->custom-select#search focus->custom-select#search keydown->custom-select#handleInputKeydown"
                              } %>
          <div class="calendar-item-form__autocomplete-menu" data-custom-select-target="menu" role="listbox" hidden></div>
        </div>

        <div class="calendar-item-form__autocomplete event-calendars__bulk-field event-calendars__bulk-field--input"
             data-calendar-bulk-edit-target="locationRow"
             data-controller="custom-select"
             data-custom-select-url-value="<%= event_venue_options_path(calendar.event) %>"
             data-custom-select-link-url-value="<%= ensure_event_venue_links_path(calendar.event) %>"
             data-custom-select-link-kind-value="venue"
             hidden>
          <%= form.text_field :location_name,
                              placeholder: "Location",
                              autocomplete: "off",
                              aria: { label: "Location" },
                              class: "event-calendars__bulk-input",
                              data: {
                                custom_select_target: "input",
                                action: "input->custom-select#search focus->custom-select#search keydown->custom-select#handleInputKeydown"
                              } %>
          <div class="calendar-item-form__autocomplete-menu" data-custom-select-target="menu" role="listbox" hidden></div>
        </div>

        <div class="event-calendars__bulk-field event-calendars__bulk-field--input"
             data-calendar-bulk-edit-target="timeLabelRow"
             hidden>
          <%= form.text_field :time_caption,
                              placeholder: "Time label",
                              autocomplete: "off",
                              aria: { label: "Time label" },
                              class: "event-calendars__bulk-input" %>
        </div>

        <div class="event-calendars__bulk-field event-calendars__bulk-field--tags"
             data-calendar-bulk-edit-target="teamMembersRow"
             hidden>
          <%= hidden_field_tag "bulk[team_member_ids][]", "", id: nil %>
          <% if bulk_team_members.any? %>
            <div class="calendar-item-form__pill-list calendar-item-form__pill-list--stack" role="group" aria-label="PP members">
              <% bulk_team_members.each do |member| %>
                <% field_id = "bulk_team_member_#{member.id}" %>
                <label class="calendar-item-form__pill" for="<%= field_id %>">
                  <%= check_box_tag "bulk[team_member_ids][]", member.id, false, id: field_id %>
                  <span><%= member.name %></span>
                </label>
              <% end %>
            </div>
          <% else %>
            <p class="calendar-item-form__help-text">Assign planners from the event team to bulk edit PP members.</p>
          <% end %>
        </div>

        <div class="event-calendars__bulk-field event-calendars__bulk-field--input"
             data-calendar-bulk-edit-target="additionalTeamMembersRow"
             hidden>
          <%= form.text_field :additional_team_members,
                              placeholder: "Other people",
                              autocomplete: "off",
                              aria: { label: "Other people" },
                              class: "event-calendars__bulk-input" %>
        </div>

        <div class="event-calendars__bulk-actions">
          <button type="button"
                  class="event-calendars__bulk-button"
                  data-action="calendar-bulk-edit#confirm"
                  data-calendar-bulk-edit-target="applyButton"
                  disabled>
            Apply
          </button>
        </div>
      <% end %>
    </div>

    <dialog class="event-calendars__bulk-dialog"
            data-calendar-bulk-edit-target="dialog"
            data-action="click->calendar-bulk-edit#backdropClose">
      <div class="event-calendars__bulk-dialog-content">
        <header class="event-calendars__bulk-dialog-header">
          <p class="event-calendars__bulk-eyebrow">Confirm Changes</p>
          <h2 class="event-calendars__bulk-dialog-title">Apply bulk edit?</h2>
          <p class="event-calendars__bulk-dialog-copy">
            This will apply <strong data-calendar-bulk-edit-target="actionLabel">the selected action</strong>
            to <strong><span data-calendar-bulk-edit-target="selectionCount">0</span> item(s)</strong>.
          </p>
        </header>
        <div class="event-calendars__bulk-dialog-actions">
          <button type="button"
                  class="event-section__cta event-section__cta--secondary"
                  data-action="calendar-bulk-edit#closeDialog">
            Cancel
          </button>
          <button type="button"
                  class="event-section__cta"
                  data-action="calendar-bulk-edit#submitConfirmed">
            Confirm changes
          </button>
        </div>
      </div>
    </dialog>

    <% if show_timing_actions %>
      <dialog class="event-calendars__bulk-dialog event-calendars__bulk-dialog--wide"
              data-calendar-bulk-edit-target="relativeTimingDialog"
              data-action="click->calendar-bulk-edit#timingBackdropClose">
        <%= form_with url: event_calendar_timing_conversion_path(calendar.event),
                      method: :post,
                      scope: :timing_conversion,
                      local: true,
                      html: {
                        class: "event-calendars__timing-form",
                        data: {
                          action: "submit->calendar-bulk-edit#prepareTimingSubmit",
                          calendar_bulk_edit_target: "relativeTimingForm",
                          turbo: false
                        }
                      } do |form| %>
          <%= hidden_field_tag :return_to,
                               bulk_return_to,
                               data: { calendar_bulk_edit_target: "timingReturnToInput" } %>
          <%= form.hidden_field :mode, value: "relative", data: { calendar_bulk_edit_target: "timingModeInput" } %>
          <%= form.hidden_field :target_item_id, data: { calendar_bulk_edit_target: "timingTargetInput" } %>
          <%= form.hidden_field :anchor_item_id, data: { calendar_bulk_edit_target: "timingAnchorInput" } %>
          <%= form.hidden_field :anchor_point, value: "", data: { calendar_bulk_edit_target: "timingAnchorPointInput" } %>

          <div class="event-calendars__bulk-dialog-content">
            <header class="event-calendars__bulk-dialog-header">
              <p class="event-calendars__bulk-eyebrow">Timing</p>
              <h2 class="event-calendars__bulk-dialog-title" data-calendar-bulk-edit-target="timingDialogTitle">Change relative timing</h2>
              <p class="event-calendars__bulk-dialog-copy" data-calendar-bulk-edit-target="timingDialogCopy">
                Choose which relationship to save.
              </p>
            </header>

            <div class="event-calendars__timing-fields" data-calendar-bulk-edit-target="relativeTimingFields">
              <div class="event-calendars__timing-options" data-calendar-bulk-edit-target="relativeTimingOptions">
                <button type="button"
                        class="event-calendars__timing-option"
                        data-calendar-bulk-edit-target="relativeTimingOption"
                        data-action="calendar-bulk-edit#selectRelativeTimingOption"
                        data-timing-option-index="0"></button>
                <button type="button"
                        class="event-calendars__timing-option"
                        data-calendar-bulk-edit-target="relativeTimingOption"
                        data-action="calendar-bulk-edit#selectRelativeTimingOption"
                        data-timing-option-index="1"></button>
              </div>
              <div class="event-calendars__timing-anchor-options" data-calendar-bulk-edit-target="relativeAnchorPointOptions">
                <button type="button"
                        class="event-calendars__timing-anchor-option"
                        data-calendar-bulk-edit-target="relativeAnchorPointOption"
                        data-action="calendar-bulk-edit#selectRelativeAnchorPoint"
                        data-timing-anchor-point="start"></button>
                <button type="button"
                        class="event-calendars__timing-anchor-option"
                        data-calendar-bulk-edit-target="relativeAnchorPointOption"
                        data-action="calendar-bulk-edit#selectRelativeAnchorPoint"
                        data-timing-anchor-point="end"></button>
              </div>
            </div>

            <div class="event-calendars__timing-fields event-calendars__timing-fields--absolute"
                 data-calendar-bulk-edit-target="absoluteTimingFields"
                 hidden>
              <p class="event-calendars__timing-summary" data-calendar-bulk-edit-target="absoluteTimingSummary"></p>
            </div>

            <div class="event-calendars__bulk-dialog-actions">
              <button type="button"
                      class="event-section__cta event-section__cta--secondary"
                      data-action="calendar-bulk-edit#closeTimingDialog">
                Cancel
              </button>
              <button type="submit"
                      class="event-section__cta"
                      data-calendar-bulk-edit-target="timingSubmitButton">
                Save timing
              </button>
            </div>
          </div>
        <% end %>
      </dialog>
    <% end %>
  <% end %>

  <table class="event-table event-calendars__table">
    <thead>
      <tr>
        <% if show_status_first %>
          <th class="event-calendars__status-column">Status</th>
        <% end %>
        <th class="event-calendars__schedule-column">Schedule</th>
        <th class="event-calendars__title-column">Title</th>
        <% if show_relative %>
          <th>Relation</th>
        <% else %>
          <th>Vendor</th>
          <th>Location</th>
          <th>Team</th>
        <% end %>
        <% if show_tags %>
          <th>Tags</th>
        <% end %>
        <% if show_edit_button %>
          <th class="event-calendars__actions-column"></th>
        <% end %>
        <% if render_actions %>
          <th><%= actions_header %></th>
        <% end %>
        <% if bulk_edit %>
          <th class="event-calendars__bulk-select-column">Select</th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% current_bucket = nil %>
      <% items.each do |item| %>
        <% bucket_key = calendar_item_segment_key(item, calendar.timezone, segment_granularity) %>
        <% bucket_label = group_label_proc ? group_label_proc.call(item) : calendar_item_segment_label(item, calendar.timezone, segment_granularity) %>
        <% if group_by_date && bucket_key != current_bucket %>
          <% current_bucket = bucket_key %>
          <tr class="event-calendars__date-row"
              data-calendar-bulk-edit-target="groupRow"
              data-calendar-group-key="<%= bucket_key %>">
            <td colspan="<%= base_column_count + (show_tags ? 1 : 0) + (show_edit_button ? 1 : 0) + (render_actions ? 1 : 0) + (bulk_edit ? 1 : 0) %>">
              <div class="event-calendars__date-row-content">
                <span class="event-calendars__date-label"><%= bucket_label %></span>
                <% if bulk_edit %>
                  <div class="event-calendars__date-actions" aria-label="<%= "#{bucket_label} selection controls" %>">
                    <button type="button"
                            class="event-calendars__group-selection-button"
                            data-action="calendar-bulk-edit#selectGroup"
                            data-group-key="<%= bucket_key %>"
                            data-group-selection-action="select"
                            aria-label="Select all visible items in <%= bucket_label %>">
                      Select
                    </button>
                    <button type="button"
                            class="event-calendars__group-selection-button"
                            data-action="calendar-bulk-edit#deselectGroup"
                            data-group-key="<%= bucket_key %>"
                            data-group-selection-action="deselect"
                            aria-label="Deselect all visible items in <%= bucket_label %>">
                      Deselect
                    </button>
                  </div>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>

        <% timeline_row_id = dom_id(item, :timeline_row) %>
        <% title_text, title_path = item_link_proc.call(item) %>
        <% title_base_path = title_path.to_s.split("?").first %>
        <% team_label = calendar_item_team_label(item) %>
        <tr id="<%= timeline_row_id %>"
            class="event-calendars__row <%= calendar_item_row_classes(item) %>"
            data-calendar-bulk-edit-target="row"
            data-calendar-item-id="<%= item.id %>"
            data-calendar-item-title="<%= item.title %>"
            data-calendar-item-start-at="<%= item.effective_starts_at&.iso8601 %>"
            data-calendar-item-end-at="<%= item.effective_ends_at&.iso8601 %>"
            data-calendar-item-relative="<%= item.relative? %>"
            data-calendar-search-text="<%= calendar_item_search_text(item) %>"
            data-calendar-vendor-values="<%= calendar_item_filter_values_json(item, :vendor) %>"
            data-calendar-location-values="<%= calendar_item_filter_values_json(item, :location) %>"
            data-calendar-team-values="<%= calendar_item_filter_values_json(item, :team) %>"
            data-calendar-tag-values="<%= calendar_item_filter_values_json(item, :tag) %>"
            data-calendar-group-key="<%= group_by_date ? bucket_key : '' %>">
          <% tooltip = calendar_item_relative_tooltip(item) %>
          <% if show_status_first %>
            <td class="event-calendars__status-value"><%= calendar_item_status_label(item) %></td>
          <% end %>
          <% schedule_label = if schedule_label_proc
                                schedule_label_proc.call(item)
                              elsif monthly_segments
                                calendar_item_day_label_with_marker(item, calendar.timezone)
                              else
                                calendar_item_time_only_label_with_marker(item, calendar.timezone)
                              end %>
          <td class="event-calendars__schedule-column" title="<%= tooltip.to_s %>"><%= schedule_label %></td>
          <td class="event-calendars__title-column">
            <%= link_to title_text,
                        title_path,
                        class: "event-calendars__title-link",
                        data: {
                          calendar_bulk_edit_target: [("returnLink" if bulk_edit), "searchableText"].compact.join(" "),
                          base_path: (title_base_path if bulk_edit),
                          row_id: (timeline_row_id if bulk_edit)
                        }.compact %>
            <% if item.notes.present? %>
              <div class="event-calendars__note-group" data-calendar-bulk-edit-target="searchableText">
                <%= simple_format(item.notes, class: "event-calendars__note") %>
              </div>
            <% end %>
          </td>
          <% if show_relative %>
            <td><%= calendar_item_relative_label(item) || "—" %></td>
          <% else %>
            <td data-calendar-bulk-edit-target="searchableText"><%= item.vendor_name.presence || "—" %></td>
            <td data-calendar-bulk-edit-target="searchableText"><%= item.location_name.presence || "—" %></td>
            <td data-calendar-bulk-edit-target="searchableText">
              <%= team_label %>
            </td>
          <% end %>
          <% if show_tags %>
            <td>
              <% if item.event_calendar_tags.any? %>
                <div class="event-tag-list">
                  <% item.event_calendar_tags.each do |tag| %>
                    <span class="event-tag-pill" style="<%= calendar_tag_style(tag) %>"><%= tag.name %></span>
                  <% end %>
                </div>
              <% else %>
                <span class="event-table__status">None</span>
              <% end %>
            </td>
          <% end %>
          <% if show_edit_button %>
            <td class="event-calendars__row-action">
              <%= link_to "Edit",
                          edit_event_calendar_item_path(calendar.event, item, return_to: "#{request.fullpath}##{timeline_row_id}"),
                          class: "event-calendars__edit-link",
                          data: (bulk_edit ? {
                            calendar_bulk_edit_target: "returnLink",
                            base_path: edit_event_calendar_item_path(calendar.event, item),
                            row_id: timeline_row_id
                          } : {}) %>
            </td>
          <% end %>
          <% if render_actions %>
            <td class="event-settings__milestone-row-actions"><%= render_actions.call(item) %></td>
          <% end %>
          <% if bulk_edit %>
            <td class="event-calendars__bulk-select-cell">
              <%= check_box_tag "item_ids[]",
                                item.id,
                                false,
                                form: bulk_form_id,
                                class: "event-calendars__bulk-checkbox",
                                data: {
                                  action: "change->calendar-bulk-edit#selectionChanged",
                                  calendar_bulk_edit_target: "checkbox"
                                } %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>

  <% if bulk_edit %>
    <div class="event-calendars__filtered-empty" data-calendar-bulk-edit-target="filteredEmpty" hidden>
      <p>No items match the current search or filters.</p>
    </div>
  <% end %>
</div>
