<% form_url = view.persisted? ? event_calendar_view_path(@event, view) : event_calendar_views_path(@event) %>
<% selected_tag_ids = Array(view.tag_filter).map(&:to_i) %>
<% delete_form_id = "calendar-view-delete-form-#{view.id}" if view.persisted? %>
<%= form_with model: view, url: form_url, class: "event-form calendar-view-form", method: (view.persisted? ? :patch : :post) do |form| %>
  <% if view.errors.any? %>
    <div class="event-form__errors">
      <p><strong><%= pluralize(view.errors.count, "error") %> prevented this view from being saved:</strong></p>
      <ul>
        <% view.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="calendar-view-form__panel">
    <div class="event-form__group">
      <%= form.label :name %>
      <%= form.text_field :name, required: true %>
    </div>
  </div>

  <div class="calendar-view-form__panel">
    <div class="calendar-view-form__section-header">
      <p class="calendar-view-form__eyebrow">Timeline Segments</p>
    </div>

    <div class="calendar-view-form__choice-grid" role="radiogroup" aria-label="Timeline segments">
      <label class="calendar-view-form__choice-card">
        <%= form.radio_button :segment_granularity, EventCalendarView::SEGMENT_GRANULARITIES[:day] %>
        <span class="calendar-view-form__choice-copy">
          <span class="calendar-view-form__choice-title">Daily segments</span>
          <span class="calendar-view-form__choice-detail">Group rows by calendar day</span>
        </span>
      </label>

      <label class="calendar-view-form__choice-card">
        <%= form.radio_button :segment_granularity, EventCalendarView::SEGMENT_GRANULARITIES[:month] %>
        <span class="calendar-view-form__choice-copy">
          <span class="calendar-view-form__choice-title">Monthly segments</span>
          <span class="calendar-view-form__choice-detail">Group rows by month</span>
        </span>
      </label>
    </div>
  </div>

  <div class="calendar-view-form__panel">
    <div class="calendar-view-form__section-header">
      <p class="calendar-view-form__eyebrow">Included Tags</p>
    </div>

    <% if @tags.any? %>
      <div class="calendar-item-form__pill-list">
        <% @tags.each do |tag| %>
          <% field_id = "calendar_view_tag_#{tag.id}" %>
          <label class="calendar-item-form__pill calendar-item-form__pill--tag" for="<%= field_id %>" style="<%= calendar_tag_style(tag) %>">
            <%= check_box_tag "event_calendar_view[tag_filter][]", tag.id, selected_tag_ids.include?(tag.id), id: field_id %>
            <span><%= tag.name %></span>
          </label>
        <% end %>
      </div>
      <%= hidden_field_tag "event_calendar_view[tag_filter][]", "" %>
    <% else %>
      <p class="event-section__note">No tags yet. Create tags on the run of show page.</p>
    <% end %>
  </div>

  <div class="calendar-view-form__panel">
    <div class="calendar-view-form__section-header">
      <p class="calendar-view-form__eyebrow">Options</p>
    </div>

    <div class="calendar-view-form__choice-grid">
      <label class="calendar-view-form__choice-card">
        <%= form.check_box :client_visible %>
        <span class="calendar-view-form__choice-copy">
          <span class="calendar-view-form__choice-title">Visible on client portal</span>
          <span class="calendar-view-form__choice-detail">Clients can open this view</span>
        </span>
      </label>
    </div>
  </div>

  <div class="event-form__actions calendar-item-form__actions calendar-view-form__actions">
    <% if view.persisted? %>
      <div class="calendar-item-form__actions-left">
        <%= button_tag "Delete Derived Calendar",
                       type: "submit",
                       form: delete_form_id,
                       class: "event-form__submit event-form__submit--danger" %>
      </div>
    <% else %>
      <div></div>
    <% end %>
    <div class="calendar-item-form__actions-right">
      <%= link_to "Cancel", event_calendar_path(@event), class: "event-form__cancel" %>
      <%= form.submit class: "event-form__submit" %>
    </div>
  </div>
<% end %>

<% if view.persisted? %>
  <%= form_with url: event_calendar_view_path(@event, view),
                method: :delete,
                id: delete_form_id,
                data: { turbo_confirm: "Remove this derived calendar?" } do %>
  <% end %>
<% end %>
