<% return_to = params[:return_to].presence %>
<% form_url = item.persisted? ? event_calendar_item_path(@event, item) : event_calendar_items_path(@event) %>
<% has_dependent_items = local_assigns.fetch(:has_dependent_items, false) %>
<% delete_form_id = "calendar-item-delete-form-#{item.id}" if item.persisted? %>
<%= form_with model: item,
              url: form_url,
              class: "event-form calendar-item-form",
              method: (item.persisted? ? :patch : :post),
              data: { turbo: false } do |form| %>
  <%= hidden_field_tag :return_to, return_to if return_to.present? %>
  <% if item.errors.any? %>
    <div class="event-form__errors">
      <p><strong><%= pluralize(item.errors.count, "error") %> prevented this item from being saved:</strong></p>
      <ul>
        <% item.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="calendar-item-form__section">
    <div class="calendar-item-form__section-header">
      <p class="calendar-item-form__eyebrow">Basic Info</p>
      <p class="calendar-item-form__hint"></p>
    </div>
    <div class="calendar-item-form__grid">
      <div class="event-form__group">
        <%= form.label :title %>
        <%= form.text_field :title, required: true %>
      </div>
      <div class="event-form__group">
        <%= form.label :status %>
        <%= form.select :status, CalendarItem.statuses.keys.map { |key| [key.titleize, key] }, {}, class: "event-form__select" %>
      </div>
      <div class="event-form__group calendar-item-form__full">
        <%= form.label :notes %>
        <%= form.text_area :notes, rows: 4 %>
      </div>
      <div class="event-form__group calendar-item-form__full">
        <%= form.label :event_calendar_tag_ids, "Tags" %>
        <% if @available_tags.any? %>
          <div class="calendar-item-form__pill-list">
            <% @available_tags.each do |tag| %>
              <% field_id = "calendar_item_tag_#{tag.id}" %>
              <label class="calendar-item-form__pill calendar-item-form__pill--tag" style="<%= calendar_tag_style(tag) %>">
                <%= check_box_tag "calendar_item[event_calendar_tag_ids][]", tag.id, item.event_calendar_tag_ids.include?(tag.id), id: field_id %>
                <span><%= tag.name %></span>
              </label>
            <% end %>
          </div>
          <%= hidden_field_tag "calendar_item[event_calendar_tag_ids][]", "" %>
        <% else %>
          <p class="calendar-item-form__help-text">No tags yet. Add tags from the calendar overview.</p>
        <% end %>
      </div>
    </div>
  </div>

  <div class="calendar-item-form__section">
    <div class="calendar-item-form__section-header">
      <p class="calendar-item-form__eyebrow">Timing</p>
      <p class="calendar-item-form__hint"></p>
    </div>

    <div class="calendar-item-form__toggle">
      <% timing_mode = item.relative? ? "relative" : "absolute" %>
      <label class="calendar-item-form__toggle-option">
        <%= radio_button_tag "calendar_item[timing_mode]", "absolute", timing_mode == "absolute", data: { timing_toggle_target: "absolute" } %>
        <span>Absolute</span>
      </label>
      <label class="calendar-item-form__toggle-option">
        <%= radio_button_tag "calendar_item[timing_mode]", "relative", timing_mode == "relative", data: { timing_toggle_target: "relative" } %>
        <span>Relative</span>
      </label>
    </div>

    <div class="calendar-item-form__timing-group" data-timing-mode="absolute" style="<%= timing_mode == 'relative' ? 'display:none;' : '' %>">
      <div class="event-form__group calendar-item-form__absolute-field">
        <%= form.label :starts_at, "Date and time" %>
        <div class="calendar-item__datetime calendar-item__datetime--absolute" data-timezone="<%= @calendar.timezone %>">
          <% start_value = item.starts_at&.in_time_zone(@calendar.timezone) || @default_start_time %>
          <% absolute_summary = start_value ? "Exact start: #{start_value.strftime('%b %-d, %Y at %-l:%M %p').strip}" : "Exact start not set." %>
          <div class="calendar-item__time-wrapper calendar-item__time-wrapper--absolute">
            <%= form.datetime_local_field :starts_at,
                  value: start_value&.strftime('%Y-%m-%dT%H:%M'),
                  class: "calendar-item__time-field",
                  data: { absolute_time_input: true } %>
          </div>
          <p class="calendar-item-form__timing-summary" data-absolute-timing-summary><%= absolute_summary %></p>
        </div>
      </div>
    </div>

    <div class="calendar-item-form__timing-group" data-timing-mode="relative" style="<%= timing_mode == 'relative' ? '' : 'display:none;' %>">
      <% offset_value = item.relative_offset_minutes.to_i %>
      <% offset_unit = "minutes" %>
      <% if offset_value.positive? %>
        <% if (offset_value % (60 * 24 * 30)).zero? %>
          <% offset_value = offset_value / (60 * 24 * 30) %>
          <% offset_unit = "months" %>
        <% elsif (offset_value % (60 * 24 * 7)).zero? %>
          <% offset_value = offset_value / (60 * 24 * 7) %>
          <% offset_unit = "weeks" %>
        <% elsif (offset_value % (60 * 24)).zero? %>
          <% offset_value = offset_value / (60 * 24) %>
          <% offset_unit = "days" %>
        <% elsif (offset_value % 60).zero? %>
          <% offset_value = offset_value / 60 %>
          <% offset_unit = "hours" %>
        <% end %>
      <% end %>
      <% offset_unit_label = offset_value.to_f == 1.0 ? offset_unit.singularize : offset_unit %>
      <% relative_direction_label = item.relative_before? ? "before" : "after" %>
      <% relative_anchor_point_label = item.relative_to_anchor_end? ? "ends" : "starts" %>
      <% relative_projected_start = nil %>
      <% if item.relative_anchor.present? %>
        <% anchor_base_time = item.relative_to_anchor_end? ? (item.relative_anchor.effective_ends_at || item.relative_anchor.effective_starts_at) : item.relative_anchor.effective_starts_at %>
        <% if anchor_base_time %>
          <% projected_offset_minutes = item.relative_offset_minutes.to_i %>
          <% projected_offset_minutes *= -1 if item.relative_before? %>
          <% relative_projected_start = anchor_base_time + projected_offset_minutes.minutes %>
        <% end %>
      <% end %>
      <% relative_projected_label = relative_projected_start&.in_time_zone(@calendar.timezone)&.strftime("%b %-d %-l:%M%p")&.sub(/^Sep /, "Sept ") %>
      <% relative_projected_suffix = relative_projected_label.present? ? " → #{relative_projected_label}" : "" %>
      <% relative_summary = if item.relative_anchor.present?
                              if offset_value.to_f.zero?
                                "Starts when #{item.relative_anchor.title} #{relative_anchor_point_label}#{relative_projected_suffix}"
                              else
                                "Starts #{offset_value} #{offset_unit_label} #{relative_direction_label} #{item.relative_anchor.title} #{relative_anchor_point_label}#{relative_projected_suffix}"
                              end
                            else
                              "Choose an anchor to preview relative timing."
                            end %>

      <div class="calendar-item-form__relative-sentence" data-calendar-timezone="<%= @calendar.timezone %>">
        <span class="calendar-item-form__sentence-text">Start this item</span>

        <div class="calendar-item-form__sentence-field calendar-item-form__sentence-field--offset">
          <%= label_tag "calendar_item_relative_offset_value", "Offset", class: "visually-hidden" %>
          <%= number_field_tag "calendar_item[relative_offset_value]",
                               offset_value,
                               min: 0,
                               step: 0.25,
                               class: "calendar-item-form__sentence-control calendar-item-form__sentence-control--number",
                               data: { relative_summary_input: "offsetValue" } %>
        </div>

        <div class="calendar-item-form__sentence-field calendar-item-form__sentence-field--unit">
          <%= label_tag "calendar_item_relative_offset_unit", "Offset unit", class: "visually-hidden" %>
          <%= select_tag "calendar_item[relative_offset_unit]",
                         options_for_select(
                           [
                             ["Minutes", "minutes"],
                             ["Hours", "hours"],
                             ["Days", "days"],
                             ["Weeks", "weeks"],
                             ["Months", "months"]
                           ],
                           offset_unit
                         ),
                         class: "calendar-item-form__sentence-control",
                         data: { relative_summary_input: "offsetUnit" } %>
        </div>

        <div class="calendar-item-form__sentence-field calendar-item-form__sentence-field--direction">
          <%= form.label :relative_before, "Direction", class: "visually-hidden" %>
          <%= form.select :relative_before,
                          [["after", false], ["before", true]],
                          { selected: item.relative_before? },
                          class: "calendar-item-form__sentence-control",
                          data: { relative_summary_input: "direction" } %>
        </div>

        <div class="calendar-item-form__sentence-field calendar-item-form__sentence-field--anchor">
          <%= form.label :relative_anchor_id, "Anchor", class: "visually-hidden" %>
          <%= form.select :relative_anchor_id,
                          options_for_select(@anchor_options, item.relative_anchor_id),
                          { include_blank: "Choose an anchor..." },
                          class: "calendar-item-form__sentence-control calendar-item-form__sentence-control--anchor",
                          data: { relative_summary_input: "anchor" } %>
        </div>

        <div class="calendar-item-form__sentence-field calendar-item-form__sentence-field--reference">
          <%= form.label :relative_to_anchor_end, "Anchor point", class: "visually-hidden" %>
          <%= form.select :relative_to_anchor_end,
                          [["starts", false], ["ends", true]],
                          { selected: item.relative_to_anchor_end? },
                          class: "calendar-item-form__sentence-control",
                          data: { relative_summary_input: "anchorPoint" } %>
        </div>
      </div>

      <p class="calendar-item-form__timing-summary" data-relative-timing-summary><%= relative_summary %></p>
    </div>

    <div class="calendar-item-form__grid">
      <div class="event-form__group">
        <%= form.label :duration_minutes, "Duration" %>
        <div class="calendar-item-form__duration">
          <% duration_value = item.duration_minutes.present? ? item.duration_minutes : nil %>
          <% duration_unit = "minutes" %>
          <% if item.duration_minutes.present? %>
            <% minutes = item.duration_minutes.to_i %>
            <% if (minutes % (60 * 24 * 30)).zero? %>
              <% duration_value = minutes / (60 * 24 * 30) %>
              <% duration_unit = "months" %>
            <% elsif (minutes % (60 * 24 * 7)).zero? %>
              <% duration_value = minutes / (60 * 24 * 7) %>
              <% duration_unit = "weeks" %>
            <% elsif (minutes % (60 * 24)).zero? %>
              <% duration_value = minutes / (60 * 24) %>
              <% duration_unit = "days" %>
            <% elsif (minutes % 60).zero? %>
              <% duration_value = minutes / 60 %>
              <% duration_unit = "hours" %>
            <% end %>
          <% end %>
          <%= number_field_tag "calendar_item[duration_value]",
                               duration_value,
                               min: 0,
                               step: 0.25,
                               class: "calendar-item-form__duration-value" %>
          <%= select_tag "calendar_item[duration_unit]",
                         options_for_select(
                           [
                             ["Minutes", "minutes"],
                             ["Hours", "hours"],
                             ["Days", "days"],
                             ["Weeks", "weeks"],
                             ["Months", "months"]
                           ],
                           duration_unit
                         ),
                         class: "calendar-item-form__duration-unit" %>
        </div>
      </div>
      <div class="event-form__group calendar-item-form__full">
        <%= form.label :time_caption, "Time label (optional)" %>
        <%= form.text_field :time_caption, placeholder: "e.g., Start of day, End of day" %>
        <p class="calendar-item-form__help-text">Overrides the clock time with a label. Leave blank to show the scheduled time.</p>
      </div>
    </div>
  </div>

  <div class="calendar-item-form__section">
    <div class="calendar-item-form__section-header">
      <p class="calendar-item-form__eyebrow">Logistics</p>
      <p class="calendar-item-form__hint"></p>
    </div>
    <div class="calendar-item-form__grid calendar-item-form__grid--logistics">
      <div class="calendar-item-form__stack">
        <div class="event-form__group calendar-item-form__autocomplete"
             data-controller="custom-select"
             data-custom-select-url-value="<%= event_venue_options_path(@event) %>"
             data-custom-select-link-url-value="<%= ensure_event_venue_links_path(@event) %>"
             data-custom-select-link-kind-value="venue">
          <%= form.label :location_name, "Location" %>
          <%= form.text_field :location_name,
                              autocomplete: "off",
                              data: {
                                custom_select_target: "input",
                                action: "input->custom-select#search focus->custom-select#search keydown->custom-select#handleInputKeydown"
                              } %>
          <div class="calendar-item-form__autocomplete-menu" data-custom-select-target="menu" role="listbox" hidden></div>
        </div>
        <div class="event-form__group calendar-item-form__autocomplete"
             data-controller="custom-select"
             data-custom-select-url-value="<%= event_vendor_options_path(@event) %>"
             data-custom-select-link-url-value="<%= ensure_event_vendor_links_path(@event) %>"
             data-custom-select-link-kind-value="vendor">
          <%= form.label :vendor_name, "Vendor" %>
          <%= form.text_field :vendor_name,
                              autocomplete: "off",
                              data: {
                                custom_select_target: "input",
                                action: "input->custom-select#search focus->custom-select#search keydown->custom-select#handleInputKeydown"
                              } %>
          <div class="calendar-item-form__autocomplete-menu" data-custom-select-target="menu" role="listbox" hidden></div>
        </div>
      </div>
      <div class="calendar-item-form__stack">
        <div class="event-form__group">
          <%= form.label :team_member_ids, "Assigned PP members" %>
          <% if @available_team_members.any? %>
            <div class="calendar-item-form__pill-list calendar-item-form__pill-list--stack">
              <% @available_team_members.each do |member| %>
                <% field_id = "calendar_item_team_member_#{member.id}" %>
                <label class="calendar-item-form__pill">
                  <%= check_box_tag "calendar_item[team_member_ids][]", member.id, item.team_member_ids.include?(member.id), id: field_id %>
                  <span><%= member.name %></span>
                </label>
              <% end %>
            </div>
            <%= hidden_field_tag "calendar_item[team_member_ids][]", "" %>
          <% else %>
            <p class="calendar-item-form__help-text">Assign planners from the event team to see them here.</p>
          <% end %>
        </div>
        <div class="event-form__group">
          <%= form.label :additional_team_members, "Other people" %>
          <%= form.text_field :additional_team_members, placeholder: "Add external collaborators" %>
        </div>
        <div class="event-form__group">
          <%= form.label :guest_count, "Guest count" %>
          <%= form.text_field :guest_count, placeholder: "e.g., 150 guests, TBD" %>
        </div>
        <div class="event-form__group">
          <%= form.label :transportation_note, "Transportation details (optional)" %>
          <div class="calendar-item-form__markdown-editor" data-controller="generated-markdown-editor">
            <%= render "events/settings/markdown_toolbar",
                       toolbar_label: "Transportation details formatting",
                       tools: %i[bold italic link] %>

            <%= form.text_area :transportation_note,
                               rows: 4,
                               placeholder: "Add transportation details for packet use",
                               class: "calendar-item-form__markdown-source",
                               data: {
                                 generated_markdown_editor_target: "source",
                                 action: "focus->generated-markdown-editor#rememberSelection click->generated-markdown-editor#rememberSelection keyup->generated-markdown-editor#rememberSelection select->generated-markdown-editor#rememberSelection input->generated-markdown-editor#syncFromSource input->generated-markdown-editor#rememberSelection"
                               } %>
            <div class="calendar-item-form__markdown-footer">
              <p class="calendar-item-form__help-text">Supports Markdown for bold, italic, and links.</p>
              <button type="button"
                      class="button button--tiny button--ghost event-settings__markdown-open"
                      data-generated-markdown-editor-target="openButton"
                      data-action="generated-markdown-editor#open"
                      aria-haspopup="dialog"
                      hidden>
                Open large editor
              </button>
            </div>

            <dialog class="event-settings__markdown-dialog"
                    data-generated-markdown-editor-target="dialog"
                    data-action="cancel->generated-markdown-editor#handleCancel click->generated-markdown-editor#handleBackdropClose">
              <div class="event-settings__markdown-panel">
                <header class="event-settings__markdown-panel-header">
                  <h3>Transportation details</h3>
                </header>
                <div class="event-settings__markdown-panel-body">
                  <%= render "events/settings/markdown_toolbar",
                             toolbar_label: "Transportation details formatting",
                             tools: %i[bold italic link] %>
                  <textarea class="event-settings__markdown-overlay"
                            aria-label="Transportation details markdown editor"
                            data-generated-markdown-editor-target="overlay"
                            data-action="focus->generated-markdown-editor#rememberSelection click->generated-markdown-editor#rememberSelection keyup->generated-markdown-editor#rememberSelection select->generated-markdown-editor#rememberSelection input->generated-markdown-editor#syncFromOverlay input->generated-markdown-editor#rememberSelection"></textarea>
                </div>
                <footer class="event-settings__markdown-panel-actions">
                  <button type="button"
                          class="button button--small"
                          data-action="generated-markdown-editor#close">
                    Done
                  </button>
                </footer>
              </div>
            </dialog>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="event-form__actions calendar-item-form__actions">
    <% if item.persisted? %>
      <div class="calendar-item-form__actions-left">
        <%= button_tag "Delete Item",
                       type: "submit",
                       form: delete_form_id,
                       class: "event-form__submit event-form__submit--danger",
                       data: { impact_delete: true } %>
      </div>
    <% else %>
      <div></div>
    <% end %>
    <div class="calendar-item-form__actions-right">
      <%= link_to "Cancel", return_to || event_calendar_path(@event), class: "event-form__cancel" %>
      <%= form.submit class: "event-form__submit" %>
    </div>
  </div>
<% end %>

<% if item.persisted? %>
  <% delete_form_data = has_dependent_items ? {} : { turbo_confirm: "Remove this calendar item?" } %>
  <%= form_with url: event_calendar_item_path(@event, item),
                method: :delete,
                id: delete_form_id,
                data: delete_form_data do %>
    <%= hidden_field_tag :return_to, return_to if return_to.present? %>
  <% end %>
<% end %>

<script>
  (function() {
    function ready(fn) {
      if (document.readyState !== "loading") {
        fn();
      } else {
        document.addEventListener("DOMContentLoaded", fn);
      }
      document.addEventListener("turbo:load", fn);
    }

    ready(function() {
      var form = document.querySelector(".calendar-item-form");
      if (!form) return;

      var radios = form.querySelectorAll('input[name="calendar_item[timing_mode]"]');
      var absoluteGroup = form.querySelector('[data-timing-mode="absolute"]');
      var relativeGroup = form.querySelector('[data-timing-mode="relative"]');
      var absoluteInput = form.querySelector("[data-absolute-time-input]");
      var absoluteSummary = form.querySelector("[data-absolute-timing-summary]");
      var relativeSummary = form.querySelector("[data-relative-timing-summary]");
      var relativeInputs = form.querySelectorAll("[data-relative-summary-input]");
      var relativeSentence = form.querySelector(".calendar-item-form__relative-sentence");

      function syncTiming() {
        var mode = Array.from(radios).find(function(r) { return r.checked; });
        mode = mode ? mode.value : "absolute";
        if (absoluteGroup) absoluteGroup.style.display = mode === "absolute" ? "" : "none";
        if (relativeGroup) relativeGroup.style.display = mode === "relative" ? "" : "none";
      }

      function selectedText(name) {
        var field = form.querySelector('[data-relative-summary-input="' + name + '"]');
        if (!field || !field.selectedOptions || !field.selectedOptions.length) return "";
        return field.selectedOptions[0].textContent.trim();
      }

      function selectedAnchorTitle() {
        var field = form.querySelector('[data-relative-summary-input="anchor"]');
        if (!field || !field.selectedOptions || !field.selectedOptions.length || !field.value) return "";
        return field.selectedOptions[0].dataset.anchorTitle || field.selectedOptions[0].textContent.replace(/\s+\([^)]*\)\s*$/, "").trim();
      }

      function pluralizedUnit(value, unit) {
        var numericValue = Number(value);
        var singular = unit.replace(/s$/, "");
        return numericValue === 1 ? singular : unit;
      }

      function offsetMinutesFor(value, unit) {
        var numericValue = Number(value || 0);
        if (!Number.isFinite(numericValue)) return null;

        var multiplier = 1;
        if (unit === "hours") multiplier = 60;
        if (unit === "days") multiplier = 60 * 24;
        if (unit === "weeks") multiplier = 60 * 24 * 7;
        if (unit === "months") multiplier = 60 * 24 * 30;

        return numericValue * multiplier;
      }

      function formatProjectedTime(date) {
        var timezone = relativeSentence?.dataset.calendarTimezone || undefined;
        var formatter = new Intl.DateTimeFormat("en-US", {
          timeZone: timezone,
          month: "short",
          day: "numeric",
          hour: "numeric",
          minute: "2-digit",
          hour12: true
        });
        var parts = {};

        formatter.formatToParts(date).forEach(function(part) {
          if (part.type !== "literal") parts[part.type] = part.value;
        });

        var month = parts.month === "Sep" ? "Sept" : parts.month;
        return month + " " + parts.day + " " + parts.hour + ":" + parts.minute + parts.dayPeriod;
      }

      function projectedTimeSuffix(offsetValue, unit, direction, anchorPoint) {
        var anchorField = form.querySelector('[data-relative-summary-input="anchor"]');
        if (!anchorField || !anchorField.selectedOptions || !anchorField.selectedOptions.length || !anchorField.value) return "";

        var selectedAnchor = anchorField.selectedOptions[0];
        var baseIso = anchorPoint === "ends"
          ? (selectedAnchor.dataset.anchorEndAt || selectedAnchor.dataset.anchorStartAt)
          : selectedAnchor.dataset.anchorStartAt;
        if (!baseIso) return "";

        var baseTime = new Date(baseIso);
        var offsetMinutes = offsetMinutesFor(offsetValue, unit);
        if (Number.isNaN(baseTime.getTime()) || offsetMinutes === null) return "";

        if (direction === "before") offsetMinutes *= -1;

        return " → " + formatProjectedTime(new Date(baseTime.getTime() + (offsetMinutes * 60 * 1000)));
      }

      function syncRelativeSummary() {
        if (!relativeSummary) return;

        var offsetInput = form.querySelector('[data-relative-summary-input="offsetValue"]');
        var offsetValue = offsetInput ? offsetInput.value.trim() : "";
        var anchorTitle = selectedAnchorTitle();
        var direction = selectedText("direction") || "after";
        var anchorPoint = selectedText("anchorPoint") || "starts";
        var unit = (selectedText("offsetUnit") || "minutes").toLowerCase();
        var projection = projectedTimeSuffix(offsetValue, unit, direction, anchorPoint);

        if (!anchorTitle) {
          relativeSummary.textContent = "Choose an anchor to preview relative timing.";
          return;
        }

        if (!offsetValue || Number(offsetValue) === 0) {
          relativeSummary.textContent = "Starts when " + anchorTitle + " " + anchorPoint + projection;
          return;
        }

        relativeSummary.textContent = "Starts " + offsetValue + " " + pluralizedUnit(offsetValue, unit) + " " + direction + " " + anchorTitle + " " + anchorPoint + projection;
      }

      function syncAbsoluteSummary() {
        if (!absoluteSummary || !absoluteInput) return;

        if (!absoluteInput.value) {
          absoluteSummary.textContent = "Exact start not set.";
          return;
        }

        absoluteSummary.textContent = "Exact start selected.";
      }

      radios.forEach(function(radio) {
        radio.addEventListener("change", syncTiming);
      });

      relativeInputs.forEach(function(input) {
        input.addEventListener("change", syncRelativeSummary);
        input.addEventListener("input", syncRelativeSummary);
      });

      if (absoluteInput) {
        absoluteInput.addEventListener("change", syncAbsoluteSummary);
        absoluteInput.addEventListener("input", syncAbsoluteSummary);
      }

      syncTiming();
      syncRelativeSummary();
    });
  })();
</script>
