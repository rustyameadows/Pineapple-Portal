<% provide :page_shell do %>
  <div class="event-layout">
    <%= render "events/sidebar_navigation", event: @event %>

    <div class="event-layout__main">
      <%= render "shared/flash" %>

      <section class="event-section">
        <header class="event-section__header">
          <div>
            <p class="event-section__eyebrow">Event Directory</p>
            <h1 class="event-section__title">People</h1>
            <p class="event-section__lead">Review everyone connected to this event and manage the key people who should appear on reference materials.</p>
          </div>
        </header>
      </section>

      <section class="event-section">
        <header class="event-section__header">
          <div>
            <p class="event-section__eyebrow">Key People</p>
            <h2 class="event-section__title">Key People</h2>
            <p class="event-section__lead">Use this list for attendants, VIP family members, speakers, or anyone who should appear on the Wedding Party Reference sheet.</p>
          </div>
        </header>
        <div class="event-section__body">
          <div class="event-key-people">
            <article class="event-directory-card event-key-people__settings-card">
              <%= form_with model: @event,
                            url: event_path(@event),
                            method: :patch,
                            local: true,
                            class: "event-key-people__label-form" do |form| %>
                <%= hidden_field_tag :return_to, request.fullpath %>

                <div class="event-key-people__label-row">
                  <div class="event-key-people__label-copy">
                    <h3>Packet Label</h3>
                    <p class="event-directory-card__meta">This controls the full-width key people section title on the Wedding Party Reference packet.</p>
                  </div>

                  <div class="event-key-people__label-field">
                    <%= form.label :key_people_label, "Key People Label" %>
                    <%= form.text_field :key_people_label, maxlength: 120, placeholder: "Wedding Party" %>
                  </div>

                  <div class="event-key-people__label-actions">
                    <%= form.submit "Save label", class: "button button--small" %>
                  </div>
                </div>
              <% end %>
            </article>

            <article class="event-directory-card event-key-people__create-card">
              <h3>Add key person</h3>
              <p class="event-directory-card__meta">These entries stay event-specific and can use any group or side label you need.</p>

              <%= form_with(model: [@event, @new_event_guest], class: "event-key-people__form") do |form| %>
                <% custom_group_field_id = "#{form.object_name}_custom_group_name_new" %>
                <%= hidden_field_tag :return_to, request.fullpath %>

                <div class="event-key-people__grid">
                  <div class="event-key-people__field">
                    <%= form.label :first_name, "First Name" %>
                    <%= form.text_field :first_name, required: true %>
                  </div>

                  <div class="event-key-people__field">
                    <%= form.label :last_name, "Last Name" %>
                    <%= form.text_field :last_name, required: true %>
                  </div>

                  <div class="event-key-people__field">
                    <%= form.label :relationship, "Relationship" %>
                    <%= form.text_field :relationship, required: true, placeholder: "Maid of Honor, Father, Speaker" %>
                  </div>

                  <div class="event-key-people__field">
                    <%= form.label :event_key_person_group_id, "Group / Side" %>
                    <% if @key_people_group_options.any? %>
                      <div data-controller="event-group-select"
                           data-event-group-select-new-option-value="__new__">
                        <%= form.select :event_key_person_group_id,
                                        options_for_select(@key_people_group_options + [["New group", "__new__"]], form.object.event_key_person_group_id&.to_s),
                                      { include_blank: "Select a group" },
                                        {
                                          data: {
                                            action: "change->event-group-select#sync",
                                            event_group_select_target: "select"
                                          }
                                        } %>
                        <div class="event-key-people__subfield"
                             data-event-group-select-target="customField"
                             hidden>
                          <%= label_tag custom_group_field_id, "Add New Group" %>
                          <%= text_field_tag "#{form.object_name}[custom_group_name]",
                                             nil,
                                             id: custom_group_field_id,
                                             placeholder: "Type the new group name",
                                             disabled: true,
                                             data: { event_group_select_target: "customInput" } %>
                        </div>
                      </div>
                    <% else %>
                      <%= text_field_tag "#{form.object_name}[custom_group_name]", nil, required: true, placeholder: "Bride's Side, John's Side, VIP Family" %>
                    <% end %>
                  </div>

                  <div class="event-key-people__field event-key-people__field--checkbox">
                    <span class="event-key-people__field-label">VIP</span>
                    <label class="event-key-people__checkbox">
                      <%= form.check_box :vip %>
                      <span>Mark as VIP</span>
                    </label>
                  </div>
                </div>

                <div class="event-key-people__actions">
                  <%= form.submit "Add key person", class: "button button--small" %>
                </div>
              <% end %>
            </article>

            <% if @key_person_groups.any? %>
              <div class="event-key-people__groups">
                <% @key_person_groups.each do |group| %>
                  <% guests = group.event_guests.to_a.sort_by { |guest| [guest.position, guest.id] } %>
                  <article class="event-directory-card event-key-people__group-card">
                    <div class="event-key-people__group-header">
                      <%= form_with model: [@event, group], class: "event-key-people__row" do |form| %>
                        <%= hidden_field_tag :return_to, request.fullpath %>
                        <div class="event-key-people__grid">
                          <div class="event-key-people__field">
                            <%= form.label :name, "Group / Side Name" %>
                            <%= form.text_field :name, required: true %>
                          </div>
                        </div>
                        <div class="event-key-people__actions">
                          <span class="event-directory-card__meta"><%= pluralize(guests.size, "person") %></span>
                          <span class="event-directory-card__meta">Timeline tag: <strong><%= group.event_calendar_tag.name %></strong></span>
                          <%= form.submit "Save group", class: "button button--small" %>
                        </div>
                      <% end %>
                    </div>

                    <div class="event-key-people__rows">
                      <% if guests.any? %>
                        <% guests.each do |guest| %>
                          <%= form_with(model: [@event, guest], class: "event-key-people__row") do |form| %>
                            <% custom_group_field_id = "#{form.object_name}_custom_group_name_#{guest.id}" %>
                            <%= hidden_field_tag :return_to, request.fullpath %>

                            <div class="event-key-people__grid">
                              <div class="event-key-people__field">
                                <%= form.label :first_name, "First Name" %>
                                <%= form.text_field :first_name, required: true %>
                              </div>

                              <div class="event-key-people__field">
                                <%= form.label :last_name, "Last Name" %>
                                <%= form.text_field :last_name, required: true %>
                              </div>

                              <div class="event-key-people__field">
                                <%= form.label :relationship, "Relationship" %>
                                <%= form.text_field :relationship, required: true %>
                              </div>

                              <div class="event-key-people__field">
                                <%= form.label :event_key_person_group_id, "Group / Side" %>
                                <div data-controller="event-group-select"
                                     data-event-group-select-new-option-value="__new__">
                                  <%= form.select :event_key_person_group_id,
                                                  options_for_select(@key_people_group_options + [["New group", "__new__"]], guest.event_key_person_group_id&.to_s),
                                                  {},
                                                  {
                                                    data: {
                                                      action: "change->event-group-select#sync",
                                                      event_group_select_target: "select"
                                                    }
                                                  } %>
                                  <div class="event-key-people__subfield"
                                       data-event-group-select-target="customField"
                                       hidden>
                                    <%= label_tag custom_group_field_id, "Move To New Group" %>
                                    <%= text_field_tag "#{form.object_name}[custom_group_name]",
                                                       nil,
                                                       id: custom_group_field_id,
                                                       placeholder: "Type the new group name",
                                                       disabled: true,
                                                       data: { event_group_select_target: "customInput" } %>
                                  </div>
                                </div>
                              </div>

                              <div class="event-key-people__field event-key-people__field--checkbox">
                                <span class="event-key-people__field-label">VIP</span>
                                <label class="event-key-people__checkbox">
                                  <%= form.check_box :vip %>
                                  <span>Mark as VIP</span>
                                </label>
                              </div>
                            </div>

                            <div class="event-key-people__actions">
                              <%= link_to "Move up",
                                          move_up_event_event_guest_path(@event, guest, return_to: request.fullpath),
                                          data: { turbo_method: :patch },
                                          class: "button button--ghost button--tiny" %>
                              <%= link_to "Move down",
                                          move_down_event_event_guest_path(@event, guest, return_to: request.fullpath),
                                          data: { turbo_method: :patch },
                                          class: "button button--ghost button--tiny" %>
                              <%= form.submit "Save", class: "button button--small" %>
                              <%= link_to "Delete",
                                          event_event_guest_path(@event, guest, return_to: request.fullpath),
                                          data: { turbo_method: :delete, turbo_confirm: "Remove this key person?" },
                                          class: "button button--ghost button--tiny" %>
                            </div>
                          <% end %>
                        <% end %>
                      <% else %>
                        <p class="event-section__lead">No key people are assigned to this group yet.</p>
                      <% end %>
                    </div>
                  </article>
                <% end %>
              </div>
            <% else %>
              <p class="event-section__lead">No key people have been added yet.</p>
            <% end %>
          </div>
        </div>
      </section>

      <section class="event-section">
        <header class="event-section__header">
          <div>
            <p class="event-section__eyebrow">Planning Team</p>
            <h2 class="event-section__title">Planners</h2>
          </div>
        </header>
        <div class="event-section__body">
          <% if @planner_team_members.any? %>
            <ul class="event-directory-list">
              <% @planner_team_members.each do |member| %>
                <% user = member.user %>
                <li>
                  <strong><%= user.name %></strong>
                  <% if user.title.present? %>
                    <span>· <%= user.title %></span>
                  <% end %>
                  <div class="event-directory-list__meta">
                    <span><%= user.email %></span>
                    <% if user.phone_number.present? %>
                      <span>· <%= user.phone_number %></span>
                    <% end %>
                  </div>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="event-section__lead">No planners are linked to this event yet.</p>
          <% end %>
        </div>
      </section>

      <section class="event-section">
        <header class="event-section__header">
          <div>
            <p class="event-section__eyebrow">Client Team</p>
            <h2 class="event-section__title">Clients</h2>
          </div>
        </header>
        <div class="event-section__body">
          <% if @client_team_members.any? %>
            <ul class="event-directory-list">
              <% @client_team_members.each do |member| %>
                <% user = member.user %>
                <li>
                  <strong><%= user.name %></strong>
                  <% if user.title.present? %>
                    <span>· <%= user.title %></span>
                  <% end %>
                  <div class="event-directory-list__meta">
                    <span><%= user.email %></span>
                    <% if user.phone_number.present? %>
                      <span>· <%= user.phone_number %></span>
                    <% end %>
                  </div>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="event-section__lead">No clients are assigned yet.</p>
          <% end %>
        </div>
      </section>

      <section class="event-section">
        <header class="event-section__header">
          <div>
            <p class="event-section__eyebrow">Vendors</p>
            <h2 class="event-section__title">Vendor Contacts</h2>
          </div>
        </header>
        <div class="event-section__body">
          <% if @vendors.any? %>
            <% @vendors.each do |vendor| %>
              <article class="event-directory-card">
                <h3><%= vendor.name %></h3>
                <% if vendor.vendor_type.present? %>
                  <p class="event-directory-card__meta"><%= vendor.vendor_type %></p>
                <% end %>
                <% if vendor.contacts.any? %>
                  <ul class="event-directory-list event-directory-list--compact">
                    <% vendor.contacts.each do |contact| %>
                      <li>
                        <strong><%= contact["name"].presence || "Contact" %></strong>
                        <% if contact["title"].present? %>
                          <span>· <%= contact["title"] %></span>
                        <% end %>
                        <div class="event-directory-list__meta">
                          <% if contact["email"].present? %>
                            <span><%= contact["email"] %></span>
                          <% end %>
                          <% if contact["phone"].present? %>
                            <span>· <%= contact["phone"] %></span>
                          <% end %>
                        </div>
                        <% if contact["notes"].present? %>
                          <p class="event-directory-card__notes"><%= contact["notes"] %></p>
                        <% end %>
                      </li>
                    <% end %>
                  </ul>
                <% else %>
                  <p class="event-section__lead">No contacts recorded for this vendor yet.</p>
                <% end %>
              </article>
            <% end %>
          <% else %>
            <p class="event-section__lead">No vendors have been added yet.</p>
          <% end %>
        </div>
      </section>

      <section class="event-section">
        <header class="event-section__header">
          <div>
            <p class="event-section__eyebrow">Locations</p>
            <h2 class="event-section__title">Venues</h2>
          </div>
        </header>
        <div class="event-section__body">
          <% if @venues.any? %>
            <% @venues.each do |venue| %>
              <article class="event-directory-card">
                <h3><%= venue.name %></h3>
                <% if venue.contacts.any? %>
                  <ul class="event-directory-list event-directory-list--compact">
                    <% venue.contacts.each do |contact| %>
                      <li>
                        <strong><%= contact["name"].presence || "Contact" %></strong>
                        <% if contact["title"].present? %>
                          <span>· <%= contact["title"] %></span>
                        <% end %>
                        <div class="event-directory-list__meta">
                          <% if contact["email"].present? %>
                            <span><%= contact["email"] %></span>
                          <% end %>
                          <% if contact["phone"].present? %>
                            <span>· <%= contact["phone"] %></span>
                          <% end %>
                        </div>
                        <% if contact["notes"].present? %>
                          <p class="event-directory-card__notes"><%= contact["notes"] %></p>
                        <% end %>
                      </li>
                    <% end %>
                  </ul>
                <% else %>
                  <p class="event-section__lead">No contacts recorded for this location yet.</p>
                <% end %>
              </article>
            <% end %>
          <% else %>
            <p class="event-section__lead">No locations have been added yet.</p>
          <% end %>
        </div>
      </section>
    </div>
  </div>
<% end %>
