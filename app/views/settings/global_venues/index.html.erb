<% provide :page_shell do %>
  <div class="event-layout event-layout--index">
    <%= render "events/sidebar_index" %>

    <div class="event-layout__main">
      <%= render "shared/flash" %>

      <section class="event-section">
        <header class="event-section__header">
          <div>
            <p class="event-section__eyebrow">Admin</p>
            <h1 class="event-section__title">Global Venues</h1>
            <p class="event-section__lead">Shared venue records across all events.</p>
          </div>
          <div class="event-section__actions">
            <%= link_to "Add Global Venue", new_settings_global_venue_path, class: "event-section__cta" %>
          </div>
        </header>

        <div class="event-section__body">
          <% if @global_venues.any? %>
            <table class="event-table">
              <thead>
                <tr>
                  <th>Venue</th>
                  <th>Contacts</th>
                  <th>Linked Events</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
              <% @global_venues.each do |venue| %>
                <tr>
                  <td><%= venue.name %></td>
                  <td><%= venue.contacts.size %></td>
                  <td><%= venue.attributes["usage_count"].to_i %></td>
                  <td class="event-table__actions">
                    <%= link_to "Edit", edit_settings_global_venue_path(venue), class: "event-section__link" %>
                    <%= link_to "Remove",
                                settings_global_venue_path(venue),
                                data: { turbo_method: :delete, turbo_confirm: "Remove this global venue?" },
                                class: "event-section__link event-section__link--danger" %>
                  </td>
                </tr>
              <% end %>
              </tbody>
            </table>
          <% else %>
            <p class="event-settings__empty">No global venues yet.</p>
          <% end %>
        </div>
      </section>
    </div>
  </div>
<% end %>
