<%= render "generated_documents/shared/pdf_font_faces" %>

<style>
  :root {
    --font-family-display: "Didot", "Times New Roman", serif;
  }

  @page {
    size: <%= @page_width_points %>pt <%= @page_height_points %>pt;
    margin: 0;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    width: <%= @page_width_points %>pt;
    height: <%= @page_height_points %>pt;
    background: transparent;
  }

  body {
    box-sizing: border-box;
  }

  .generated-page-number-overlay {
    box-sizing: border-box;
    width: 100%;
    height: 100%;
    padding: 0 10pt 12pt 0;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    background: transparent;
  }

  .generated-page-number-overlay__label {
    font-family: var(--font-family-display, "Didot", "Times New Roman", serif);
    font-size: 16px;
    font-style: italic;
    line-height: 1;
    color: <%= @page_text_color %>;
  }
</style>

<div class="generated-page-number-overlay">
  <span class="generated-page-number-overlay__label"><%= @page_label %></span>
</div>
