<% if local_assigns.fetch(:render_base_styles, true) %>
  <%= render "generated_documents/sections/base_styles" %>
<% end %>
<%= render "generated_documents/sections/packet_sheet_styles" %>

<% milestone_data = generated_wedding_party_reference_milestones(@event) %>
<% milestone_groups = milestone_data[:groups] %>
<% milestone_timezone = milestone_data[:timezone] %>
<% wedding_party_groups = generated_wedding_party_reference_key_people(@event) %>
<% wedding_party_timeline = generated_wedding_party_reference_timeline(@event, @segment) %>

<style>
  .generated-template--wedding-party-reference__top-band {
    display: grid;
    row-gap: 0;
  }

  .generated-template--wedding-party-reference__top-band-header,
  .generated-template--wedding-party-reference__top-band-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 0.12in;
    align-items: stretch;
  }

  .generated-template--wedding-party-reference__events-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 0.12in;
    row-gap: 6px;
  }

  .generated-template--wedding-party-reference__top-band-row .generated-template--packet-sheet__section {
    align-self: stretch;
  }

  .generated-template--wedding-party-reference__top-band-row .generated-template--packet-sheet__subsection {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    height: 100%;
    border-left: 1px solid rgba(0, 0, 0, 0.06);
    border-right: 1px solid rgba(0, 0, 0, 0.06);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  .generated-template--wedding-party-reference__top-band-row .generated-template--packet-sheet__body {
    align-content: start;
    padding: 6px 6px 10px;
    border-bottom: none;
  }

  .generated-template--wedding-party-reference__top-band-row .generated-template--packet-sheet__empty {
    height: 100%;
    padding: 4px 6px;
  }

  .generated-template--wedding-party-reference__events-grid > article {
    min-width: 0;
  }

  .generated-template--wedding-party-reference__transportation-stack {
    display: grid;
    gap: 6px;
  }

  .generated-template--wedding-party-reference__transportation-note {
    gap: 8px;
    align-content: start;
  }

  .generated-template--wedding-party-reference__wedding-party-content {
    display: grid;
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-top: none;
  }

  .generated-template--wedding-party-reference__wedding-party-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.12in;
    align-items: start;
  }

  .generated-template--wedding-party-reference__wedding-party-group {
    display: grid;
    align-content: start;
  }

  .generated-template--wedding-party-reference__wedding-party-group .generated-template--packet-sheet__grid {
    border-bottom: none;
  }

  .generated-template--wedding-party-reference__timeline-section {
    break-inside: auto;
    page-break-inside: auto;
  }

  .generated-template.generated-template--packet-sheet h2.generated-template--wedding-party-reference__timeline-section-title {
    break-after: avoid;
    page-break-after: avoid;
  }

  .generated-template--wedding-party-reference__timeline-stack,
  .generated-template--wedding-party-reference__timeline-rows {
    display: grid;
    gap: 0.12in;
  }

  .generated-template--wedding-party-reference__timeline-day {
    display: grid;
    gap: 0.08in;
  }

  .generated-template.generated-template--packet-sheet table.generated-template--wedding-party-reference__timeline-table {
    width: 100%;
    margin: 0;
    table-layout: fixed;
    border-collapse: collapse;
    border-left: 1px solid rgba(0, 0, 0, 0.06);
    border-right: 1px solid rgba(0, 0, 0, 0.06);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    font-size: 12px;
    break-inside: auto;
    page-break-inside: auto;
  }

  .generated-template--wedding-party-reference__timeline-table thead {
    display: table-header-group;
  }

  .generated-template--wedding-party-reference__timeline-table tbody {
    display: table-row-group;
  }

  .generated-template--wedding-party-reference__timeline-time-col {
    width: 0.72in;
  }

  .generated-template.generated-template--packet-sheet table.generated-template--wedding-party-reference__timeline-table th,
  .generated-template.generated-template--packet-sheet table.generated-template--wedding-party-reference__timeline-table td {
    padding: 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    vertical-align: top;
  }

  .generated-template.generated-template--packet-sheet table.generated-template--wedding-party-reference__timeline-table th {
    background: #f4f1ed;
  }

  .generated-template.generated-template--packet-sheet table.generated-template--wedding-party-reference__timeline-table th.generated-template--wedding-party-reference__timeline-column-title {
    padding: 5px 6px;
    color: #5b4639;
    font-family: var(--font-family-body, "BaskervilleNo2", "Times New Roman", serif);
    text-align: center;
    text-transform: none;
    letter-spacing: 0;
    line-height: 15px;
    font-size: 12px;
    font-weight: 600;
    border-right: 1px solid rgba(0, 0, 0, 0.06);
  }

  .generated-template.generated-template--packet-sheet table.generated-template--wedding-party-reference__timeline-table th.generated-template--wedding-party-reference__timeline-column-title:last-child {
    border-right: none;
  }

  .generated-template--wedding-party-reference__timeline-table-row {
    break-inside: avoid;
    page-break-inside: avoid;
  }

  .generated-template--wedding-party-reference__timeline-table-row:last-child td {
    border-bottom: none;
  }

  .generated-template--wedding-party-reference__timeline-slot--empty {
    height: 0.18in;
  }

  .generated-template.generated-template--packet-sheet table.generated-template--wedding-party-reference__timeline-table td.generated-template--wedding-party-reference__timeline-cell {
    padding: 3px 4px;
    border-right: 1px solid rgba(0, 0, 0, 0.06);
  }

  .generated-template.generated-template--packet-sheet table.generated-template--wedding-party-reference__timeline-table td.generated-template--wedding-party-reference__timeline-cell--time {
    padding-right: 6px;
  }

  .generated-template.generated-template--packet-sheet table.generated-template--wedding-party-reference__timeline-table td.generated-template--wedding-party-reference__timeline-cell--details {
    padding-left: 8px;
    width: auto;
  }

  .generated-template.generated-template--packet-sheet table.generated-template--wedding-party-reference__timeline-table .generated-template--wedding-party-reference__timeline-cell--last {
    border-right: none;
  }

  .generated-template.generated-template--packet-sheet p.generated-template--wedding-party-reference__timeline-time {
    text-align: right;
    white-space: nowrap;
    color: #5b4639;
    font-weight: 600;
  }

  .generated-template.generated-template--packet-sheet p.generated-template--wedding-party-reference__timeline-notes {
    font-size: 10px;
    line-height: 12px;
    color: #7a6551;
    font-style: italic;
  }

  .generated-template.generated-template--packet-sheet p.generated-template--wedding-party-reference__timeline-empty {
    margin: 0;
    padding: 0.06in;
    border: none;
  }

  .generated-template--wedding-party-reference__timeline-empty-cell {
    border-right: none;
  }
</style>

<section class="generated-template generated-template--packet-sheet generated-template--wedding-party-reference">
  <%= render "generated_documents/sections/page_header", segment: @segment %>

  <div class="generated-template--packet-sheet__stack">
    <div class="generated-template--wedding-party-reference__top-band">
      <div class="generated-template--wedding-party-reference__top-band-header">
        <section class="generated-template--packet-sheet__section">
          <h2 class="generated-template--packet-sheet__section-title">Event Timelines</h2>
        </section>
        <section class="generated-template--packet-sheet__section">
          <h2 class="generated-template--packet-sheet__section-title">Transportation Details</h2>
        </section>
      </div>

      <% if milestone_groups.any? %>
        <% milestone_groups.each do |group| %>
          <div class="generated-template--wedding-party-reference__top-band-row">
            <section class="generated-template--packet-sheet__section">
              <section class="generated-template--packet-sheet__subsection">
                <h3 class="generated-template--packet-sheet__subsection-title"><%= group[:date_label] %></h3>
                <div class="generated-template--packet-sheet__body generated-template--wedding-party-reference__events-grid">
                  <% group[:items].each do |item| %>
                    <article class="generated-template--packet-sheet__event-card">
                      <p class="generated-template--packet-sheet__text generated-template--packet-sheet__text--event-card">
                        <strong><%= item.title %></strong><br>
                        <% if item.location_name.present? %>
                          <%= item.location_name %><br>
                        <% end %>
                        <u><%= calendar_item_time_only_label_with_marker(item, milestone_timezone) %></u>
                      </p>
                    </article>
                  <% end %>
                </div>
              </section>
            </section>

            <section class="generated-template--packet-sheet__section">
              <section class="generated-template--packet-sheet__subsection">
                <h3 class="generated-template--packet-sheet__subsection-title"><%= group[:date_label] %></h3>
                <div class="generated-template--packet-sheet__body generated-template--wedding-party-reference__transportation-stack">
                  <% Array(group[:transportation_notes]).each do |note| %>
                    <div class="generated-template--packet-sheet__rich-text generated-template--wedding-party-reference__transportation-note">
                      <%= render_generated_packet_rich_text_content(note) %>
                    </div>
                  <% end %>
                </div>
              </section>
            </section>
          </div>
        <% end %>
      <% else %>
        <div class="generated-template--wedding-party-reference__top-band-row">
          <section class="generated-template--packet-sheet__section">
            <p class="generated-template--packet-sheet__empty">No milestone items are available for this event yet.</p>
          </section>
          <section class="generated-template--packet-sheet__section">
            <div class="generated-template--packet-sheet__body generated-template--wedding-party-reference__transportation-stack"></div>
          </section>
        </div>
      <% end %>
    </div>

    <% if generated_packet_rich_text_present?(@event.getting_ready_details) %>
      <section class="generated-template--packet-sheet__section">
        <h2 class="generated-template--packet-sheet__section-title">Getting Ready Details</h2>
        <div class="generated-template--packet-sheet__content generated-template--packet-sheet__rich-text generated-template--wedding-party-reference__getting-ready">
          <%= render_generated_packet_rich_text(@event.getting_ready_details) %>
        </div>
      </section>
    <% end %>

    <% if wedding_party_groups.any? %>
      <section class="generated-template--packet-sheet__section">
        <h2 class="generated-template--packet-sheet__section-title"><%= @event.key_people_label.presence || "Wedding Party" %></h2>
        <div class="generated-template--wedding-party-reference__wedding-party-content">
          <div class="generated-template--wedding-party-reference__wedding-party-columns">
        <% wedding_party_groups.each do |side| %>
              <section class="generated-template--wedding-party-reference__wedding-party-group generated-template--packet-sheet__subsection">
            <h3 class="generated-template--packet-sheet__subsection-title"><%= side[:title] %></h3>
            <div class="generated-template--packet-sheet__grid">
              <% side[:members].each do |member| %>
                <div class="generated-template--packet-sheet__grid-row generated-template--packet-sheet__grid-row--roster">
                  <div class="generated-template--packet-sheet__grid-cell">
                    <p class="generated-template--packet-sheet__text"><strong><%= member[:name] %></strong></p>
                  </div>
                  <div class="generated-template--packet-sheet__grid-cell">
                    <p class="generated-template--packet-sheet__text"><em><%= member[:role] %></em></p>
                  </div>
                </div>
              <% end %>
            </div>
          </section>
        <% end %>
          </div>
        </div>
      </section>
    <% end %>

    <section class="generated-template--packet-sheet__section generated-template--wedding-party-reference__timeline-section">
      <h2 class="generated-template--packet-sheet__section-title generated-template--wedding-party-reference__timeline-section-title">Wedding Party Timeline</h2>

      <% if wedding_party_timeline[:columns].any? %>
        <div class="generated-template--wedding-party-reference__timeline-stack">
          <% wedding_party_timeline[:day_groups].each do |day_group| %>
            <section class="generated-template--wedding-party-reference__timeline-day">
              <% if wedding_party_timeline[:show_day_headers] %>
                <h3 class="generated-template--packet-sheet__subsection-title generated-template--wedding-party-reference__timeline-day-title"><%= day_group[:date_label] %></h3>
              <% end %>

              <div class="generated-template--wedding-party-reference__timeline-rows">
                <% day_group[:column_groups].each do |column_group| %>
                  <% columns = column_group[:columns] %>
                  <% column_count = columns.length %>
                  <% table_column_count = column_count * 2 %>
                  <table class="generated-template--wedding-party-reference__timeline-table <%= "generated-template--wedding-party-reference__timeline-table--single" if columns.one? %>">
                    <colgroup>
                      <% columns.each do |column| %>
                        <col class="generated-template--wedding-party-reference__timeline-time-col">
                        <col class="generated-template--wedding-party-reference__timeline-detail-col">
                      <% end %>
                    </colgroup>
                    <thead class="generated-template--wedding-party-reference__timeline-column-headers">
                      <tr>
                        <% columns.each_with_index do |column, index| %>
                          <th colspan="2" class="generated-template--wedding-party-reference__timeline-column-title <%= "generated-template--wedding-party-reference__timeline-cell--last" if index == column_count - 1 %>"><%= column[:header] %></th>
                        <% end %>
                      </tr>
                    </thead>

                    <tbody class="generated-template--wedding-party-reference__timeline-table-body">
                      <% if column_group[:rows].any? %>
                        <% column_group[:rows].each do |row| %>
                          <tr class="generated-template--wedding-party-reference__timeline-table-row">
                            <% row[:cells].each_with_index do |cell, index| %>
                              <% item = cell[:item] %>
                              <% last_column = index == column_count - 1 %>
                              <td class="generated-template--wedding-party-reference__timeline-cell generated-template--wedding-party-reference__timeline-cell--time">
                                <% if item.present? %>
                                  <p class="generated-template--packet-sheet__text generated-template--wedding-party-reference__timeline-time"><%= calendar_item_start_time_only_label(item, wedding_party_timeline[:timezone]) %></p>
                                <% end %>
                              </td>
                              <td class="generated-template--wedding-party-reference__timeline-cell generated-template--wedding-party-reference__timeline-cell--details <%= "generated-template--wedding-party-reference__timeline-slot--empty" if item.blank? %> <%= "generated-template--wedding-party-reference__timeline-cell--last" if last_column %>">
                                <% if item.present? %>
                                  <p class="generated-template--packet-sheet__text"><%= item.title %></p>
                                  <% if item.notes.present? %>
                                    <%= simple_format(item.notes, { class: "generated-template--packet-sheet__text generated-template--wedding-party-reference__timeline-notes" }, wrapper_tag: "p") %>
                                  <% end %>
                                <% end %>
                              </td>
                            <% end %>
                          </tr>
                        <% end %>
                      <% else %>
                        <tr class="generated-template--wedding-party-reference__timeline-table-row">
                          <td colspan="<%= table_column_count %>" class="generated-template--wedding-party-reference__timeline-empty-cell">
                            <p class="generated-template--packet-sheet__empty generated-template--wedding-party-reference__timeline-empty">No timeline items.</p>
                          </td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                <% end %>
              </div>
            </section>
          <% end %>
        </div>
      <% else %>
        <p class="generated-template--packet-sheet__empty"><%= wedding_party_timeline[:empty_message] %></p>
      <% end %>
    </section>
  </div>
</section>
