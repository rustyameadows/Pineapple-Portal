<% if local_assigns.fetch(:render_base_styles, true) %>
  <%= render "generated_documents/sections/base_styles" %>
<% end %>
<%= render "generated_documents/sections/packet_sheet_styles" %>

<style>
  .generated-template--planning-team.generated-template--packet-sheet {
    gap: 0.16in;
    --generated-document-content-padding-top: 0.28in;
    --generated-document-content-padding-bottom: 0.55in;
    --planning-team-card-width: 1.9in;
    --planning-team-grid-column-gap: 0.16in;
    --planning-team-grid-row-gap: 0.22in;
    --planning-team-details-min-height: 0.48in;
  }

  .generated-template--planning-team__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    column-gap: var(--planning-team-grid-column-gap);
    row-gap: var(--planning-team-grid-row-gap);
  }

  .generated-template--planning-team__card {
    width: var(--planning-team-card-width);
    flex: 0 0 var(--planning-team-card-width);
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 0.09in;
    text-align: center;
    break-inside: avoid;
  }

  .generated-template--planning-team__photo {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: rgba(45, 28, 18, 0.08);
    display: grid;
    place-items: center;
    color: #2d1c12;
    font-family: var(--font-family-body, "BaskervilleNo2", "Times New Roman", serif);
    font-size: 0.42in;
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .generated-template--planning-team__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
  }

  .generated-template--planning-team__details {
    width: 100%;
    min-height: var(--planning-team-details-min-height);
    padding: 0;
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 0.03in;
  }

  .generated-template p.generated-template--planning-team__name {
    margin: 0;
    color: #6a533f;
    font-family: var(--font-family-display, "Didot", "Times New Roman", serif);
    font-size: 17px;
    font-weight: 400;
    line-height: 19px;
    letter-spacing: 0.025em;
    text-transform: none;
  }

  .generated-template p.generated-template--planning-team__title {
    margin: 0;
    color: rgba(45, 28, 18, 0.78);
    font-size: 10px;
    line-height: 12px;
    letter-spacing: 0.015em;
  }

  .generated-template p.generated-template--planning-team__name,
  .generated-template p.generated-template--planning-team__title {
    font-family: var(--font-family-body, "BaskervilleNo2", "Times New Roman", serif);
    margin-bottom: 0;
    letter-spacing: 0;
    text-transform: none;
  }

  .generated-template p.generated-template--planning-team__name {
    margin-bottom: 0;
  }

  .generated-template--planning-team__empty {
    font-style: italic;
    color: #5b4639;
  }
</style>

<div class="generated-template generated-template--packet-sheet generated-template--planning-team">
  <%= render "generated_documents/sections/page_header", segment: @segment %>
  <% planners = @event.planner_team_members.includes(:user) %>
  <% if planners.any? %>
    <div class="generated-template--planning-team__grid">
      <% planners.each do |member| %>
        <% user = member.user %>
        <% avatar_uri = inline_global_asset_data_uri(user.avatar_global_asset) %>
        <article class="generated-template--planning-team__card">
          <div class="generated-template--planning-team__photo">
            <% if avatar_uri.present? %>
              <img src="<%= avatar_uri %>" alt="<%= user.name %>">
            <% else %>
              <span><%= user.name.to_s.split.map { |part| part.first }.join.first(2).presence || "PP" %></span>
            <% end %>
          </div>
          <div class="generated-template--planning-team__details">
            <p class="generated-template--planning-team__name"><%= user.name %></p>
            <p class="generated-template--planning-team__title"><%= user.title.presence || "Planner" %></p>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <p class="generated-template--planning-team__empty">No planners have been linked to this event yet.</p>
  <% end %>
</div>
