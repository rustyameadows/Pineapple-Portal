<% if local_assigns.fetch(:render_base_styles, true) %>
  <%= render "generated_documents/sections/base_styles" %>
<% end %>
<%= render "generated_documents/sections/packet_sheet_styles" %>

<% vendor_groups = generated_vendor_contacts_groups(@event) %>

<style>
  .generated-template--vendor-contacts {
    gap: 8px;
  }

  .generated-template.generated-template--vendor-contacts .generated-template--vendor-contacts__table {
    margin-top: 0;
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }

  .generated-template.generated-template--vendor-contacts .generated-template--vendor-contacts__table th,
  .generated-template.generated-template--vendor-contacts .generated-template--vendor-contacts__table td {
    padding: 0.04in 0.06in;
    border: 1px solid rgba(0, 0, 0, 0.06);
    vertical-align: top;
    font-size: 12px;
    line-height: 14px;
    color: #5f4836;
  }

  .generated-template.generated-template--vendor-contacts .generated-template--vendor-contacts__table thead th {
    background: #bea075;
    color: #5a4330;
    font-family: var(--font-family-body, "BaskervilleNo2", "Times New Roman", serif);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.25px;
  }

  .generated-template--vendor-contacts__category {
    width: 14%;
  }

  .generated-template--vendor-contacts__vendor {
    width: 22%;
    font-weight: 600;
  }

  .generated-template--vendor-contacts__contact {
    width: 24%;
  }

  .generated-template--vendor-contacts__phone {
    width: 16%;
    white-space: nowrap;
  }

  .generated-template--vendor-contacts__team-meals {
    width: 24%;
    overflow-wrap: anywhere;
  }

  .generated-template--vendor-contacts__team-meals .generated-template--packet-sheet__rich-text {
    display: grid;
    gap: 0.03in;
  }

  .generated-template--vendor-contacts__team-meals .generated-template--packet-sheet__rich-text p {
    margin: 0;
  }

  .generated-template--vendor-contacts__category--continued,
  .generated-template--vendor-contacts__vendor--continued,
  .generated-template--vendor-contacts__team-meals--continued {
    border-top-color: transparent;
  }

  .generated-template--vendor-contacts__continued-value {
    visibility: hidden;
  }
</style>

<section class="generated-template generated-template--packet-sheet generated-template--vendor-contacts">
  <%= render "generated_documents/sections/page_header", segment: @segment %>

  <table class="generated-template--vendor-contacts__table">
    <thead>
      <tr>
        <th>Category</th>
        <th>Vendor</th>
        <th>Contact</th>
        <th>Phone</th>
        <th>Team Meals</th>
      </tr>
    </thead>
      <% vendor_groups.each do |group| %>
        <tbody class="generated-template--vendor-contacts__group">
          <% merge_rows = group[:merge_rows] %>
          <% row_span = group[:rows].size %>
          <% group[:rows].each_with_index do |row, index| %>
            <% continued = index.positive? %>
            <tr>
              <% if !merge_rows || !continued %>
                <td class="generated-template--vendor-contacts__category <%= "generated-template--vendor-contacts__category--continued" if continued %>" <%= "rowspan=#{row_span}" if merge_rows %>>
                  <% if continued %>
                    <span class="generated-template--vendor-contacts__continued-value" aria-hidden="true">&nbsp;</span>
                  <% else %>
                    <%= group[:category] %>
                  <% end %>
                </td>
                <td class="generated-template--vendor-contacts__vendor <%= "generated-template--vendor-contacts__vendor--continued" if continued %>" <%= "rowspan=#{row_span}" if merge_rows %>>
                  <% if continued %>
                    <span class="generated-template--vendor-contacts__continued-value" aria-hidden="true">&nbsp;</span>
                  <% else %>
                    <%= group[:vendor_name] %>
                  <% end %>
                </td>
              <% end %>
              <td class="generated-template--vendor-contacts__contact"><%= row[:contact] %></td>
              <td class="generated-template--vendor-contacts__phone"><%= row[:phone] %></td>
              <% if !merge_rows || !continued %>
                <td class="generated-template--vendor-contacts__team-meals <%= "generated-template--vendor-contacts__team-meals--continued" if continued %>" <%= "rowspan=#{row_span}" if merge_rows %>>
                  <% if continued %>
                    <span class="generated-template--vendor-contacts__continued-value" aria-hidden="true">&nbsp;</span>
                  <% elsif generated_packet_rich_text_present?(group[:team_meals]) %>
                    <div class="generated-template--packet-sheet__rich-text">
                      <%= render_generated_packet_rich_text_content(group[:team_meals]) %>
                    </div>
                  <% else %>
                    &#8212;
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      <% end %>
  </table>
</section>
