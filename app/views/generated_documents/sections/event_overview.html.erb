<% if local_assigns.fetch(:render_base_styles, true) %>
  <%= render "generated_documents/sections/base_styles" %>
<% end %>
<%= render "generated_documents/sections/packet_sheet_styles" %>

<% event_date_range = generated_event_overview_date_range(@event) %>
<% planners = generated_event_overview_planners(@event) %>
<% milestone_data = generated_event_overview_timeline(@event) %>
<% milestone_items = milestone_data[:groups].flat_map { |group| group[:items] } %>
<% milestone_timezone = milestone_data[:timezone] %>
<% vendors = generated_event_overview_vendors(@event) %>

<section class="generated-template generated-template--packet-sheet generated-template--event-overview">
  <%= render "generated_documents/sections/page_header", segment: @segment %>

  <div class="generated-template--packet-sheet__stack">
    <section class="generated-template--packet-sheet__section">
      <h2 class="generated-template--packet-sheet__section-title">Important Information</h2>
      <div class="generated-template--packet-sheet__grid">
        <div class="generated-template--packet-sheet__grid-row generated-template--packet-sheet__grid-row--two-column">
          <div class="generated-template--packet-sheet__grid-cell">
            <p class="generated-template--packet-sheet__text generated-template--packet-sheet__text--label">Event</p>
          </div>
          <div class="generated-template--packet-sheet__grid-cell">
            <p class="generated-template--packet-sheet__text generated-template--packet-sheet__text--value generated-template--event-overview__event-name"><%= @event.name %></p>
          </div>
        </div>
        <div class="generated-template--packet-sheet__grid-row generated-template--packet-sheet__grid-row--two-column">
          <div class="generated-template--packet-sheet__grid-cell">
            <p class="generated-template--packet-sheet__text generated-template--packet-sheet__text--label">Date</p>
          </div>
          <div class="generated-template--packet-sheet__grid-cell">
            <p class="generated-template--packet-sheet__text generated-template--packet-sheet__text--value generated-template--event-overview__dates"><%= event_date_range %></p>
          </div>
        </div>
        <div class="generated-template--packet-sheet__grid-row generated-template--packet-sheet__grid-row--two-column">
          <div class="generated-template--packet-sheet__grid-cell">
            <p class="generated-template--packet-sheet__text generated-template--packet-sheet__text--label">Location</p>
          </div>
          <div class="generated-template--packet-sheet__grid-cell">
            <p class="generated-template--packet-sheet__text generated-template--packet-sheet__text--value generated-template--event-overview__location"><%= @event.location.presence || "Location TBD" %></p>
          </div>
        </div>
      </div>
    </section>

    <section class="generated-template--packet-sheet__section generated-template--event-overview__timeline">
      <h2 class="generated-template--packet-sheet__section-title">Timeline</h2>
      <% if milestone_items.any? %>
        <div class="generated-template--packet-sheet__grid">
          <% milestone_items.each do |item| %>
            <div class="generated-template--packet-sheet__grid-row generated-template--packet-sheet__grid-row--two-column generated-template--event-overview__timeline-row">
              <div class="generated-template--packet-sheet__grid-cell">
                <p class="generated-template--packet-sheet__text generated-template--packet-sheet__text--label generated-template--event-overview__timeline-label"><%= item.title %></p>
              </div>
              <div class="generated-template--packet-sheet__grid-cell">
                <% timeline_time = generated_event_overview_timeline_time(item, milestone_timezone) %>
                <p class="generated-template--packet-sheet__text generated-template--packet-sheet__text--detail generated-template--event-overview__timeline-time"><%= timeline_time.sub(" to ", " <em>to</em> ").html_safe %></p>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="generated-template--packet-sheet__empty">No milestone items are available for this event yet.</p>
      <% end %>
    </section>

    <section class="generated-template--packet-sheet__section">
      <h2 class="generated-template--packet-sheet__section-title">Planner Contact</h2>
      <% if planners.any? %>
        <div class="generated-template--packet-sheet__grid">
          <% planners.each do |planner| %>
            <article>
              <div class="generated-template--packet-sheet__grid-row">
                <div class="generated-template--packet-sheet__grid-cell">
                  <p class="generated-template--packet-sheet__text generated-template--packet-sheet__text--label">Planning, Design &amp; Coordination</p>
                </div>
                <div class="generated-template--packet-sheet__grid-cell">
                  <p class="generated-template--packet-sheet__text generated-template--packet-sheet__text--value generated-template--event-overview__planner-name"><%= planner[:name] %></p>
                  <% if planner[:title].present? %>
                    <p class="generated-template--packet-sheet__text generated-template--event-overview__planner-title"><%= planner[:title] %></p>
                  <% end %>
                  <% if planner[:lead] %>
                    <p class="generated-template--packet-sheet__text generated-template--packet-sheet__text--muted generated-template--event-overview__planner-lead">Lead planner</p>
                  <% end %>
                </div>
                <div class="generated-template--packet-sheet__grid-cell">
                  <% if planner[:email].present? %>
                    <p class="generated-template--packet-sheet__text generated-template--packet-sheet__text--detail generated-template--event-overview__planner-email"><%= planner[:email] %></p>
                  <% end %>
                  <% if planner[:phone].present? %>
                    <p class="generated-template--packet-sheet__text generated-template--packet-sheet__text--detail generated-template--event-overview__planner-phone"><%= planner[:phone] %></p>
                  <% end %>
                </div>
              </div>
            </article>
          <% end %>
        </div>
      <% else %>
        <p class="generated-template--packet-sheet__empty">No planner contacts are linked to this event yet.</p>
      <% end %>
    </section>

    <section class="generated-template--packet-sheet__section">
      <h2 class="generated-template--packet-sheet__section-title">Vendor Contacts</h2>
      <% if vendors.any? %>
        <div class="generated-template--packet-sheet__grid">
          <% vendors.each do |vendor| %>
            <% first_contact = vendor[:contacts].first %>
            <% remaining_contacts = vendor[:contacts].drop(1) %>
            <% label_text = vendor[:vendor_type].presence || "Vendor" %>

            <article>
              <div class="generated-template--packet-sheet__grid-row">
                <div class="generated-template--packet-sheet__grid-cell">
                  <p class="generated-template--packet-sheet__text generated-template--packet-sheet__text--label"><%= label_text %></p>
                </div>
                <div class="generated-template--packet-sheet__grid-cell">
                  <p class="generated-template--packet-sheet__text generated-template--packet-sheet__text--value generated-template--event-overview__vendor-name"><%= vendor[:name] %></p>
                  <% if first_contact %>
                    <p class="generated-template--packet-sheet__text generated-template--event-overview__vendor-contact-name">
                      <%= first_contact[:name].presence || first_contact[:title].presence || "Primary contact" %><%= first_contact[:title].present? && first_contact[:name].present? ? " | #{first_contact[:title]}" : "" %>
                    </p>
                  <% end %>
                </div>
                <div class="generated-template--packet-sheet__grid-cell">
                  <% if vendor[:social_handle].present? %>
                    <p class="generated-template--packet-sheet__text generated-template--packet-sheet__text--detail"><%= vendor[:social_handle] %></p>
                  <% end %>
                  <% if first_contact&.dig(:email).present? %>
                    <p class="generated-template--packet-sheet__text generated-template--packet-sheet__text--detail generated-template--event-overview__vendor-contact-email"><%= first_contact[:email] %></p>
                  <% end %>
                  <% if first_contact&.dig(:phone).present? %>
                    <p class="generated-template--packet-sheet__text generated-template--packet-sheet__text--detail generated-template--event-overview__vendor-contact-phone"><%= first_contact[:phone] %></p>
                  <% end %>
                </div>
              </div>

              <% remaining_contacts.each do |contact| %>
                <div class="generated-template--packet-sheet__grid-row">
                  <div class="generated-template--packet-sheet__grid-cell">
                    <p class="generated-template--packet-sheet__text generated-template--packet-sheet__text--label"></p>
                  </div>
                  <div class="generated-template--packet-sheet__grid-cell">
                    <p class="generated-template--packet-sheet__text generated-template--event-overview__vendor-contact-name">
                      <%= contact[:name].presence || contact[:title].presence || "Additional contact" %><%= contact[:title].present? && contact[:name].present? ? " | #{contact[:title]}" : "" %>
                    </p>
                  </div>
                  <div class="generated-template--packet-sheet__grid-cell">
                    <% if contact[:email].present? %>
                      <p class="generated-template--packet-sheet__text generated-template--packet-sheet__text--detail generated-template--event-overview__vendor-contact-email"><%= contact[:email] %></p>
                    <% end %>
                    <% if contact[:phone].present? %>
                      <p class="generated-template--packet-sheet__text generated-template--packet-sheet__text--detail generated-template--event-overview__vendor-contact-phone"><%= contact[:phone] %></p>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </article>
          <% end %>
        </div>
      <% else %>
        <p class="generated-template--packet-sheet__empty">No vendor contacts are available for this event yet.</p>
      <% end %>
    </section>
  </div>
</section>
