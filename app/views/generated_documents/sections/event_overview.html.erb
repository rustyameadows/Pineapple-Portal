<% if local_assigns.fetch(:render_base_styles, true) %>
  <%= render "generated_documents/sections/base_styles" %>
<% end %>

<style>
  .generated-template--event-overview {
    --generated-document-content-padding-x: 0.3in;
    --generated-document-content-padding-top: 0.28in;
    --generated-document-content-padding-bottom: 0.28in;
    gap: 0.18in;
    background: var(--color-white, #ffffff);
    color: #604a37;
  }

  .generated-template--event-overview .generated-template__page-header {
    justify-items: start;
    text-align: left;
    gap: 0.06in;
    padding-bottom: 0.07in;
    border-bottom: 1px solid rgba(96, 74, 55, 0.55);
  }

  .generated-template--event-overview .generated-template__page-header-logo {
    display: none;
  }

  .generated-template--event-overview .generated-template__page-header-title {
    font-family: var(--font-family-body, "BaskervilleNo2", "Times New Roman", serif);
    font-size: 0.24in;
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0.01em;
    text-transform: none;
    color: #6b523d;
  }

  .generated-template--event-overview__sheet {
    display: grid;
    gap: 0.14in;
  }

  .generated-template--event-overview__section {
    display: grid;
    gap: 0;
  }

  .generated-template--event-overview__section-title {
    margin: 0;
    padding: 0.035in 0.08in;
    background: #bea075;
    color: #5a4330;
    font-family: var(--font-family-body, "BaskervilleNo2", "Times New Roman", serif);
    font-size: 0.115in;
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .generated-template--event-overview__table {
    display: grid;
    border-left: 1px solid rgba(194, 177, 160, 0.34);
    border-right: 1px solid rgba(194, 177, 160, 0.34);
  }

  .generated-template--event-overview__row {
    display: grid;
    grid-template-columns: 1.05fr 2.1fr 1.15fr;
    align-items: stretch;
    min-height: 0.28in;
    border-bottom: 1px solid rgba(194, 177, 160, 0.24);
    break-inside: avoid;
  }

  .generated-template--event-overview__row--two-column {
    grid-template-columns: 1.05fr 3.25fr;
  }

  .generated-template--event-overview__cell {
    padding: 0.032in 0.07in 0.03in;
    border-right: 1px solid rgba(194, 177, 160, 0.24);
    font-size: 0.118in;
    line-height: 1.18;
    color: #5f4836;
    box-sizing: border-box;
  }

  .generated-template--event-overview__row .generated-template--event-overview__cell:last-child {
    border-right: none;
  }

  .generated-template--event-overview__label {
    text-align: right;
    color: #7a6551;
    white-space: pre-line;
  }

  .generated-template--event-overview__value {
    font-weight: 600;
    white-space: pre-line;
  }

  .generated-template--event-overview__value p {
    margin: 0;
  }

  .generated-template--event-overview__value p + p {
    margin-top: 0.02in;
  }

  .generated-template--event-overview__detail {
    color: #6f5a46;
    white-space: pre-line;
  }

  .generated-template--event-overview__contact-name {
    font-style: italic;
    font-weight: 600;
  }

  .generated-template--event-overview__contact-line {
    margin: 0;
  }

  .generated-template--event-overview__contact-line + .generated-template--event-overview__contact-line {
    margin-top: 0.015in;
  }

  .generated-template--event-overview__vendor-card,
  .generated-template--event-overview__planner-card {
    display: contents;
  }

  .generated-template--event-overview__event-name {
    font-weight: 600;
  }

  .generated-template--event-overview__dates,
  .generated-template--event-overview__location,
  .generated-template--event-overview__planner-name,
  .generated-template--event-overview__planner-title,
  .generated-template--event-overview__planner-email,
  .generated-template--event-overview__planner-phone,
  .generated-template--event-overview__vendor-name,
  .generated-template--event-overview__vendor-contact-name,
  .generated-template--event-overview__vendor-contact-email,
  .generated-template--event-overview__vendor-contact-phone {
    color: inherit;
  }

  .generated-template--event-overview__planner-lead {
    font-size: 0.1in;
    font-style: italic;
    letter-spacing: 0.01em;
  }

  .generated-template--event-overview__empty {
    margin: 0;
    padding: 0.08in;
    border-left: 1px solid rgba(194, 177, 160, 0.34);
    border-right: 1px solid rgba(194, 177, 160, 0.34);
    border-bottom: 1px solid rgba(194, 177, 160, 0.24);
    font-size: 0.118in;
    font-style: italic;
    color: #7a6551;
  }
</style>

<% event_date_range = generated_event_overview_date_range(@event) %>
<% planners = generated_event_overview_planners(@event) %>
<% vendors = generated_event_overview_vendors(@event) %>

<section class="generated-template generated-template--event-overview">
  <%= render "generated_documents/sections/page_header", segment: @segment %>

  <div class="generated-template--event-overview__sheet">
    <section class="generated-template--event-overview__section">
      <h2 class="generated-template--event-overview__section-title">Important Information</h2>
      <div class="generated-template--event-overview__table">
        <div class="generated-template--event-overview__row generated-template--event-overview__row--two-column">
          <div class="generated-template--event-overview__cell generated-template--event-overview__label">Event</div>
          <div class="generated-template--event-overview__cell generated-template--event-overview__value generated-template--event-overview__event-name"><%= @event.name %></div>
        </div>
        <div class="generated-template--event-overview__row generated-template--event-overview__row--two-column">
          <div class="generated-template--event-overview__cell generated-template--event-overview__label">Date</div>
          <div class="generated-template--event-overview__cell generated-template--event-overview__value generated-template--event-overview__dates"><%= event_date_range %></div>
        </div>
        <div class="generated-template--event-overview__row generated-template--event-overview__row--two-column">
          <div class="generated-template--event-overview__cell generated-template--event-overview__label">Location</div>
          <div class="generated-template--event-overview__cell generated-template--event-overview__value generated-template--event-overview__location"><%= @event.location.presence || "Location TBD" %></div>
        </div>
      </div>
    </section>

    <section class="generated-template--event-overview__section">
      <h2 class="generated-template--event-overview__section-title">Planner Contact</h2>
      <% if planners.any? %>
        <div class="generated-template--event-overview__table">
          <% planners.each do |planner| %>
            <article class="generated-template--event-overview__planner-card">
              <div class="generated-template--event-overview__row">
                <div class="generated-template--event-overview__cell generated-template--event-overview__label">
                  Planning, Design &amp; Coordination
                </div>
                <div class="generated-template--event-overview__cell generated-template--event-overview__value">
                  <p class="generated-template--event-overview__planner-name"><%= planner[:name] %></p>
                  <% if planner[:title].present? %>
                    <p class="generated-template--event-overview__planner-title"><%= planner[:title] %></p>
                  <% end %>
                  <% if planner[:lead] %>
                    <p class="generated-template--event-overview__planner-lead">Lead planner</p>
                  <% end %>
                </div>
                <div class="generated-template--event-overview__cell generated-template--event-overview__detail">
                  <% if planner[:email].present? %>
                    <p class="generated-template--event-overview__contact-line generated-template--event-overview__planner-email"><%= planner[:email] %></p>
                  <% end %>
                  <% if planner[:phone].present? %>
                    <p class="generated-template--event-overview__contact-line generated-template--event-overview__planner-phone"><%= planner[:phone] %></p>
                  <% end %>
                </div>
              </div>
            </article>
          <% end %>
        </div>
      <% else %>
        <p class="generated-template--event-overview__empty">No planner contacts are linked to this event yet.</p>
      <% end %>
    </section>

    <section class="generated-template--event-overview__section">
      <h2 class="generated-template--event-overview__section-title">Vendor Contacts</h2>
      <% if vendors.any? %>
        <div class="generated-template--event-overview__table">
          <% vendors.each do |vendor| %>
            <% first_contact = vendor[:contacts].first %>
            <% remaining_contacts = vendor[:contacts].drop(1) %>
            <% label_text = vendor[:vendor_type].presence || "Vendor" %>
            <% detail_lines = [] %>
            <% detail_lines << vendor[:social_handle] if vendor[:social_handle].present? %>
            <% if first_contact %>
              <% detail_lines << first_contact[:email] if first_contact[:email].present? %>
              <% detail_lines << first_contact[:phone] if first_contact[:phone].present? %>
            <% end %>

            <article class="generated-template--event-overview__vendor-card">
              <div class="generated-template--event-overview__row">
                <div class="generated-template--event-overview__cell generated-template--event-overview__label"><%= label_text %></div>
                <div class="generated-template--event-overview__cell generated-template--event-overview__value">
                  <p class="generated-template--event-overview__vendor-name"><%= vendor[:name] %></p>
                  <% if first_contact %>
                    <p class="generated-template--event-overview__vendor-contact-name generated-template--event-overview__contact-name">
                      <%= first_contact[:name].presence || first_contact[:title].presence || "Primary contact" %><%= first_contact[:title].present? && first_contact[:name].present? ? " | #{first_contact[:title]}" : "" %>
                    </p>
                  <% end %>
                </div>
                <div class="generated-template--event-overview__cell generated-template--event-overview__detail">
                  <% if vendor[:social_handle].present? %>
                    <p class="generated-template--event-overview__contact-line"><%= vendor[:social_handle] %></p>
                  <% end %>
                  <% if first_contact&.dig(:email).present? %>
                    <p class="generated-template--event-overview__contact-line generated-template--event-overview__vendor-contact-email"><%= first_contact[:email] %></p>
                  <% end %>
                  <% if first_contact&.dig(:phone).present? %>
                    <p class="generated-template--event-overview__contact-line generated-template--event-overview__vendor-contact-phone"><%= first_contact[:phone] %></p>
                  <% end %>
                </div>
              </div>

              <% remaining_contacts.each do |contact| %>
                <div class="generated-template--event-overview__row">
                  <div class="generated-template--event-overview__cell generated-template--event-overview__label"></div>
                  <div class="generated-template--event-overview__cell generated-template--event-overview__value">
                    <p class="generated-template--event-overview__vendor-contact-name generated-template--event-overview__contact-name">
                      <%= contact[:name].presence || contact[:title].presence || "Additional contact" %><%= contact[:title].present? && contact[:name].present? ? " | #{contact[:title]}" : "" %>
                    </p>
                  </div>
                  <div class="generated-template--event-overview__cell generated-template--event-overview__detail">
                    <% if contact[:email].present? %>
                      <p class="generated-template--event-overview__contact-line generated-template--event-overview__vendor-contact-email"><%= contact[:email] %></p>
                    <% end %>
                    <% if contact[:phone].present? %>
                      <p class="generated-template--event-overview__contact-line generated-template--event-overview__vendor-contact-phone"><%= contact[:phone] %></p>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </article>
          <% end %>
        </div>
      <% else %>
        <p class="generated-template--event-overview__empty">No vendor contacts are available for this event yet.</p>
      <% end %>
    </section>
  </div>
</section>
