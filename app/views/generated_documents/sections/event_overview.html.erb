<% if local_assigns.fetch(:render_base_styles, true) %>
  <%= render "generated_documents/sections/base_styles" %>
<% end %>

<style>
  .generated-template--event-overview {
    --generated-document-content-padding-x: 0.26in;
    --generated-document-content-padding-top: 0.24in;
    --generated-document-content-padding-bottom: 0.24in;
    gap: 0.6rem;
    background: var(--color-white, #ffffff);
    border: none;
  }

  .generated-template--event-overview .generated-template__page-header {
    gap: 0.38rem;
  }

  .generated-template--event-overview .generated-template__page-header-logo {
    display: none;
  }

  .generated-template--event-overview .generated-template__page-header-title {
    margin-bottom: 0.02rem;
    font-size: 20px;
    letter-spacing: 1.25px;
  }

  .generated-template--event-overview__layout {
    display: grid;
    gap: 0.45rem;
    color: var(--color-dark-brown, #3f2211);
  }

  .generated-template--event-overview__hero {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 0.2in;
    align-items: start;
    padding: 0.12in 0.16in 0.16in;
    border: 1px solid color-mix(in srgb, var(--color-gold, #be9c72) 28%, white);
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--color-sand, #f3e4d2) 70%, white), white 55%);
  }

  .generated-template--event-overview__hero-copy {
    display: grid;
    gap: 0.1rem;
  }

  .generated-template--event-overview__eyebrow {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-brown, #5b4639) 84%, white);
  }

  .generated-template--event-overview__event-name {
    margin: 0;
    font-size: 1.65rem;
    line-height: 1.05;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .generated-template--event-overview__hero-note {
    margin: 0.06rem 0 0;
    font-size: 0.88rem;
    line-height: 1.35;
    color: color-mix(in srgb, var(--color-brown, #5b4639) 88%, white);
  }

  .generated-template--event-overview__snapshot {
    display: grid;
    gap: 0.55rem;
  }

  .generated-template--event-overview__snapshot-item {
    display: grid;
    gap: 0.08rem;
    padding: 0.12in 0.14in;
    border: 1px solid color-mix(in srgb, var(--color-dark-sand, #dccbb3) 58%, white);
    background: rgba(255, 255, 255, 0.9);
  }

  .generated-template--event-overview__snapshot-label {
    margin: 0;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-brown, #5b4639) 84%, white);
  }

  .generated-template--event-overview__snapshot-value {
    margin: 0;
    font-size: 1rem;
    line-height: 1.28;
  }

  .generated-template--event-overview__sections {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: 0.18in;
    align-items: start;
  }

  .generated-template--event-overview__section {
    min-width: 0;
    display: grid;
    gap: 0.12in;
    align-content: start;
  }

  .generated-template--event-overview__section-title {
    margin: 0;
    padding: 0.09in 0.12in 0.08in;
    background: var(--color-gold, #be9c72);
    color: var(--color-dark-brown, #3f2211);
    font-size: 0.9rem;
    line-height: 1.1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .generated-template--event-overview__grid {
    display: grid;
    gap: 0.12in;
  }

  .generated-template--event-overview__planner-card,
  .generated-template--event-overview__vendor-card {
    display: grid;
    gap: 0.1in;
    padding: 0.12in 0.14in 0.14in;
    border: 1px solid color-mix(in srgb, var(--color-dark-sand, #dccbb3) 58%, white);
    background: white;
    break-inside: avoid;
  }

  .generated-template--event-overview__planner-head,
  .generated-template--event-overview__vendor-head {
    display: grid;
    gap: 0.04in;
  }

  .generated-template--event-overview__planner-name,
  .generated-template--event-overview__vendor-name {
    margin: 0;
    font-size: 1rem;
    line-height: 1.18;
    letter-spacing: 0.02em;
  }

  .generated-template--event-overview__planner-role,
  .generated-template--event-overview__vendor-meta {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.28;
    color: color-mix(in srgb, var(--color-brown, #5b4639) 88%, white);
  }

  .generated-template--event-overview__planner-lead {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    padding: 0.03in 0.08in;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-sand, #f3e4d2) 78%, white);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-brown, #5b4639);
  }

  .generated-template--event-overview__contact-list,
  .generated-template--event-overview__vendor-contacts {
    display: grid;
    gap: 0.06in;
  }

  .generated-template--event-overview__contact-line {
    margin: 0;
    font-size: 0.84rem;
    line-height: 1.35;
  }

  .generated-template--event-overview__contact-line strong {
    font-weight: 600;
  }

  .generated-template--event-overview__vendor-contact {
    display: grid;
    gap: 0.03in;
    padding-top: 0.08in;
    border-top: 1px solid color-mix(in srgb, var(--color-dark-sand, #dccbb3) 62%, white);
  }

  .generated-template--event-overview__vendor-contact:first-child {
    padding-top: 0;
    border-top: none;
  }

  .generated-template--event-overview__empty {
    margin: 0;
    padding: 0.16in;
    border: 1px dashed color-mix(in srgb, var(--color-dark-sand, #dccbb3) 80%, white);
    color: var(--color-brown, #5b4639);
    font-style: italic;
  }

  @media (max-width: 720px) {
    .generated-template--event-overview__hero,
    .generated-template--event-overview__sections {
      grid-template-columns: 1fr;
    }
  }
</style>

<% event_date_range = generated_event_overview_date_range(@event) %>
<% planners = generated_event_overview_planners(@event) %>
<% vendors = generated_event_overview_vendors(@event) %>

<section class="generated-template generated-template--event-overview">
  <%= render "generated_documents/sections/page_header", segment: @segment %>

  <div class="generated-template--event-overview__layout">
    <section class="generated-template--event-overview__hero">
      <div class="generated-template--event-overview__hero-copy">
        <p class="generated-template--event-overview__eyebrow">Event Snapshot</p>
        <h2 class="generated-template--event-overview__event-name"><%= @event.name %></h2>
        <p class="generated-template--event-overview__hero-note">Live details from the planner workspace for fast packet reference.</p>
      </div>

      <div class="generated-template--event-overview__snapshot">
        <div class="generated-template--event-overview__snapshot-item">
          <p class="generated-template--event-overview__snapshot-label">Date</p>
          <p class="generated-template--event-overview__snapshot-value generated-template--event-overview__dates"><%= event_date_range %></p>
        </div>
        <div class="generated-template--event-overview__snapshot-item">
          <p class="generated-template--event-overview__snapshot-label">Location</p>
          <p class="generated-template--event-overview__snapshot-value generated-template--event-overview__location"><%= @event.location.presence || "Location TBD" %></p>
        </div>
      </div>
    </section>

    <div class="generated-template--event-overview__sections">
      <section class="generated-template--event-overview__section">
        <h3 class="generated-template--event-overview__section-title">Planner Contacts</h3>
        <% if planners.any? %>
          <div class="generated-template--event-overview__grid">
            <% planners.each do |planner| %>
              <article class="generated-template--event-overview__planner-card">
                <div class="generated-template--event-overview__planner-head">
                  <% if planner[:lead] %>
                    <span class="generated-template--event-overview__planner-lead">Lead Planner</span>
                  <% end %>
                  <p class="generated-template--event-overview__planner-name"><%= planner[:name] %></p>
                  <% if planner[:title].present? %>
                    <p class="generated-template--event-overview__planner-role generated-template--event-overview__planner-title"><%= planner[:title] %></p>
                  <% end %>
                </div>
                <div class="generated-template--event-overview__contact-list">
                  <% if planner[:email].present? %>
                    <p class="generated-template--event-overview__contact-line generated-template--event-overview__planner-email"><strong>Email:</strong> <%= planner[:email] %></p>
                  <% end %>
                  <% if planner[:phone].present? %>
                    <p class="generated-template--event-overview__contact-line generated-template--event-overview__planner-phone"><strong>Phone:</strong> <%= planner[:phone] %></p>
                  <% end %>
                </div>
              </article>
            <% end %>
          </div>
        <% else %>
          <p class="generated-template--event-overview__empty">No planner contacts are linked to this event yet.</p>
        <% end %>
      </section>

      <section class="generated-template--event-overview__section">
        <h3 class="generated-template--event-overview__section-title">Vendor Contacts</h3>
        <% if vendors.any? %>
          <div class="generated-template--event-overview__grid">
            <% vendors.each do |vendor| %>
              <article class="generated-template--event-overview__vendor-card">
                <div class="generated-template--event-overview__vendor-head">
                  <p class="generated-template--event-overview__vendor-name"><%= vendor[:name] %></p>
                  <% meta_parts = [vendor[:vendor_type], vendor[:social_handle]].compact %>
                  <% if meta_parts.any? %>
                    <p class="generated-template--event-overview__vendor-meta"><%= meta_parts.join(" · ") %></p>
                  <% end %>
                </div>
                <div class="generated-template--event-overview__vendor-contacts">
                  <% vendor[:contacts].each do |contact| %>
                    <div class="generated-template--event-overview__vendor-contact">
                      <% if contact[:name].present? %>
                        <p class="generated-template--event-overview__contact-line generated-template--event-overview__vendor-contact-name"><strong><%= contact[:name] %></strong><%= contact[:title].present? ? " · #{contact[:title]}" : "" %></p>
                      <% elsif contact[:title].present? %>
                        <p class="generated-template--event-overview__contact-line generated-template--event-overview__vendor-contact-name"><strong><%= contact[:title] %></strong></p>
                      <% end %>
                      <% if contact[:email].present? %>
                        <p class="generated-template--event-overview__contact-line generated-template--event-overview__vendor-contact-email"><strong>Email:</strong> <%= contact[:email] %></p>
                      <% end %>
                      <% if contact[:phone].present? %>
                        <p class="generated-template--event-overview__contact-line generated-template--event-overview__vendor-contact-phone"><strong>Phone:</strong> <%= contact[:phone] %></p>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </article>
            <% end %>
          </div>
        <% else %>
          <p class="generated-template--event-overview__empty">No vendor contacts are available for this event yet.</p>
        <% end %>
      </section>
    </div>
  </div>
</section>
