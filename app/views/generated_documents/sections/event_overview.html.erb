<% if local_assigns.fetch(:render_base_styles, true) %>
  <%= render "generated_documents/sections/base_styles" %>
<% end %>
<%= render "generated_documents/sections/packet_sheet_styles" %>

<% event_date_range = generated_event_overview_date_range(@event) %>
<% milestone_data = generated_event_overview_timeline(@event) %>
<% milestone_groups = milestone_data[:groups] %>
<% milestone_timezone = milestone_data[:timezone] %>
<% venue_addresses = generated_event_overview_venue_addresses(@event) %>
<% venue_address_title = venue_addresses.one? ? "Venue Address" : "Venue Addresses" %>
<% social_media_rows = generated_event_overview_social_media_rows(@event) %>
<% important_information_rows = generated_event_overview_primary_rows(@event) %>
<% vip_rows = generated_event_overview_vip_rows(@event) %>
<% style_rows = generated_event_overview_style_rows(@event) %>

<style>
  .generated-template--event-overview__important-information-groups {
    display: grid;
    gap: 4px;
  }

  .generated-template--event-overview__timeline-groups {
    display: grid;
    gap: 0;
  }

  .generated-template--event-overview__timeline-group {
    display: grid;
    break-inside: avoid;
  }

  .generated-template--event-overview__timeline-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-left: 1px solid rgba(0, 0, 0, 0.06);
    border-right: 1px solid rgba(0, 0, 0, 0.06);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  .generated-template--event-overview__timeline-card {
    display: grid;
    align-content: start;
    min-height: 0.46in;
    padding: 0.04in 0.055in 0.05in;
    border-right: 1px solid rgba(0, 0, 0, 0.06);
    break-inside: avoid;
    box-sizing: border-box;
  }

  .generated-template--event-overview__timeline-card:nth-child(4n) {
    border-right: none;
  }

  .generated-template--event-overview__timeline-card:nth-child(n+5) {
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }

  .generated-template--event-overview__venue-address-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-left: 1px solid rgba(0, 0, 0, 0.06);
    border-right: 1px solid rgba(0, 0, 0, 0.06);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  .generated-template--event-overview__venue-address-card {
    display: grid;
    gap: 2px;
    align-content: start;
    min-height: 0.42in;
    padding: 0.04in 0.055in 0.05in;
    border-right: 1px solid rgba(0, 0, 0, 0.06);
    break-inside: avoid;
    box-sizing: border-box;
  }

  .generated-template--event-overview__venue-address-card:nth-child(4n) {
    border-right: none;
  }

  .generated-template--event-overview__venue-address-card:nth-child(n+5) {
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }

  .generated-template--event-overview__venue-address-grid--single {
    grid-template-columns: minmax(0, 1fr);
  }

  .generated-template--event-overview__venue-address-grid--single .generated-template--event-overview__venue-address-card {
    border-right: none;
  }

  .generated-template--event-overview__social-media-row {
    grid-template-columns: 1.35fr 1.8fr 1.15fr;
  }
</style>

<section class="generated-template generated-template--packet-sheet generated-template--event-overview">
  <%= render "generated_documents/sections/page_header", segment: @segment %>

  <div class="generated-template--packet-sheet__stack">
    <section class="generated-template--packet-sheet__section">
      <h2 class="generated-template--packet-sheet__section-title">Important Information</h2>
      <div class="generated-template--event-overview__important-information-groups">
        <section class="generated-template--packet-sheet__subsection">
          <div class="generated-template--packet-sheet__grid">
            <% important_information_rows.each do |label, value| %>
              <% value_class =
                   case label
                   when "Date" then "generated-template--event-overview__dates"
                   when "Location" then "generated-template--event-overview__location"
                   when "Guest Count" then "generated-template--event-overview__guest-count"
                   end %>
              <div class="generated-template--packet-sheet__grid-row generated-template--packet-sheet__grid-row--two-column">
                <div class="generated-template--packet-sheet__grid-cell">
                  <p class="generated-template--packet-sheet__text generated-template--packet-sheet__text--label"><%= label %></p>
                </div>
                <div class="generated-template--packet-sheet__grid-cell">
                  <p class="generated-template--packet-sheet__text generated-template--packet-sheet__text--value <%= value_class %>"><%= value %></p>
                </div>
              </div>
            <% end %>
          </div>
        </section>

        <% if vip_rows.any? %>
          <section class="generated-template--packet-sheet__subsection">
            <div class="generated-template--packet-sheet__grid">
              <% vip_rows.each do |label, value| %>
                <div class="generated-template--packet-sheet__grid-row generated-template--packet-sheet__grid-row--two-column">
                  <div class="generated-template--packet-sheet__grid-cell">
                    <p class="generated-template--packet-sheet__text generated-template--packet-sheet__text--label"><%= label %></p>
                  </div>
                  <div class="generated-template--packet-sheet__grid-cell">
                    <p class="generated-template--packet-sheet__text generated-template--packet-sheet__text--value"><%= value %></p>
                  </div>
                </div>
              <% end %>
            </div>
          </section>
        <% end %>

        <% if style_rows.any? %>
          <section class="generated-template--packet-sheet__subsection">
            <div class="generated-template--packet-sheet__grid">
              <% style_rows.each do |label, value| %>
                <div class="generated-template--packet-sheet__grid-row generated-template--packet-sheet__grid-row--two-column">
                  <div class="generated-template--packet-sheet__grid-cell">
                    <p class="generated-template--packet-sheet__text generated-template--packet-sheet__text--label"><%= label %></p>
                  </div>
                  <div class="generated-template--packet-sheet__grid-cell">
                    <p class="generated-template--packet-sheet__text generated-template--packet-sheet__text--value"><%= value %></p>
                  </div>
                </div>
              <% end %>
            </div>
          </section>
        <% end %>
      </div>
    </section>

    <section class="generated-template--packet-sheet__section generated-template--event-overview__timeline">
      <h2 class="generated-template--packet-sheet__section-title">Timeline</h2>
      <% if milestone_groups.any? %>
        <div class="generated-template--event-overview__timeline-groups">
          <% milestone_groups.each do |group| %>
            <section class="generated-template--packet-sheet__subsection generated-template--event-overview__timeline-group">
              <h3 class="generated-template--packet-sheet__subsection-title generated-template--event-overview__timeline-date"><%= group[:date_label] %></h3>
              <div class="generated-template--event-overview__timeline-grid">
                <% group[:items].each do |item| %>
                  <article class="generated-template--packet-sheet__event-card generated-template--event-overview__timeline-card">
                    <p class="generated-template--packet-sheet__text generated-template--packet-sheet__text--event-card">
                      <strong class="generated-template--event-overview__timeline-title"><%= item.title %></strong><br>
                      <% if item.location_name.present? %>
                        <span class="generated-template--event-overview__timeline-location"><%= item.location_name %></span><br>
                      <% end %>
                      <u class="generated-template--event-overview__timeline-time"><%= calendar_item_time_only_label_with_marker(item, milestone_timezone) %></u>
                      <% if item.guest_count.present? %>
                        <br><em class="generated-template--event-overview__timeline-guest-count"><%= item.guest_count %></em>
                      <% end %>
                    </p>
                  </article>
                <% end %>
              </div>
            </section>
          <% end %>
        </div>
      <% else %>
        <p class="generated-template--packet-sheet__empty">No milestone items are available for this event yet.</p>
      <% end %>
    </section>

    <section class="generated-template--packet-sheet__section generated-template--event-overview__venue-addresses">
      <h2 class="generated-template--packet-sheet__section-title"><%= venue_address_title %></h2>
      <% if venue_addresses.any? %>
        <div class="generated-template--event-overview__venue-address-grid <%= "generated-template--event-overview__venue-address-grid--single" if venue_addresses.one? %>">
          <% venue_addresses.each do |venue| %>
            <article class="generated-template--event-overview__venue-address-card">
              <p class="generated-template--packet-sheet__text generated-template--packet-sheet__text--value generated-template--event-overview__venue-address-name"><strong><%= venue[:name] %></strong></p>
              <p class="generated-template--packet-sheet__text generated-template--packet-sheet__text--detail generated-template--event-overview__venue-address"><%= venue[:address] %></p>
            </article>
          <% end %>
        </div>
      <% else %>
        <p class="generated-template--packet-sheet__empty">No venue addresses are available for this event yet.</p>
      <% end %>
    </section>

    <section class="generated-template--packet-sheet__section">
      <h2 class="generated-template--packet-sheet__section-title">Social Media Handles</h2>
      <% if social_media_rows.any? %>
        <div class="generated-template--packet-sheet__grid">
          <% social_media_rows.each do |row| %>
            <article>
              <div class="generated-template--packet-sheet__grid-row generated-template--event-overview__social-media-row">
                <div class="generated-template--packet-sheet__grid-cell">
                  <p class="generated-template--packet-sheet__text generated-template--packet-sheet__text--label generated-template--event-overview__social-media-category"><%= row[:label] %></p>
                </div>
                <div class="generated-template--packet-sheet__grid-cell">
                  <p class="generated-template--packet-sheet__text generated-template--packet-sheet__text--value generated-template--event-overview__social-media-company"><%= row[:company_name] %></p>
                </div>
                <div class="generated-template--packet-sheet__grid-cell">
                  <% if row[:social_handle].present? %>
                    <p class="generated-template--packet-sheet__text generated-template--packet-sheet__text--detail generated-template--event-overview__social-media-handle"><%= row[:social_handle] %></p>
                  <% end %>
                </div>
              </div>
            </article>
          <% end %>
        </div>
      <% else %>
        <p class="generated-template--packet-sheet__empty">No social media handles are available for this event yet.</p>
      <% end %>
    </section>

    <% if generated_packet_rich_text_present?(@event.social_media_policy) %>
      <section class="generated-template--packet-sheet__section">
        <h2 class="generated-template--packet-sheet__section-title">Social Media Policy</h2>
        <div class="generated-template--packet-sheet__content generated-template--packet-sheet__rich-text generated-template--event-overview__social-media">
          <%= render_generated_packet_rich_text(@event.social_media_policy) %>
        </div>
      </section>
    <% end %>

    <% if generated_packet_rich_text_present?(@event.parking_details) %>
      <section class="generated-template--packet-sheet__section">
        <h2 class="generated-template--packet-sheet__section-title">PARKING &amp; GETTING THERE</h2>
        <div class="generated-template--packet-sheet__content generated-template--packet-sheet__rich-text generated-template--event-overview__parking">
          <%= render_generated_packet_rich_text(@event.parking_details) %>
        </div>
      </section>
    <% end %>
  </div>
</section>
