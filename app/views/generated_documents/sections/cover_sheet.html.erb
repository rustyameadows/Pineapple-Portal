<% if local_assigns.fetch(:render_base_styles, true) %>
  <%= render "generated_documents/sections/base_styles" %>
<% end %>

<style>
  @page {
    margin: 0;
  }

  .generated-template--cover {
    --cover-bg: var(--color-white, #ffffff);
    --cover-accent: var(--color-dark-brown, #3f2211);
    --page-bg: var(--cover-bg);
    --page-padding-top: 0.52in;
    --page-padding-bottom: 0.72in;
    --page-padding-horizontal: 0.7in;
    box-sizing: border-box;
    min-height: 11in;
    height: 11in;
    padding: var(--page-padding-top) var(--page-padding-horizontal) var(--page-padding-bottom);
    background: var(--cover-bg);
    color: var(--cover-accent);
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    justify-items: center;
    align-items: start;
    text-align: center;
    gap: 0.28in;
  }

  .generated-template--cover__brand img {
    display: block;
    width: min(2.1in, 42vw);
    margin: 0 auto;
  }

  .generated-template--cover__middle {
    width: 100%;
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 0.28in;
  }

  .generated-template--cover__photo {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .generated-template--cover__photo img {
    display: block;
    width: min(6.1in, 100%);
    max-height: 4.55in;
    border: 2px solid var(--cover-accent);
    object-fit: cover;
  }

  .generated-template--cover__details {
    display: grid;
    justify-items: center;
    gap: 0.08in;
  }

  .generated-template--cover__event-name,
  .generated-template--cover__event-date,
  .generated-template--cover__event-location,
  .generated-template--cover__document-title {
    margin: 0;
    color: var(--cover-accent);
  }

  .generated-template--cover__event-name {
    font-family: var(--font-family-body, 'BaskervilleNo2', 'Times New Roman', serif);
    font-size: 0.34in;
    font-style: italic;
    line-height: 1.1;
    text-transform: none;
  }

  .generated-template--cover__event-date,
  .generated-template--cover__event-location {
    font-family: var(--font-family-body, 'BaskervilleNo2', 'Times New Roman', serif);
    font-size: 0.2in;
    font-style: italic;
    line-height: 1.15;
    text-transform: none;
  }

  .generated-template--cover__divider img {
    display: block;
    width: min(2.95in, 55vw);
    height: auto;
    margin: 0 auto;
  }

  .generated-template--cover__document-title {
    font-family: var(--font-family-display, 'Didot', 'Times New Roman', serif);
    font-size: 0.25in;
    line-height: 1.15;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
</style>

<% footer_logo = inline_asset_data_uri('portal-footer-logo.png') %>
<% divider_line = inline_asset_data_uri('hero-divider-line.png') %>
<% document_title = @segment.display_title.presence || "Packet" %>
<% event_photo_uri = inline_document_image_data_uri(@event.event_photo_document) %>
<% start_on = @event.starts_on %>
<% end_on = @event.ends_on %>
<% location = @event.location.presence %>
<% event_dates = if start_on.present?
                   if end_on.present? && end_on != start_on
                     "#{start_on.to_fs(:long)} - #{end_on.to_fs(:long)}"
                   else
                     start_on.to_fs(:long)
                   end
                 end %>

<section class="generated-template generated-template--cover">
  <div class="generated-template--cover__brand">
    <img src="<%= footer_logo %>" alt="Pineapple Productions">
  </div>

  <div class="generated-template--cover__middle">
    <% if event_photo_uri.present? %>
      <div class="generated-template--cover__photo">
        <img src="<%= event_photo_uri %>" alt="<%= @event.name %> photo">
      </div>
    <% end %>

    <div class="generated-template--cover__details">
      <p class="generated-template--cover__event-name"><%= @event.name %></p>
      <% if event_dates.present? %>
        <p class="generated-template--cover__event-date"><%= event_dates %></p>
      <% end %>
      <% if location.present? %>
        <p class="generated-template--cover__event-location"><%= location %></p>
      <% end %>
    </div>
  </div>

  <div class="generated-template--cover__divider">
    <img src="<%= divider_line %>" alt="" aria-hidden="true">
  </div>

  <p class="generated-template--cover__document-title"><%= document_title %></p>
</section>
